@@ -0,0 +1,66 @@
+"""Strict still-image boundary: never trust filenames or leave a rejected image queued."""
+import base64
+import io
+import struct
+import zlib
+
+import pytest
+from PIL import Image
+
+from tui_gateway.prompt_image_turn import validate, ImageTurnError, RAW_LIMIT, store
+
+
+def payload(fmt="PNG", size=(3, 2)):
+    stream = io.BytesIO()
+    Image.new("RGB", size, "blue").save(stream, format=fmt)
+    return {"filename": "synthetic.png" if fmt == "PNG" else "synthetic.jpg",
+            "content_base64": base64.b64encode(stream.getvalue()).decode()}
+
+
+@pytest.mark.parametrize("fmt", ["PNG", "JPEG"])
+def test_validated_original_bytes_create_only_and_session_scoped(tmp_path, fmt):
+    item = payload(fmt)
+    image = validate(item, "日本語の合成画像です。")
+    assert (image["width"], image["height"], image["format"]) == (3, 2, fmt)
+    a, first = store({"session_key": "a"}, "live-a", image, tmp_path / "images")
+    b, second = store({"session_key": "b"}, "live-b", image, tmp_path / "images")
+    c, third = store({"session_key": "a"}, "live-a", image, tmp_path / "images")
+    assert a != b != c and a.parent != b.parent and a.parent == c.parent
+    assert a.read_bytes() == b.read_bytes() == base64.b64decode(item["content_base64"])
+    assert a.stat().st_mode & 0o777 == 0o600
+    assert first["receipt_id"] != second["receipt_id"] != third["receipt_id"]
+
+
+@pytest.mark.parametrize("case", ["empty", "base64", "encoded_limit", "raw_limit", "extension", "path", "gif", "svg", "webp", "broken", "edge", "pixels", "text", "array", "animation"])
+def test_invalid_images_fail_before_storage(tmp_path, case):
+    before = set(tmp_path.iterdir())
+    item = payload()
+    text = "合成本文"
+    if case == "empty": item["content_base64"] = ""
+    if case == "base64": item["content_base64"] = "#not-base64"
+    if case == "encoded_limit": item["content_base64"] = "A" * (4 * ((RAW_LIMIT + 2) // 3) + 1)
+    if case == "raw_limit": item["content_base64"] = base64.b64encode(b"x" * (RAW_LIMIT + 1)).decode()
+    if case == "extension": item["filename"] = "spoof.jpg"
+    if case == "path": item["filename"] = "../outside.png"
+    if case in {"gif", "svg", "webp"}: item["content_base64"] = base64.b64encode({"gif": b"GIF89a", "svg": b"<svg/>", "webp": b"RIFF\x00\x00\x00\x00WEBP"}[case]).decode()
+    if case == "broken": item["content_base64"] = base64.b64encode(base64.b64decode(item["content_base64"])[:-6]).decode()
+    if case in {"edge", "pixels"}:
+        data = bytearray(base64.b64decode(item["content_base64"]))
+        data[16:24] = struct.pack(">II", 8193 if case == "edge" else 5000, 1 if case == "edge" else 4000)
+        data[29:33] = struct.pack(">I", zlib.crc32(data[12:29]))
+        item["content_base64"] = base64.b64encode(data).decode()
+    if case == "text": text = "あ" * 22000
+    if case == "array": item = []
+    if case == "animation":
+        stream = io.BytesIO(); Image.new("RGB", (3, 2)).save(stream, format="PNG", save_all=True, append_images=[Image.new("RGB", (3, 2), "blue")])
+        item["content_base64"] = base64.b64encode(stream.getvalue()).decode()
+    with pytest.raises(ImageTurnError): validate(item, text)
+    assert set(tmp_path.iterdir()) == before
+
+
+def test_full_pixel_decode_rejects_corrupt_payload_with_valid_header():
+    item = payload()
+    data = bytearray(base64.b64decode(item["content_base64"]))
+    data[48] ^= 255
+    item["content_base64"] = base64.b64encode(data).decode()
+    with pytest.raises(ImageTurnError): validate(item, "壊れた画像")

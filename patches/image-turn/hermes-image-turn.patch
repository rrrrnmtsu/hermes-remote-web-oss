@@ -0,0 +1,199 @@
+"""Actual RPC/session/decoder/admission/turn/AIAgent/SDK paths. Only SDK HTTP generation is synthetic."""
+import base64
+import hashlib
+import json
+import time
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+from tests.tui_gateway.test_image_turn_validation import payload
+
+
+@pytest.fixture
+def real_gateway(tmp_path, monkeypatch):
+    home = tmp_path / "isolated"
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_IGNORE_RULES", "1")
+    from tests.tui_gateway.image_turn_harness import install
+    stack, server, records, gate = install(home)
+    class Transport:
+        auth_identity = {"user_id": "DEMO-user", "provider": "DEMO"}
+        closed = False
+        def __init__(self): self.frames = []
+        def write(self, frame): self.frames.append(frame); return True
+        def close(self): self.closed = True
+    transport = Transport()
+    def rpc(method, params=None):
+        from tui_gateway.transport import bind_transport, reset_transport
+        token = bind_transport(transport)
+        try: return server.handle_request({"jsonrpc": "2.0", "id": "DEMO", "method": method, "params": params or {}})
+        finally: reset_transport(token)
+    def create():
+        reply = rpc("session.create", {"close_on_disconnect": False})
+        assert "result" in reply, reply
+        return reply["result"]["session_id"]
+    try:
+        yield server, records, gate, rpc, create, home, transport
+    finally:
+        gate.set()
+        for session in list(server._sessions.values()):
+            thread = session.get("_run_thread")
+            if thread: thread.join(12)
+            if session.get("agent"): session["agent"].close()
+        server._sessions.clear()
+        stack.close()
+
+
+def wait_done(server, sid):
+    deadline = time.monotonic() + 15
+    while server._sessions[sid].get("running") and time.monotonic() < deadline: time.sleep(.02)
+    thread = server._sessions[sid].get("_run_thread")
+    if thread: thread.join(1)
+    assert not server._sessions[sid].get("running")
+
+
+@pytest.mark.parametrize("fmt", ["PNG", "JPEG"])
+def test_real_turn_image_and_text_binding_and_saved_history(real_gateway, fmt):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    sid = create(); image = payload(fmt); text = "合成画像の日本語本文です。"
+    assert rpc("image.turn_capabilities", {"session_id": sid})["result"]["enabled"]
+    result = rpc("prompt.submit", {"session_id": sid, "text": text, "image": image})
+    assert result["result"]["image_turn"]["format"] == fmt, result
+    wait_done(server, sid)
+    assert len(records) == 1, transport.frames
+    assert records[0]["image_count"] == 1 and text in records[0]["last_text"]
+    assert records[0]["image_hashes"] == [hashlib.sha256(base64.b64decode(image["content_base64"])).hexdigest()]
+    assert records[0]["tools"] == 0 and server._sessions[sid]["attached_images"] == []
+    key = server._sessions[sid]["session_key"]
+    resumed = rpc("session.resume", {"session_id": key, "lazy": True, "inline_images": False, "close_on_disconnect": False})
+    assert "合成画像受付OK" in json.dumps(resumed, ensure_ascii=False), resumed
+    assert len([m for m in resumed["result"]["messages"] if m.get("role") == "user"]) == 1, resumed["result"]["messages"]
+    assert next(m for m in resumed["result"]["messages"] if m.get("role") == "user")["text"] == text
+
+
+def test_competing_desktop_image_and_text_and_cancel_cannot_steal(real_gateway):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    sid = create(); gate.clear()
+    accepted = rpc("prompt.submit", {"session_id": sid, "text": "先の本文", "image": payload()})
+    assert "image_turn" in accepted["result"]
+    snapshot = rpc("session.activate", {"session_id": sid})["result"]
+    assert snapshot["inflight"]["user_row_id"] == accepted["result"]["user_row_id"]
+    for method, params in [("prompt.submit", {"text": "別端末の本文"}),
+                           ("image.attach_bytes", payload()), ("image.detach", {"path": "foreign.png"})]:
+        assert rpc(method, {"session_id": sid, **params})["error"]["code"] == 4009
+    gate.set(); wait_done(server, sid); assert len(records) == 1 and "先の本文" in records[0]["last_text"]
+
+
+def test_provider_image_rejection_never_retries_as_text_only(real_gateway):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    sid = create()
+    assert server._sessions[sid]["agent_ready"].wait(15)
+    agent = server._sessions[sid]["agent"]
+    agent._DEMO_reject_image = True
+    # Two attempts would expose the legacy image-stripping recovery branch if it were still enabled.
+    agent._api_max_retries = 2
+    reply = rpc("prompt.submit", {"session_id": sid, "text": "画像付きの固定本文", "image": payload()})
+    assert "image_turn" in reply["result"]
+    wait_done(server, sid)
+    assert records and all(record["image_count"] == 1 for record in records)
+    assert not server._sessions[sid]["attached_images"]
+    assert any(frame.get("params", {}).get("type") == "message.complete" and
+               frame["params"].get("payload", {}).get("status") == "error" for frame in transport.frames)
+
+

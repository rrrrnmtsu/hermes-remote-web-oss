new file mode 100644
index 0000000000..c9f1ea1c12
--- /dev/null
+++ b/tui_gateway/prompt_image_turn.py
@@ -0,0 +1,133 @@
+"""One bounded image, owned by a prompt turn rather than the legacy pending queue."""
+from __future__ import annotations
+
+import base64
+import hashlib
+import io
+import os
+from pathlib import Path
+import uuid
+import warnings
+
+RAW_LIMIT = 5 * 1024 * 1024
+FRAME_LIMIT = 8 * 1024 * 1024
+TEXT_LIMIT = 64 * 1024
+MAX_EDGE = 8192
+MAX_PIXELS = 16_000_000
+SESSION_STORAGE_LIMIT = 50 * 1024 * 1024
+
+
+class ImageTurnError(ValueError):
+    pass
+
+
+def route(session: dict, config: dict) -> tuple[str, str]:
+    """Pin the existing route without resolving or reading credentials."""
+    model_cfg = config.get("model") or {}
+    agent = session.get("agent")
+    override = session.get("model_override")
+    model = getattr(agent, "model", None) or (override.get("model") if isinstance(override, dict) else override) or model_cfg.get("default", "")
+    provider = getattr(agent, "provider", None) or (override.get("provider") if isinstance(override, dict) else None) or model_cfg.get("provider", "")
+    return str(provider), str(model)
+
+
+def capabilities(session: dict, config: dict) -> dict:
+    """Offline policy only: never probe a provider or resolve credentials for a capability read."""
+    from agent.image_routing import _supports_vision_override
+    from hermes_cli.fallback_config import get_fallback_chain
+    agent_cfg = config.get("agent") or {}
+    agent = session.get("agent")
+    provider, model = route(session, config)
+    vision = _supports_vision_override(config, provider, model)
+    pilot = bool(agent_cfg.get("text_pilot")) or getattr(agent, "_text_pilot", None) is not None
+    fallback = bool(get_fallback_chain(config) or getattr(agent, "_fallback_chain", None))
+    enabled = not pilot and not fallback and vision is True and agent_cfg.get("image_input_mode") == "native"
+    return {"version": 1, "enabled": enabled, "model_vision": vision,
+            "reason": "text_pilot" if pilot else "fallback_configured" if fallback else "" if enabled else "native_vision_unconfirmed",
+            "max_raw_bytes": RAW_LIMIT, "max_frame_bytes": FRAME_LIMIT,
+            "max_text_bytes": TEXT_LIMIT, "max_edge": MAX_EDGE, "max_pixels": MAX_PIXELS}
+
+
+def validate(payload: dict, text: str) -> dict:
+    """Bound encoded data before decoding; verify container and fully decode within pixel limits."""
+    from PIL import Image, ImageFile, UnidentifiedImageError
+    if not isinstance(text, str) or not text.strip() or len(text.encode("utf-8")) > TEXT_LIMIT:
+        raise ImageTurnError("Image turns require text of at most 65536 UTF-8 bytes")
+    if not isinstance(payload, dict):
+        raise ImageTurnError("Image payload must be an object")
+    if ImageFile.LOAD_TRUNCATED_IMAGES:
+        raise ImageTurnError("Strict decoder policy is unavailable")
+    encoded = payload.get("content_base64")
+    filename = payload.get("filename")
+    if (not isinstance(encoded, str) or not encoded or len(encoded) > 4 * ((RAW_LIMIT + 2) // 3)
+            or not isinstance(filename, str) or not 0 < len(filename) <= 120
+            or "/" in filename or "\\" in filename or "\x00" in filename):
+        raise ImageTurnError("Invalid bounded image payload")
+    try:
+        data = base64.b64decode(encoded, validate=True)
+    except (ValueError, TypeError):
+        raise ImageTurnError("Invalid image base64") from None
+    if not 0 < len(data) <= RAW_LIMIT:
+        raise ImageTurnError("Image exceeds the raw size limit")
+    if data.startswith(b"\x89PNG\r\n\x1a\n"):
+        fmt, suffix = "PNG", ".png"
+        # APNG is outside the single still-image contract, including a single animated frame.
+        cursor = 8
+        kind = b""
+        while cursor + 12 <= len(data):
+            size = int.from_bytes(data[cursor:cursor + 4], "big")
+            if size > len(data) - cursor - 12:
+                raise ImageTurnError("Broken PNG container")
+            kind = data[cursor + 4:cursor + 8]
+            if kind == b"acTL":
+                raise ImageTurnError("Animated images are unsupported")
+            cursor += size + 12
+            if kind == b"IEND":
+                break
+        if cursor != len(data) or kind != b"IEND":
+            raise ImageTurnError("Broken PNG container")
+    elif data.startswith(b"\xff\xd8\xff") and data.endswith(b"\xff\xd9"):
+        fmt, suffix = "JPEG", ".jpg"
+    else:
+        raise ImageTurnError("Only actual JPEG and PNG data are supported")
+    extension = Path(filename).suffix.lower()
+    if extension not in ({".jpg", ".jpeg"} if fmt == "JPEG" else {".png"}):
+        raise ImageTurnError("Filename extension and actual image format disagree")
+    try:
+        with warnings.catch_warnings():
+            warnings.simplefilter("error", Image.DecompressionBombWarning)
+            with Image.open(io.BytesIO(data), formats=[fmt]) as image:
+                width, height = image.size
+                if (image.format != fmt or width <= 0 or height <= 0 or max(width, height) > MAX_EDGE
+                        or width * height > MAX_PIXELS or getattr(image, "n_frames", 1) != 1):
+                    raise ImageTurnError("Image dimensions exceed the still-image limits")
+                image.verify()
+            with Image.open(io.BytesIO(data), formats=[fmt]) as decoded:
+                decoded.load()  # verify alone cannot establish that all pixels decode.
+    except (UnidentifiedImageError, OSError, SyntaxError, ValueError, Image.DecompressionBombWarning, Image.DecompressionBombError):
+        raise ImageTurnError("Image is corrupt or exceeds decoder limits") from None
+    return {"data": data, "format": fmt, "suffix": suffix, "width": width, "height": height}
+
+
+def store(session: dict, session_id: str, image: dict, images_root: Path) -> tuple[Path, dict]:
+    """Called under history_lock after admission checks. Create-only private per-session storage."""
+    root = images_root / "turn-uploads"
+    directory = root / hashlib.sha256(str(session.get("session_key") or session_id).encode()).hexdigest()
+    for path in (images_root, root, directory):
+        if path.is_symlink():
+            raise ImageTurnError("Image storage symlinks are unsupported")
+        path.mkdir(mode=0o700, parents=True, exist_ok=True)
+    used = sum(p.stat().st_size for p in directory.iterdir() if p.is_file())
+    if used + len(image["data"]) > SESSION_STORAGE_LIMIT:
+        raise ImageTurnError("This live session's 50 MiB image storage limit was reached")
+    receipt = uuid.uuid4().hex
+    path = directory / (receipt + image["suffix"])
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(image["data"])
+    except BaseException:
+        path.unlink(missing_ok=True)  # Only the new, still-unreferenced file owned by this call.
+        raise
+    return path, {"receipt_id": receipt, "format": image["format"], "width": image["width"],
+                  "height": image["height"], "bytes": len(image["data"])}

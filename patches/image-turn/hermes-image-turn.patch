new file mode 100644
index 0000000000..420f31090f
--- /dev/null
+++ b/tests/tui_gateway/image_turn_harness.py
@@ -0,0 +1,96 @@
+"""Disposable real gateway/agent with synthetic authentication and SDK HTTP transport only."""
+from contextlib import ExitStack
+import base64
+import builtins
+import hashlib
+import json
+import io
+import socket
+import threading
+from unittest.mock import patch
+
+
+def install(home):
+    """Must be entered before importing the real gateway. No production credential/home reads."""
+    from toolsets import TOOLSETS
+    config = {"model": {"default": "synthetic-vision", "provider": "anthropic", "context_length": 200000, "supports_vision": True},
+        "agent": {"image_input_mode": "native", "environment_probe": False, "disabled_toolsets": list(TOOLSETS), "max_turns": 1},
+        "platform_toolsets": {"cli": []}, "mcp_servers": {}, "compression": {"enabled": False},
+        "memory": {"memory_enabled": False, "user_profile_enabled": False}, "background_review": {"enabled": False},
+        "auxiliary": {"title_generation": {"enabled": False, "model_upgrade_enabled": False}},
+        "notifications": {"enabled": False}, "ephemeral_system_prompt": "Synthetic image integration. Reply briefly."}
+    home.mkdir(parents=True, exist_ok=True)
+    (home / "config.yaml").write_text(json.dumps(config))
+    records = []
+    gate = threading.Event(); gate.set()
+    stack = ExitStack()
+    def guarded_open(original):
+        def read(file, *args, **kwargs):
+            path = str(file)
+            if path.endswith(("/.codex/auth.json", "/.claude/.credentials.json")):
+                raise AssertionError("CLI credential files are forbidden in candidate integration")
+            return original(file, *args, **kwargs)
+        return read
+    stack.enter_context(patch.object(builtins, "open", guarded_open(builtins.open)))
+    stack.enter_context(patch.object(io, "open", guarded_open(io.open)))
+    real_connect = socket.socket.connect
+    def loopback_only(sock, address):
+        if sock.family in (socket.AF_INET, socket.AF_INET6) and address[0] not in ("127.0.0.1", "::1"):
+            raise AssertionError("External network forbidden in image integration")
+        return real_connect(sock, address)
+    stack.enter_context(patch.object(socket.socket, "connect", loopback_only))
+    real_connect_ex = socket.socket.connect_ex
+    def loopback_ex(sock, address):
+        if sock.family in (socket.AF_INET, socket.AF_INET6) and address[0] not in ("127.0.0.1", "::1"):
+            raise AssertionError("External network forbidden in image integration")
+        return real_connect_ex(sock, address)
+    stack.enter_context(patch.object(socket.socket, "connect_ex", loopback_ex))
+    # The provider identity is synthetic. This path never invokes native/CLI credential resolvers.
+    from hermes_cli import runtime_provider
+    stack.enter_context(patch.object(runtime_provider, "resolve_runtime_provider", lambda **kw: {
+        "provider": "anthropic", "requested_provider": "anthropic", "model": "synthetic-vision",
+        "api_mode": "anthropic_messages", "api_key": "DEMO-not-a-real-key", "base_url": "https://api.anthropic.com"}))
+    from tui_gateway import server
+    from hermes_constants import set_hermes_home_override
+    set_hermes_home_override(home)
+    server._hermes_home = home
+    original = server._make_agent
+    def make_agent(*args, **kwargs):
+        import anthropic
+        import httpx
+        agent = original(*args, **kwargs)
+        assert agent.tools == [], "Fixture must disable effective tools"
+        assert agent.skip_context_files and agent._memory_store is None
+        assert agent.__class__.__name__ == "AIAgent"
+        def respond(request):
+            body = json.loads(request.content)
+            if request.url.path.endswith("count_tokens"):
+                return httpx.Response(200, json={"input_tokens": 42})
+            gate.wait(10)
+            parts = [part for message in body.get("messages", []) for part in
+                     (message.get("content") if isinstance(message.get("content"), list) else [])]
+            images = [part for part in parts if part.get("type") == "image"]
+            current = next((m for m in reversed(body.get("messages", [])) if m.get("role") == "user"), {})
+            current_images = [part for part in current.get("content", []) if isinstance(part, dict) and part.get("type") == "image"]
+            texts = [part["text"] for part in parts if part.get("type") == "text"]
+            records.append({"session": agent.session_id, "image_count": len(images),
+                "image_hashes": [hashlib.sha256(base64.b64decode(part["source"]["data"])).hexdigest() for part in images],
+                "last_text": "\n".join(texts), "tools": len(body.get("tools", [])), "model": body["model"],
+                "current_turn_image_hashes": [hashlib.sha256(base64.b64decode(part["source"]["data"])).hexdigest() for part in current_images]})
+            if getattr(agent, "_DEMO_reject_image", False):
+                return httpx.Response(400, json={"type": "error", "error": {
+                    "type": "invalid_request_error", "message": "image input is not supported"}})
+            return httpx.Response(200, json={"id": "msg_synthetic", "type": "message", "role": "assistant",
+                "model": body["model"], "content": [{"type": "text", "text": "合成画像受付OK"}],
+                "stop_reason": "end_turn", "stop_sequence": None, "usage": {"input_tokens": 42, "output_tokens": 6}})
+        client = anthropic.Anthropic(api_key="DEMO-not-a-real-key", max_retries=0, timeout=3600,
+            http_client=httpx.Client(transport=httpx.MockTransport(respond)))
+        agent._create_request_anthropic_client = lambda **kw: client
+        agent._close_request_anthropic_client = lambda *a, **kw: None
+        agent._disable_streaming = True
+        agent._api_max_retries = 1
+        agent._auto_recovery_cycles = 0
+        stack.callback(client.close)
+        return agent
+    stack.enter_context(patch.object(server, "_make_agent", make_agent))
+    return stack, server, records, gate

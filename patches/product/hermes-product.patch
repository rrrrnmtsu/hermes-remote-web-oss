+        assert image["result"]["draft"] == "合成の画像説明"
+        hidden = rpc("remote.session.branch_from_row", {"session_id": "a", "row_id": more[-1]["id"]})
+        assert hidden["error"]["code"] == 4404
+        listing = rpc("remote.sessions.list", {"limit": 50})
+        assert listing["result"]["scope"] == "owned_profile_sessions"
+        metadata = rpc("remote.session.metadata", {"session_id": "a"})["result"]["session"]
+        changed = rpc("remote.session.organize", {"session_id": "a", "expected_version": metadata["version"], "pinned": True})
+        assert changed["result"]["session"]["pinned"]

@@ -0,0 +1,73 @@
+"""Narrow authenticated file reads; the private producer hook is not a client RPC."""
+from .method_ctx import HandlerRegistry, bind_module
+
+_registry = HandlerRegistry()
+method = _registry.method
+
+
+def _remote_files_handler(name, *, session=True):
+    def decorate(body):
+        @method(name)
+        def handler(rid, params):
+            import sqlite3
+            context, error = _remote_info_authorize(params, rid, require_session=session)
+            if error:
+                return error
+            try:
+                return body(rid, params, context)
+            except (OSError, ValueError, TypeError, KeyError, sqlite3.Error):
+                return _err(rid, 5410, "File is unavailable, changed, unsupported or outside the allowed range; no write performed")
+        return handler
+    return decorate
+
+
+@_remote_files_handler("remote.files.roots")
+def _remote_files_roots(rid, params, context):
+    from tui_gateway.remote_files import session_roots, READ_LIMIT
+    rows, truncated = session_roots(context["home"], context["session"])
+    return _ok(rid, {"version": 1, "profile": context["profile"], "session_id": context["sid"], "roots": [{key: row[key] for key in ("id", "project_id", "name", "folder_name")} for row in rows],
+                     "max_bytes": READ_LIMIT, "truncated": truncated})
+
+
+@_remote_files_handler("remote.files.list")
+def _remote_files_list(rid, params, context):
+    from tui_gateway.remote_files import session_root, list_directory
+    root = session_root(context["home"], context["session"], params["root_id"])
+    return _ok(rid, {"version": 1, "profile": context["profile"], "session_id": context["sid"], "root_id": root["id"], "path": params.get("path", ""),
+                     **list_directory(context["home"], root, params.get("path", ""))})
+
+
+@_remote_files_handler("remote.files.read")
+def _remote_files_read(rid, params, context):
+    from tui_gateway.remote_files import session_root, read_file
+    root = session_root(context["home"], context["session"], params["root_id"])
+    return _ok(rid, {"version": 1, "profile": context["profile"], "session_id": context["sid"], "root_id": root["id"], "path": params["path"],
+                     "content": read_file(context["home"], root, params["path"], params["expected_etag"])})
+
+
+@_remote_files_handler("remote.artifacts.list", session=True)
+def _remote_artifacts_list(rid, params, context):
+    from tui_gateway.remote_files import artifact_rows, READ_LIMIT
+    rows, truncated = artifact_rows(context["home"], context["session"], context["principal"])
+    public = [{key: row[key] for key in ("id", "name", "mime", "bytes", "etag", "producer", "registered_at")} for row in rows]
+    return _ok(rid, {"version": 1, "profile": context["profile"], "session_id": context["sid"], "rows": public, "truncated": truncated,
+                     "max_bytes": READ_LIMIT, "scope": "canonical_tool_rows"})
+
+
+@_remote_files_handler("remote.artifacts.read", session=True)
+def _remote_artifacts_read(rid, params, context):
+    from tui_gateway.remote_files import artifact_rows, find_root, read_file, FileUnavailable
+    record = next((row for row in artifact_rows(context["home"], context["session"], context["principal"])[0] if row["id"] == params["artifact_id"]), None)
+    if not record or record["etag"] != params["expected_etag"]:
+        raise FileUnavailable("Artifact identity or version is unavailable")
+    # The canonical owned tool row authorizes its original registered root even
+    # when a later turn or lazy resume has a different current working directory.
+    root = find_root(context["home"], record["root_id"])
+    content = read_file(context["home"], root, record["relative_path"], record["etag"])
+    if content["sha256"] != record["sha256"]:
+        raise FileUnavailable("Artifact changed")
+    return _ok(rid, {"version": 1, "profile": context["profile"], "session_id": context["sid"], "artifact_id": record["id"], "content": content})
+
+
+def register(server):
+    bind_module(globals(), server)

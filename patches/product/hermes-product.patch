+@pytest.fixture
+def project_gateway(real_gateway, monkeypatch):
+    from hermes_cli import profiles, projects_db, runtime_provider
+    from tui_gateway import methods_remote_information
+
+    server, records, _, rpc, _, home, _ = real_gateway
+    methods_remote_information.register(server)
+    worker = profiles.get_profile_dir("r08-worker")
+    assert worker.resolve().is_relative_to(home.parent.resolve())
+    worker.mkdir(parents=True, exist_ok=True)
+    worker.joinpath("config.yaml").write_bytes(home.joinpath("config.yaml").read_bytes())
+    roots, project_ids = {}, {}
+    for name, profile_home in (("default", home), ("r08-worker", worker)):
+        root = home.parent / f"DEMO-{name}-project"
+        root.mkdir()
+        with projects_db.connect_closing(profile_home / "projects.db") as db:
+            project_ids[name] = projects_db.create_project(db, name=f"DEMO {name}", folders=[str(root)])
+        roots[name] = root
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("Registered-project lazy creation must not construct agents, resolve credentials or call providers")
+
+    monkeypatch.setattr(server, "_schedule_agent_build", forbidden)
+    monkeypatch.setattr(server, "_make_agent", forbidden)
+    monkeypatch.setattr(runtime_provider, "resolve_runtime_provider", forbidden)
+    return server, records, rpc, home, worker, roots, project_ids

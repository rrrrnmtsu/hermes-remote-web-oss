+"""Real scoped gateway feature negotiation and no-generation session startup."""
+from pathlib import Path
+
+from tests.tui_gateway.test_image_turn_integration import real_gateway
+
+
+def test_capability_is_implementation_bound_and_generation_off_by_default(real_gateway, monkeypatch):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    original = server._load_cfg
+    # The shared provider-boundary fixture opts in only for synthetic image turns.
+    # This case explicitly exercises the ordinary profile's absent-policy default.
+    monkeypatch.setattr(server, '_load_cfg', lambda: {key: value for key, value in original().items() if key != 'remote_web'})
+    caps = rpc('gateway.capabilities')['result']
+    assert caps['remote_web_version'] == 1
+    remote = rpc('remote.app.capabilities', {'profile': 'default'})['result']
+    assert remote['version'] == 1
+    assert len(remote['principal_id']) == 64
+    assert remote['generation_allowed'] is False
+    assert {'remote.sessions.list', 'remote.info.snapshot'} <= set(remote['methods'])
+    assert all(name.startswith('remote.') and name in server._methods for name in remote['methods'])
+    assert records == []
+    monkeypatch.setattr(server, '_load_cfg', lambda: {**original(), 'remote_web': {'generation_authorized': True}})
+    assert rpc('remote.app.capabilities', {'profile': 'default'})['result']['generation_allowed'] is True
+    assert records == []
+
+
+def test_lazy_create_and_registered_project_do_not_construct_agent(real_gateway, monkeypatch):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    calls = []
+    def forbidden(*args, **kwargs):
+        calls.append(True)
+        raise AssertionError('No provider or credential resolver may start on project creation')
+    monkeypatch.setattr(server, '_make_agent', forbidden)
+    response = rpc('session.create', {'profile': 'default', 'lazy': True, 'close_on_disconnect': False})
+    assert 'result' in response, response
+    sid = response['result']['session_id']
+    assert server._sessions[sid]['agent'] is None and not server._sessions[sid].get('agent_build_started')
+    assert calls == [] and records == []
+    from hermes_cli import projects_db
+    project_root = home.parent / 'synthetic-project'; project_root.mkdir()
+    with projects_db.connect_closing() as conn:
+        # Canonical project schema/functions are exercised rather than a made-up path RPC.
+        project = projects_db.create_project(conn, name='Remote synthetic project', primary_path=str(project_root))
+    created = rpc('remote.project.create_session', {'profile': 'default', 'project_id': project})
+    assert 'result' in created, created
+    result = created['result']
+    assert result['project']['id'] == project
+    assert Path(result['project']['cwd']).resolve() == project_root.resolve()
+    assert server._sessions[result['session_id']]['agent'] is None

+@pytest.mark.parametrize("hook_mode", ["actual_common_hook", "private_hook_trial"])
+def test_real_owned_session_native_artifact_callback_flush_read_and_resume(real_gateway, tmp_path, monkeypatch, hook_mode):
+    from hermes_cli import projects_db
+    from tui_gateway import methods_remote_files, methods_remote_information, remote_files
+    from tui_gateway.contracts import remote_files as contracts  # noqa: F401
+    from tui_gateway.contracts import remote_information  # noqa: F401
+    from tools.environments.local import LocalEnvironment
+    from tools.file_operations import ShellFileOperations
+
+    server, records, gate, rpc, create, home, transport = real_gateway
+    methods_remote_information.register(server); methods_remote_files.register(server)
+    root = tmp_path / "DEMO-artifact-project"; root.mkdir()
+    with projects_db.connect_closing(home / "projects.db") as db:
+        projects_db.create_project(db, name="DEMO artifact project", folders=[str(root)])
+
+    # The real common-hook case intentionally fails until the integration owner
+    # connects it. A separately labelled private-hook trial cannot count as that
+    # case passing. Both use real session/writer/inspection/canonical persistence.
+    original_prepare = server._prepare_tool_result_metadata
+    def prepare(sid, call_id, name, args, result):
+        envelope = original_prepare(sid, call_id, name, args, result)
+        session = server._sessions[sid]
+        artifact = remote_files.prepare_artifacts(session, home, server._session_auth_user_id(session), call_id, name, args, result,
+                                                  local_execution_verified=server._session_is_local_backend(session))
+        if artifact:
+            envelope.setdefault("tool_result_metadata", {})["remote_artifacts"] = artifact
+        return envelope
+    if hook_mode == "private_hook_trial":
+        monkeypatch.setattr(server, "_prepare_tool_result_metadata", prepare)
+    reply = rpc("session.create", {"profile": "default", "cwd": str(root), "close_on_disconnect": False})
+    assert "result" in reply, reply
+    sid = reply["result"]["session_id"]; session = server._sessions[sid]
+    assert session["agent_ready"].wait(15)
+    agent = session["agent"]
+    assert agent.tools == [] and records == []
+
+    env = LocalEnvironment(cwd=str(root), timeout=10, env={"HOME": str(tmp_path), "HERMES_HOME": str(home)})
+    try:
+        result = ShellFileOperations(env, cwd=str(root)).write_file(str(root / "report.md"), "# 合成成果物\n\n```text\nDEMO\n```\n")
+        assert result.verified and not result.error
+        payload = {**result.to_dict(), "resolved_path": str(root / "report.md")}
+        metadata = agent.tool_result_metadata_callback("DEMO-native-write", "write_file", {"path": "report.md"}, json.dumps(payload))
+        assert len(metadata["tool_result_metadata"]["remote_artifacts"]) == 1
+        assert rpc("remote.artifacts.list", {"profile": "default", "session_id": sid})["result"]["rows"] == []
+
+        # The same AIAgent incremental flush used after native tool completion.
+        messages = [
+            {"role": "assistant", "content": "", "tool_calls": [{"id": "DEMO-native-write", "type": "function", "function": {
+                "name": "write_file", "arguments": json.dumps({"path": "report.md", "content": "DEMO"})}}]},
+            {"role": "tool", "tool_call_id": "DEMO-native-write", "content": json.dumps(payload), "display_metadata": metadata},
+        ]
+        assert agent._flush_messages_to_session_db(messages) is not False
+        listed = rpc("remote.artifacts.list", {"profile": "default", "session_id": sid})["result"]
+        assert len(listed["rows"]) == 1 and listed["session_id"] == sid
+        row = listed["rows"][0]
+        args = {"profile": "default", "session_id": sid, "artifact_id": row["id"], "expected_etag": row["etag"]}
+        read = rpc("remote.artifacts.read", args)
+        assert read["result"]["content"]["text"].startswith("# 合成成果物"), read
+        assert str(root) not in json.dumps(listed) and "resolved_path" not in json.dumps(read)
+        transport.auth_identity = {"provider": "DEMO", "user_id": "foreign"}
+        assert rpc("remote.artifacts.read", args)["error"]["code"] == 4403
+        assert rpc("remote.files.roots", {"profile": "default", "session_id": sid})["error"]["code"] == 4403
+        transport.auth_identity = {"provider": "DEMO", "user_id": "DEMO-user"}
+
+        # Lose the live registry without deleting or rolling back canonical history.
+        key = session["session_key"]
+        agent.close(); server._release_active_session_slot(session); server._sessions.clear()
+        resumed = rpc("session.resume", {"profile": "default", "session_id": key, "lazy": True, "close_on_disconnect": False})
+        assert "result" in resumed, resumed
+        resumed_id = resumed["result"]["session_id"]
+        readback = rpc("remote.artifacts.list", {"profile": "default", "session_id": resumed_id})
+        assert readback["result"]["rows"][0]["id"] == row["id"], readback
+        assert rpc("remote.artifacts.read", {**args, "session_id": resumed_id})["result"]["content"]["sha256"] == read["result"]["content"]["sha256"]
+        assert records == [] and server._sessions[resumed_id].get("agent") is None
+    finally:
+        env.cleanup()

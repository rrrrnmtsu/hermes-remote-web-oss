+"""Read-only session/profile policy for atomic prompt documents."""
+from .method_ctx import HandlerRegistry, bind_module
+
+_registry = HandlerRegistry()
+method = _registry.method
+
+
+@method("remote.documents.capabilities")
+@_registry.profile_scoped
+def remote_document_capabilities(rid, params):
+    from tui_gateway.prompt_document_turn import capabilities
+    from hermes_cli.config import load_config_readonly
+    session, error = _sess_nowait(params, rid)
+    if error: return error
+    home = _profile_home(params.get("profile")) if params.get("profile") else None
+    if params.get("profile") and Path(home or _hermes_home).resolve() != _session_home(session).resolve():
+        return _err(rid, 4130, "document profile and session disagree")
+    if session.get("auth_user_id") and _transport_auth_user_id(current_transport()) != session["auth_user_id"]:
+        return _err(rid, 4130, "document session belongs to a different authenticated user")
+    with _session_profile_runtime_scope(session):
+        return _ok(rid, capabilities(session, load_config_readonly() or {}))
+
+
+def register(server):
+    bind_module(globals(), server)

+def project(home: Path, project_id: str) -> dict:
+    try:
+        with open_readonly(home / "projects.db") as conn:
+            row = conn.execute("SELECT id,name,primary_path,archived FROM projects WHERE id=?", (project_id,)).fetchone()
+            if row is None or row["archived"] or not row["primary_path"]:

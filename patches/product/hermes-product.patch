+def test_actual_sdk_encrypts_only_generic_kind_at_the_http_boundary(app_home, browser_subscription):
+    subscription, private, auth = browser_subscription
+    https = RecordingHTTPS()
+    assert notifications.send_web_push(app_home, subscription, "result", session=https) == "sent"
+    assert len(https.calls) == 1
+    endpoint, ciphertext, headers, timeout = https.calls[0]
+    assert endpoint == subscription["endpoint"] and timeout == 5
+    assert headers["content-encoding"] == "aes128gcm"
+    assert b"result" not in ciphertext
+    plaintext = http_ece.decrypt(ciphertext, private_key=private, auth_secret=auth, version="aes128gcm")
+    assert json.loads(plaintext) == {"kind": "result"}
+    assert notifications.send_web_push(app_home, subscription, "waiting", session=https) == "sent"

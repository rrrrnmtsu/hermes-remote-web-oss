+def usage_snapshot(home: Path, session: dict | None, principal: str) -> dict:
+    session = session or {}
+    agent = session.get("agent")
+    unknown = {"source": "unknown"}
+    if agent is not None and not session.get("_compute_host_active"):
+        keys = {"input": "session_input_tokens", "output": "session_output_tokens", "reasoning": "session_reasoning_tokens",
+                "cache_read": "session_cache_read_tokens", "cache_write": "session_cache_write_tokens",
+                "total": "session_total_tokens", "calls": "session_api_calls"}
+        values = {key: nonnegative(getattr(agent, attr, None)) for key, attr in keys.items()}
+        unknown = {"source": "live", **values}
+    stored_id = session.get("session_key")
+    if not stored_id:
+        return unknown
+    try:
+        with open_readonly(home / "state.db") as conn:
+            row = conn.execute("SELECT * FROM sessions WHERE id=? AND user_id=?", (stored_id, principal)).fetchone()
+            if row is None:
+                return unknown
+            # The local canonical accounting ledger already separates main and auxiliary calls.
+            entries = conn.execute("SELECT * FROM session_model_usage WHERE session_id=? LIMIT 101", (stored_id,)).fetchall()
+    except (OSError, ValueError, sqlite3.Error):
+        return unknown
+    main = [dict(entry) for entry in entries if not entry["task"]]
+    auxiliary = [dict(entry) for entry in entries if entry["task"]]
+    if len(entries) > MAX_ROWS:
+        return {**unknown, "accounting_scope": "Current durable segment; usage ledger exceeds the bounded read limit."}
+    def aggregate(key):
+        numbers = [nonnegative(entry.get(key)) for entry in main]
+        return sum(numbers) if numbers and all(value is not None for value in numbers) else None
+    data = {"source": "stored", "input": aggregate("input_tokens"), "output": aggregate("output_tokens"),
+            "reasoning": aggregate("reasoning_tokens"), "cache_read": aggregate("cache_read_tokens"),
+            "cache_write": aggregate("cache_write_tokens"), "calls": aggregate("api_call_count"),
+            "auxiliary_calls": sum(entry.get("api_call_count") or 0 for entry in auxiliary)}
+    # Canonical total includes cache counts but never reasoning a second time.
+    summands = [data[key] for key in ("input", "output", "cache_read", "cache_write")]
+    data["total"] = sum(summands) if all(value is not None for value in summands) else None
+    estimated = [entry for entry in main if entry.get("cost_status") in {"estimated", "actual", "known"}]
+    actual = [entry for entry in main if entry.get("cost_status") == "actual"]
+    def cost_total(entries, field):
+        amounts = [nonnegative(entry.get(field)) for entry in entries]
+        return sum(amounts) if main and len(entries) == len(main) and all(amount is not None for amount in amounts) else None
+    data["estimated_cost_usd"] = cost_total(estimated, "estimated_cost_usd")
+    data["actual_cost_usd"] = cost_total(actual, "actual_cost_usd")
+    sources = {display_text(entry.get("cost_source")) for entry in main if entry.get("cost_source")}
+    data["pricing_source"] = ", ".join(sorted(sources)) or None
+    data["pricing_version"] = display_text(row["pricing_version"]) or None if "pricing_version" in row.keys() else None
+    stamp = max((nonnegative(entry.get("last_seen")) or 0 for entry in main), default=0)
+    data["price_checked_at"] = stamp or None
+    data["started_at"] = nonnegative(row["started_at"])
+    data["completed_at"] = nonnegative(row["ended_at"])
+    if data["started_at"] is not None and data["completed_at"] is not None:
+        data["elapsed_seconds"] = max(0, data["completed_at"] - data["started_at"])
+    # Live totals and stored totals are alternate snapshots, never added together.
+    return {**data, **(unknown if unknown["source"] == "live" else {})}
+

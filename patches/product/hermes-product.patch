+    for folder, model in ((home, "first"), (secondary, "worker")):
+        folder.mkdir(parents=True)
+        (folder / "config.yaml").write_text(json.dumps({"model": {"default": model, "provider": "anthropic", "models": [
+            {"id": model, "context_length": 16000, "max_output_tokens": 512}, {"id": "next", "context_length": 8000, "max_output_tokens": 512}]},
+            "mcp_servers": {"DEMO-server": {"url": "https://user:private@example.invalid/rpc?key=private", "headers": {"Authorization": "DEMO-secret"}}}}))
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)

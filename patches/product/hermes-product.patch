+@pytest.fixture
+def store(tmp_path):
+    from hermes_state import SessionDB
+    db = SessionDB(tmp_path / "profile-a" / "state.db")
+    for sid, owner, title in [("a", "DEMO:alice", "日本語_100%"), ("b", "DEMO:bob", "他の所有者"),
+                              ("legacy", None, "旧所有者")]:
+        db.create_session(sid, source="tui", user_id=owner, model="synthetic")
+        db.set_session_title(sid, title)
+        db.append_messages_batch(sid, [{"role": "user", "content": "合成の質問"},
+                                       {"role": "assistant", "content": "合成の回答"}])
+    try:
+        yield db
+    finally:
+        db.close()

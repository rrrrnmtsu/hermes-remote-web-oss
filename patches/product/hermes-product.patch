+def test_safe_http_transport_pins_public_dns_tls_port_and_does_not_follow_redirects(monkeypatch):
+    calls = []
+    class Connection:
+        def __init__(self, host, address, timeout):
+            calls.append((host, address, timeout))
+        def request(self, method, path, body, headers):
+            calls.append((method, path, body, headers))
+        def getresponse(self):
+            return SimpleNamespace(status=302)
+        def close(self):
+            calls.append("closed")
+    monkeypatch.setenv("HTTPS_PROXY", "http://127.0.0.1:9")
+    transport = notifications.SafePushSession(connection_factory=Connection)
+    result = transport.post("https://web.push.apple.com/synthetic", data=b"encrypted", headers={"TTL": "300"}, timeout=30)
+    assert result.status_code == 302 and calls[0] == ("web.push.apple.com", public_dns("web.push.apple.com", 443)[0], 5)
+    assert calls[1][0:2] == ("POST", "/synthetic") and calls[-1] == "closed" and len(calls) == 3
+    with pytest.raises(notifications.NotificationError):
+        transport.post("https://web.push.apple.com/synthetic", data=b"x" * 4097)
+    with pytest.raises(notifications.NotificationError):
+        transport.post("https://web.push.apple.com/synthetic", data=b"x", headers={"TTL": "300\r\nunsafe"})

index 0000000000000000000000000000000000000000..611cb14103a03050cc5422f7f96da0c63a40da58
--- /dev/null
+++ b/tests/tui_gateway/test_document_image_provider_policy.py
@@ -0,0 +1,38 @@
+"""Read existing model/history metadata only; never provider or credential probes."""
+import pytest
+
+from tui_gateway.prompt_image_turn import capabilities, ImageTurnError
+from tui_gateway.remote_attachment_policy import image_provider_limits, restrict_image_capabilities, enforce_image_provider_limits
+
+
+def config(provider="anthropic"):
+    return {"model": {"provider": provider, "default": "DEMO-model", "supports_vision": True},
+            "agent": {"image_input_mode": "native"}}
+
+
+def test_native_limits_include_historical_turns_and_tool_images():
+    history = [{"role": "user", "content": [{"type": "image", "source": {"type": "base64"}}]} for _ in range(19)]
+    assert image_provider_limits({"history": history}, config())["max_edge"] == 8000
+    history.append({"role": "tool", "content": [{"type": "tool_result", "content": [{"type": "image_url"}]}]})
+    limits = image_provider_limits({"history": history}, config())
+    assert limits["history_images"] == 20 and limits["max_edge"] == 2000 and limits["max_pixels"] == 4_000_000
+
+
+def test_unknown_provider_is_disabled_without_fallback_or_resolver():
+    cap = restrict_image_capabilities({}, config("unknown-provider"), capabilities({}, config("unknown-provider")))
+    assert cap["enabled"] is False and cap["reason"] == "provider_image_limit_unconfirmed"
+    with pytest.raises(ImageTurnError):
+        enforce_image_provider_limits({"data": b"small", "width": 2, "height": 2}, {}, config("unknown-provider"))
+
+
+def test_count_limit_and_display_metadata_do_not_double_count_one_turn():
+    row = {"display_kind": "image_turn", "display_metadata": {"image_receipt_id": "DEMO"},
+           "content": "[Image attached at: internal-path]"}
+    assert image_provider_limits({"history": [row] * 99}, config())["supported"] is True
+    assert image_provider_limits({"history": [row] * 100}, config())["reason"] == "history_image_count_limit"
+
+
+def test_stricter_history_edge_is_rechecked_before_generation():
+    session = {"history": [{"content": [{"type": "image"} for _ in range(20)]}]}
+    with pytest.raises(ImageTurnError): enforce_image_provider_limits({"data": b"image", "width": 2001, "height": 2}, session, config())
+    enforce_image_provider_limits({"data": b"image", "width": 2000, "height": 2}, session, config())
diff --git a/tests/tui_gateway/test_document_pdf_boundary.py b/tests/tui_gateway/test_document_pdf_boundary.py
new file mode 100644
index 0000000000000000000000000000000000000000..ceb282d208b56925c6bf225f880b6fd13ebc590a
--- /dev/null
+++ b/tests/tui_gateway/test_document_pdf_boundary.py
@@ -0,0 +1,115 @@
+"""The shared PDF boundary parses actual names/keys, including escaped/object-stream references."""
+import io
+import zlib
+
+import pytest
+
+from tui_gateway import prompt_document_turn as documents
+from tests.tui_gateway.test_document_turn_validation import bounded_pdf_dependency, pdf_bytes, payload  # noqa: F401
+
+
+def modified_pdf(modifier):
+    from pypdf import PdfWriter
+    writer = PdfWriter(); writer.add_blank_page(300, 300)
+    modifier(writer)
+    output = io.BytesIO(); writer.write(output)
+    return output.getvalue()
+
+
+@pytest.mark.parametrize("name", ["/JS", "/JavaScript", "/Launch", "/AA", "/OpenAction", "/EmbeddedFile",
+    "/EmbeddedFiles", "/EF", "/RichMedia", "/XFA", "/AcroForm", "/SubmitForm", "/ImportData", "/GoToR",
+    "/URI", "/Sound", "/Movie", "/Filespec", "/FileAttachment"])
+@pytest.mark.parametrize("placement", ["key", "name_in_array"])
+def test_forbidden_parsed_key_or_name_refused_even_in_nested_indirect_data(name, placement):
+    from pypdf.generic import DictionaryObject, NameObject, ArrayObject, TextStringObject
+    def modifier(writer):
+        nested = DictionaryObject({NameObject(name): TextStringObject("synthetic")}) if placement == "key" else ArrayObject([NameObject(name)])
+        reference = writer._add_object(nested)
+        writer._root_object[NameObject("/SyntheticNested")] = reference
+    with pytest.raises(documents.DocumentTurnError, match="active content"):
+        documents.validate_pdf(modified_pdf(modifier))
+
+
+def test_hex_escaped_action_name_and_metadata_string_are_distinct():
+    from pypdf.generic import NameObject, TextStringObject
+    class EscapedName(NameObject):
+        def write_to_stream(self, stream, *args, **kwargs): stream.write(b"/Java#53cript")
+    encoded = modified_pdf(lambda w: w._root_object.__setitem__(EscapedName("/JavaScript"), TextStringObject("synthetic")))
+    with pytest.raises(documents.DocumentTurnError, match="active content"):
+        documents.validate_pdf(encoded)
+    ordinary = modified_pdf(lambda w: w.add_metadata({"/Subject": "The text /JavaScript is only a literal mention"}))
+    assert documents.validate_pdf(ordinary)["pages"] == 1
+
+
+def object_stream_pdf(active=True):
+    """A real xref/object-stream PDF; the hidden compressed dictionary is reachable from /Names."""
+    objects = {1: b"<< /Type /Catalog /Pages 2 0 R /Names 5 0 R >>",
+        2: b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+        3: b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 300 300] >>"}
+    nested = b"<< /JS (synthetic) >>" if active else b"<< /Synthetic (ordinary) >>"
+    packed = b"5 0 " + nested; compressed = zlib.compress(packed)
+    objects[4] = b"<< /Type /ObjStm /N 1 /First 4 /Filter /FlateDecode /Length " + str(len(compressed)).encode() + b" >>\nstream\n" + compressed + b"\nendstream"
+    output = bytearray(b"%PDF-1.7\n")
+    offsets = {}
+    for number, body in objects.items():
+        offsets[number] = len(output); output.extend(str(number).encode() + b" 0 obj\n" + body + b"\nendobj\n")
+    xref_offset = len(output)
+    entries = bytearray()
+    for number in range(7):
+        kind, field, generation = (0, 0, 65535) if number == 0 else (2, 4, 0) if number == 5 else (1, xref_offset, 0) if number == 6 else (1, offsets[number], 0)
+        entries.extend(bytes([kind]) + field.to_bytes(4, "big") + generation.to_bytes(2, "big"))
+    compressed_xref = zlib.compress(entries)
+    output.extend(b"6 0 obj\n<< /Type /XRef /Size 7 /W [1 4 2] /Root 1 0 R /Filter /FlateDecode /Length " +
+                  str(len(compressed_xref)).encode() + b" >>\nstream\n" + compressed_xref + b"\nendstream\nendobj\nstartxref\n" + str(xref_offset).encode() + b"\n%%EOF\n")
+    return bytes(output)
+
+
+def test_reachable_compressed_object_dictionary_uses_same_semantic_boundary():
+    with pytest.raises(documents.DocumentTurnError, match="active content"):
+        documents.validate_pdf(object_stream_pdf())
+    assert documents.validate_pdf(object_stream_pdf(active=False))["pages"] == 1
+
+
+def test_read_view_accepts_empty_text_layer_but_attachment_requires_text():
+    empty = modified_pdf(lambda w: None)
+    metadata = documents.validate_pdf(empty, require_text=False)
+    assert metadata == {"text": "", "pages": 1, "text_bytes": 0, "format": "PDF", "extraction": "pdf_text", "truncated": False}
+    with pytest.raises(documents.DocumentTurnError, match="No PDF text"):
+        documents.validate_pdf(empty, require_text=True)
+    with pytest.raises(documents.DocumentTurnError, match="No PDF text"):
+        documents.validate(payload(empty, "empty.pdf"), "本文")
+    assert "SYNTHETIC" in documents.validate_pdf(pdf_bytes(), require_text=True)["text"]
+
+
+@pytest.mark.parametrize("case", ["array", "dictionary", "depth", "stream_count", "stream_total", "external_stream"])
+def test_graph_and_stream_resources_fail_closed(case):
+    from pypdf.generic import DictionaryObject, NameObject, ArrayObject, NumberObject, DecodedStreamObject
+    def modifier(writer):
+        if case == "array": value = ArrayObject([NumberObject(1)] * (documents.PDF_MAX_ARRAY + 1))
+        elif case == "dictionary": value = DictionaryObject({NameObject("/X" + str(i)): NumberObject(i) for i in range(documents.PDF_MAX_DICTIONARY + 1)})
+        elif case == "depth":
+            value = NumberObject(1)
+            for _ in range(documents.PDF_MAX_DEPTH + 1): value = ArrayObject([value])
+        else:
+            value = ArrayObject()
+            count = documents.PDF_MAX_STREAMS + 1 if case == "stream_count" else 5 if case == "stream_total" else 1
+            for _ in range(count):
+                stream = DecodedStreamObject(); stream.set_data(b"x" * documents.PDF_STREAM_LIMIT if case == "stream_total" else b"x")
+                if case == "external_stream": stream[NameObject("/F")] = NameObject("/SyntheticExternal")
+                value.append(writer._add_object(stream.flate_encode() if case == "stream_total" else stream))
+        writer._root_object[NameObject("/Synthetic")] = value
+    with pytest.raises(documents.DocumentTurnError): documents.validate_pdf(modified_pdf(modifier))
+
+
+def test_cyclic_references_are_visited_once_without_skipping_new_active_branch():
+    from pypdf.generic import DictionaryObject, NameObject
+    def ordinary(writer):
+        value = DictionaryObject(); reference = writer._add_object(value)
+        value[NameObject("/Self")] = reference
+        writer._root_object[NameObject("/Synthetic")] = reference
+    assert documents.validate_pdf(modified_pdf(ordinary))["pages"] == 1
+    def active(writer):
+        ordinary(writer)
+        writer._root_object[NameObject("/AA")] = DictionaryObject()
+    with pytest.raises(documents.DocumentTurnError, match="active content"):
+        documents.validate_pdf(modified_pdf(active))

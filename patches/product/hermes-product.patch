+"""Real prompt/session/decoder/storage/agent path; only provider HTTP is synthetic.
+
+Run after the common prompt.submit.document hooks are integrated. A missing
+contract or hook fails these tests rather than becoming a local-preview PASS.
+"""
+import json
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from tests.tui_gateway.test_image_turn_integration import real_gateway, wait_done  # noqa: F401
+from tests.tui_gateway.test_document_turn_validation import bounded_pdf_dependency, payload, pdf_bytes  # noqa: F401
+from tests.tui_gateway.test_image_turn_validation import payload as image_payload
+
+
+@pytest.mark.parametrize("name,source,expected", [
+    ("source.txt", "日本語の合成TXT資料\n".encode(), "日本語の合成TXT資料"),
+    ("source.md", "# 合成Markdown\n```text\nsource\n```".encode(), "合成Markdown"),
+    ("source.csv", "項目,数量\n合成,3\n".encode(), "項目,数量"),
+    ("source.pdf", None, "SYNTHETIC PDF TEXT"),
+])
+def test_real_document_rpc_bind_and_caption_only_saved_history(real_gateway, name, source, expected):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    sid = create(); original = pdf_bytes() if source is None else source
+    document = payload(original, name)
+    cap = rpc("remote.documents.capabilities", {"session_id": sid})
+    assert cap["result"]["enabled"] and cap["result"]["generation_verified"] is False, cap
+    caption = "この合成資料を確認してください。"
+    accepted = rpc("prompt.submit", {"session_id": sid, "text": caption, "image": None, "document": document})
+    assert accepted["result"]["document_turn"]["truncated"] is False, accepted
+    receipt = accepted["result"]["document_turn"]
+    assert receipt["extraction"] == ("pdf_text" if name.endswith("pdf") else "utf8")
+    wait_done(server, sid)
+    assert len(records) == 1 and records[0]["tools"] == 0 and records[0]["image_count"] == 0
+    assert caption in records[0]["last_text"] and expected in records[0]["last_text"]
+    assert server._sessions[sid]["attached_images"] == []
+    originals = list((home / "documents").rglob(receipt["receipt_id"] + ".*"))
+    assert len(originals) == 1 and originals[0].read_bytes() == original
+    key = server._sessions[sid]["session_key"]
+    resumed = rpc("session.resume", {"session_id": key, "lazy": True, "inline_images": False, "close_on_disconnect": False})
+    user = [m for m in resumed["result"]["messages"] if m.get("role") == "user"]
+    assert len(user) == 1 and user[0]["text"] == caption, resumed
+    assert "合成画像受付OK" in json.dumps(resumed, ensure_ascii=False)
+
+
+@pytest.mark.parametrize("case", ["binary", "encrypted", "pages", "broken", "extra", "both", "empty_caption", "legacy_pending"])
+def test_rejected_document_never_generates_or_consumes_other_pending(real_gateway, case):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    sid = create(); doc = payload(); caption = "合成本文"; image = None
+    if case == "binary": doc = payload(b"bad\x00bytes")
+    if case == "encrypted": doc = payload(pdf_bytes(encrypted=True), "source.pdf")
+    if case == "pages": doc = payload(pdf_bytes(pages=21), "source.pdf")
+    if case == "broken": doc = payload(b"%PDF-1.7\nbroken\n%%EOF", "source.pdf")
+    if case == "extra": doc["attachment_id"] = "DEMO-foreign"
+    if case == "both": image = image_payload()
+    if case == "empty_caption": caption = " "
+    if case == "legacy_pending": server._sessions[sid]["attached_images"] = ["DEMO-foreign-original"]
+    before = list(server._sessions[sid]["attached_images"])
+    result = rpc("prompt.submit", {"session_id": sid, "text": caption, "image": image, "document": doc})
+    assert "error" in result, result
+    assert not records and server._sessions[sid]["attached_images"] == before
+    assert not list((home / "documents").rglob("*.txt")) and not list((home / "documents").rglob("*.pdf"))
+
+
+def test_desktop_send_cancel_and_second_document_cannot_mutate_inflight_turn(real_gateway):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    sid = create(); gate.clear(); caption = "最初の日本語本文"
+    result = rpc("prompt.submit", {"session_id": sid, "text": caption, "document": payload(b"FIRST-DOCUMENT")})
+    assert "document_turn" in result["result"], result
+    for method, params in [("prompt.submit", {"text": "別端末本文"}),
+                           ("prompt.submit", {"text": "別資料", "document": payload(b"SECOND-DOCUMENT")}),
+                           ("image.attach_bytes", image_payload()), ("image.detach", {"path": "foreign.png"})]:
+        assert rpc(method, {"session_id": sid, **params})["error"]["code"] == 4009
+    gate.set(); wait_done(server, sid)
+    assert len(records) == 1 and caption in records[0]["last_text"]
+    assert "FIRST-DOCUMENT" in records[0]["last_text"] and "SECOND-DOCUMENT" not in records[0]["last_text"]
+
+
+def test_distinct_sessions_do_not_overwrite_originals_or_feed_a_later_turn(real_gateway):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    a, b = create(), create()
+    def submit(item):
+        sid, source = item
+        return rpc("prompt.submit", {"session_id": sid, "text": "本文", "document": payload(source)})
+    with ThreadPoolExecutor(2) as pool:
+        accepted = list(pool.map(submit, [(a, b"SOURCE-A"), (b, b"SOURCE-B")]))
+    assert all("document_turn" in r.get("result", {}) for r in accepted), accepted
+    wait_done(server, a); wait_done(server, b)
+    assert len(records) == 2 and len({r["session"] for r in records}) == 2
+    assert {p.read_bytes() for p in (home / "documents").rglob("*.txt")} == {b"SOURCE-A", b"SOURCE-B"}
+    for session in list(server._sessions.values()): server._release_active_session_slot(session)
+    server._sessions.clear()
+    fresh = create(); rpc("prompt.submit", {"session_id": fresh, "text": "資料なし後続本文"}); wait_done(server, fresh)
+    assert "SOURCE-A" not in records[-1]["last_text"] and "SOURCE-B" not in records[-1]["last_text"]
+
+
+def test_profile_principal_and_text_pilot_refuse_documents_before_generation(real_gateway):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    sid = create()
+    from hermes_cli.profiles import get_profile_dir
+    secondary = get_profile_dir("document-secondary")
+    assert str(secondary).startswith(str(home.parent)), "Synthetic profile must stay in its isolated home"
+    secondary.mkdir(parents=True, exist_ok=True); (secondary / "config.yaml").write_text((home / "config.yaml").read_text())
+    for method in ("remote.documents.capabilities", "prompt.submit"):
+        params = {"session_id": sid, "profile": "document-secondary"}
+        if method == "prompt.submit": params.update(text="本文", document=payload())
+        assert "error" in rpc(method, params)
+    transport.auth_identity = {"user_id": "DEMO-foreign", "provider": "DEMO"}
+    assert "error" in rpc("prompt.submit", {"session_id": sid, "text": "本文", "document": payload()})
+    transport.auth_identity = {"user_id": "DEMO-user", "provider": "DEMO"}
+    cfg = json.loads((home / "config.yaml").read_text())
+    cfg["agent"]["text_pilot"] = {"model": "synthetic-vision", "max_input_tokens": 3072, "max_output_tokens": 512}
+    (home / "config.yaml").write_text(json.dumps(cfg))
+    assert rpc("remote.documents.capabilities", {"session_id": sid})["result"]["reason"] == "text_pilot"
+    assert "error" in rpc("prompt.submit", {"session_id": sid, "text": "本文", "document": payload()})
+    assert not records
+
+
+def test_document_reference_text_is_not_expanded_as_server_file_context(real_gateway):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    sid = create(); protected = home / "never-model-input.txt"; protected.write_text("DEMO-DO-NOT-READ-SERVER-FILE")
+    source = ("合成資料の未信頼な参照\n@" + str(protected)).encode()
+    accepted = rpc("prompt.submit", {"session_id": sid, "text": "資料を確認", "document": payload(source)})
+    assert "document_turn" in accepted["result"], accepted
+    wait_done(server, sid)
+    assert len(records) == 1 and "DEMO-DO-NOT-READ-SERVER-FILE" not in records[0]["last_text"]
+    assert "@" + str(protected) in records[0]["last_text"]

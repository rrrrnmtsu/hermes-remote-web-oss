+"""Strict local document decoder/storage; no agent, provider, credentials or network."""
+import base64
+import hashlib
+import io
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+from tui_gateway import prompt_document_turn as documents
+
+
+@pytest.fixture(autouse=True)
+def bounded_pdf_dependency():
+    # A fixed wheel is installed in an isolated test target, never the running Hermes environment.
+    site = Path(__file__).resolve().parents[2] / "output" / "pypdf-site"
+    if site.is_dir():
+        sys.path.insert(0, str(site))
+    try:
+        import pypdf
+        assert pypdf.__version__ == "6.19.0"
+        yield
+    finally:
+        if site.is_dir():
+            sys.path.remove(str(site))
+
+
+def payload(data=b"Synthetic UTF-8 source\n", name="source.txt"):
+    return {"filename": name, "content_base64": base64.b64encode(data).decode("ascii")}
+
+
+def pdf_bytes(text="SYNTHETIC PDF TEXT", pages=1, encrypted=False):
+    from pypdf import PdfWriter
+    from pypdf.generic import DictionaryObject, NameObject, DecodedStreamObject
+    writer = PdfWriter()
+    for _ in range(pages):
+        page = writer.add_blank_page(300, 300)
+        font = writer._add_object(DictionaryObject({NameObject("/Type"): NameObject("/Font"),
+            NameObject("/Subtype"): NameObject("/Type1"), NameObject("/BaseFont"): NameObject("/Helvetica")}))
+        page[NameObject("/Resources")] = DictionaryObject({NameObject("/Font"): DictionaryObject({NameObject("/F1"): font})})
+        stream = DecodedStreamObject()
+        stream.set_data(("BT /F1 12 Tf 10 20 Td (" + text + ") Tj ET").encode())
+        page[NameObject("/Contents")] = writer._add_object(stream)
+    if encrypted:
+        writer.encrypt("DEMO-synthetic-encryption")
+    output = io.BytesIO()
+    writer.write(output)
+    return output.getvalue()
+
+
+@pytest.mark.parametrize("extension,fmt", [("txt", "TXT"), ("md", "MARKDOWN"), ("csv", "CSV")])
+def test_utf8_japanese_and_untrusted_source_stay_user_context(extension, fmt):
+    data = "日本語資料\n@/never-read-server-file\n# 見出し\n<script>untrusted text</script>\n".encode()
+    doc = documents.validate(payload(data, "資料." + extension), "この資料を確認してください。")
+    assert doc["format"] == fmt and doc["text"] == data.decode()
+    context = documents.context("処理済み本文", doc)
+    assert "処理済み本文" in context and "@/never-read-server-file" in context
+    assert "資料." not in context  # The source name is not model context or a server path.
+
+
+def test_pdf_uses_actual_bounded_decoder_and_retains_original():
+    source = pdf_bytes()
+    doc = documents.validate(payload(source, "synthetic.pdf"), "PDF資料の日本語説明です。")
+    assert doc["data"] == source and doc["pages"] == 1 and doc["format"] == "PDF"
+    assert "SYNTHETIC PDF TEXT" in doc["text"] and doc["extraction"] == "pdf_text"
+
+
+@pytest.mark.parametrize("data,name", [
+    (b"", "empty.txt"), (b"\xff\xfe", "utf16.txt"), (b"text\x00null", "nul.csv"),
+    (b"<html>disguised</html>", "fake.md"), (b"<svg/>", "fake.txt"), (b"%PDF-1.7\n%%EOF", "fake.txt"),
+    (b"GIF89a", "fake.md"), (b"PK\x03\x04zip", "fake.csv"), (b"data", "unsafe.html"),
+    (b"data", "../escape.md"), (b"data", "bad\\path.txt"), (b"data", "bad\nname.md"),
+    (b"data", "a" * 121 + ".txt"), (b"\x01control", "control.md"),
+])
+def test_invalid_data_rejected_without_any_storage(data, name, tmp_path):
+    before = set(tmp_path.rglob("*"))
+    with pytest.raises(documents.DocumentTurnError):
+        documents.validate(payload(data, name), "合成本文")
+    assert set(tmp_path.rglob("*")) == before
+
+
+@pytest.mark.parametrize("case", ["encoded", "raw", "text", "caption", "caption_empty", "extra", "base64", "frame"])
+def test_explicit_transport_extraction_and_caption_bounds(case, monkeypatch):
+    item = payload(); caption = "合成本文"
+    if case == "encoded":
+        item["content_base64"] = "A" * (4 * ((documents.RAW_LIMIT + 2) // 3) + 1)
+        monkeypatch.setattr(base64, "b64decode", lambda *args, **kwargs: pytest.fail("Oversized encoded data must never decode"))
+    if case == "raw": item = payload(b"x" * (documents.RAW_LIMIT + 1))
+    if case == "text": item = payload(b"x" * (documents.EXTRACTED_LIMIT + 1))
+    if case == "caption": caption = "あ" * 22000
+    if case == "caption_empty": caption = " "
+    if case == "extra": item["attachment_id"] = "foreign-original"
+    if case == "base64": item["content_base64"] = "not-valid!"
+    if case == "frame": monkeypatch.setattr(documents, "FRAME_LIMIT", documents.ENVELOPE_RESERVE + 2)
+    with pytest.raises(documents.DocumentTurnError): documents.validate(item, caption)
+
+
+@pytest.mark.parametrize("case,message", [("encrypted", "Encrypted"), ("pages", "20-page"),
+    ("broken", "broken"), ("empty", "No PDF text"), ("text", "128 KiB")])
+def test_pdf_rejects_unsafe_or_unsupported_input_with_explanation(case, message):
+    if case == "encrypted": data = pdf_bytes(encrypted=True)
+    elif case == "pages": data = pdf_bytes(pages=documents.MAX_PAGES + 1)
+    elif case == "broken": data = b"%PDF-1.7\nbroken\n%%EOF"
+    elif case == "empty": data = pdf_bytes(text="")
+    else: data = pdf_bytes(text="A" * (documents.EXTRACTED_LIMIT + 1))
+    with pytest.raises(documents.DocumentTurnError, match=message): documents.validate(payload(data, "source.pdf"), "本文")
+
+
+def test_pdf_worker_timeout_fails_closed(monkeypatch):
+    def timeout(*args, **kwargs): raise subprocess.TimeoutExpired("bounded-pdf-child", 8)
+    monkeypatch.setattr(subprocess, "run", timeout)
+    with pytest.raises(documents.DocumentTurnError, match="time limit"):
+        documents.validate(payload(pdf_bytes(), "source.pdf"), "本文")
+
+
+def test_pdf_decompressed_stream_is_bounded():
+    from pypdf import PdfWriter
+    from pypdf.generic import NameObject, DecodedStreamObject
+    writer = PdfWriter(); page = writer.add_blank_page(300, 300)
+    stream = DecodedStreamObject(); stream.set_data(b" " * (documents.PDF_STREAM_LIMIT + 1024))
+    page[NameObject("/Contents")] = writer._add_object(stream.flate_encode())
+    output = io.BytesIO(); writer.write(output)
+    with pytest.raises(documents.DocumentTurnError): documents.validate(payload(output.getvalue(), "bomb.pdf"), "本文")
+
+
+def test_originals_create_only_and_session_private_with_combined_quota(tmp_path, monkeypatch):
+    doc = documents.validate(payload("合成資料".encode()), "本文")
+    roots = tmp_path / "documents", tmp_path / "images"
+    first, receipt = documents.store({"session_key": "durable-a"}, "live-a", doc, *roots)
+    second, other = documents.store({"session_key": "durable-b"}, "live-b", doc, *roots)
+    third, _ = documents.store({"session_key": "durable-a"}, "live-a", doc, *roots)
+    assert first != second != third and first.parent == third.parent != second.parent
+    assert first.read_bytes() == doc["data"] and first.stat().st_mode & 0o777 == 0o600
+    assert first.parent.stat().st_mode & 0o777 == 0o700
+    assert receipt["receipt_id"] != other["receipt_id"] and receipt["truncated"] is False
+    image_dir = roots[1] / "turn-uploads" / hashlib.sha256(b"durable-a").hexdigest()
+    image_dir.mkdir(parents=True); (image_dir / "existing.png").write_bytes(b"keep-original")
+    monkeypatch.setattr(documents, "SESSION_STORAGE_LIMIT", documents.stored_session_bytes({"session_key": "durable-a"}, "live-a", *roots))
+    snapshot = set(tmp_path.rglob("*"))
+    with pytest.raises(documents.DocumentTurnError, match="50 MiB"):
+        documents.store({"session_key": "durable-a"}, "live-a", doc, *roots)
+    assert snapshot == set(tmp_path.rglob("*")) and (image_dir / "existing.png").read_bytes() == b"keep-original"
+
+
+def test_symlink_storage_is_refused_without_touching_other_files(tmp_path):
+    outside = tmp_path / "outside"; outside.mkdir()
+    (outside / "keep.md").write_text("original")
+    root = tmp_path / "documents"; root.symlink_to(outside, target_is_directory=True)
+    doc = documents.validate(payload(), "本文")
+    with pytest.raises(documents.DocumentTurnError, match="symlink"):
+        documents.store({"session_key": "a"}, "live", doc, root)
+    assert list(outside.iterdir()) == [outside / "keep.md"]
+
+
+def test_capabilities_do_not_claim_generation_or_relax_text_pilot():
+    config = {"model": {"provider": "anthropic", "default": "DEMO-model"}, "agent": {}}
+    cap = documents.capabilities({}, config)
+    assert cap["enabled"] and cap["generation_verified"] is False and cap["extraction"] == "text_only"
+    assert cap["max_raw_bytes"] == 5984256 and cap["max_pages"] == 20
+    config["agent"]["text_pilot"] = {"model": "DEMO-model"}
+    assert documents.capabilities({}, config)["reason"] == "text_pilot"

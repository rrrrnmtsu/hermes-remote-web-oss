+@pytest.mark.parametrize("failure", ["handler_error", "readback_mismatch"])
+def test_nested_failure_restores_home_and_never_recreates(project_gateway, monkeypatch, failure):
+    from hermes_constants import get_hermes_home
+
+    server, records, rpc, home, worker, _, project_ids = project_gateway
+    original = server._methods["session.create"]
+    calls = []
+
+    def fault(rid, params):
+        calls.append(params)
+        assert get_hermes_home() == worker
+        if failure == "handler_error":
+            raise OSError("Synthetic unavailable destination")
+        response = original(rid, params)
+        response["result"]["info"]["project"] = {"id": "DEMO-other-project"}
+        return response

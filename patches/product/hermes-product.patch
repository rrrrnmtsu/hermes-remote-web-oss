+@pytest.fixture
+def browser_subscription():
+    private = ec.generate_private_key(ec.SECP256R1())
+    public = private.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
+    auth = b"synthetic-auth!!"
+    # This fixture is exactly 16 bytes, independent of environment credentials.
+    auth = (auth + b"0" * 16)[:16]
+    encoded = lambda value: base64.urlsafe_b64encode(value).rstrip(b"=").decode()
+    return {"endpoint": "https://web.push.apple.com/synthetic-notification-1", "expirationTime": None,
+            "keys": {"p256dh": encoded(public), "auth": encoded(auth)}}, private, auth
+

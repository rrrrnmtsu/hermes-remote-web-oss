+def test_templates_owner_version_quota_and_readback(store):
+    with metadata_connection(store.db_path) as conn:
+        item = template_put(conn, "DEMO:alice", {"name": " 日本語 ", "category": " 調査 ", "body": "合成の本文\n改行"})["template"]
+        assert item["name"] == "日本語" and templates_list(conn, "DEMO:bob")["templates"] == []
+        assert templates_list(conn, "DEMO:alice")["templates"] == [item]
+        update = {"id": item["id"], "expected_version": item["version"], "name": "更新", "category": "", "body": "新本文"}
+        changed = template_put(conn, "DEMO:alice", update)["template"]
+        assert changed["version"] == item["version"] + 1
+        with pytest.raises(RemoteConversationError): template_remove(conn, "DEMO:alice", {"id": item["id"], "expected_version": 1})
+        conn.rollback()
+        with pytest.raises(RemoteConversationError): template_remove(conn, "DEMO:bob", {"id": item["id"], "expected_version": 2})
+        conn.rollback()
+        template_remove(conn, "DEMO:alice", {"id": item["id"], "expected_version": 2})
+        for i in range(50): template_put(conn, "DEMO:alice", {"name": str(i), "body": "synthetic", "category": ""})
+        with pytest.raises(RemoteConversationError) as exc: template_put(conn, "DEMO:alice", {"name": "51", "body": "synthetic"})
+        assert exc.value.code == 4429
+    assert len(store.get_messages("a")) == 2
+    with metadata_connection(store.db_path) as conn: assert len(templates_list(conn, "DEMO:alice")["templates"]) == 50

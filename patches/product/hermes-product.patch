+"""Opt-in, owner/profile/durable-session scoped Web Push. No transcript or provider calls."""
+from __future__ import annotations
+
+import base64
+import contextlib
+import fcntl
+import hashlib
+import http.client
+import ipaddress
+import json
+import math
+import os
+from pathlib import Path
+import socket
+import ssl
+import stat
+import threading
+import time
+from types import SimpleNamespace
+from urllib.parse import urlsplit
+import uuid
+
+PUSH_HOSTS = frozenset({"web.push.apple.com", "updates.push.services.mozilla.com", "fcm.googleapis.com"})
+SUBSCRIPTION_TTL = 30 * 24 * 60 * 60
+MAX_SUBSCRIPTIONS = 256
+MAX_OWNER_SUBSCRIPTIONS = 8
+MAX_STATE_BYTES = 1024 * 1024
+MAX_OUTBOX = 64
+OUTBOX_TTL = 3600
+MAX_PENDING_DISPATCH = 2
+_dispatch_slots = threading.BoundedSemaphore(MAX_PENDING_DISPATCH)
+
+
+class NotificationError(ValueError):
+    def __init__(self, code: int, message: str):
+        super().__init__(message)
+        self.code = code
+
+
+class _WaitingNotificationWithdrawn(Exception):
+    """Consent or a scoped request was withdrawn at the final HTTP send boundary."""
+
+
+def _valid_waiting_ref(reference) -> bool:
+    if not isinstance(reference, dict) or set(reference) != {"epoch", "id", "method", "session_id"}:
+        return False
+    request_id = reference["id"]
+    valid_id = ((isinstance(request_id, str) and 1 <= len(request_id) <= 256)
+                or (type(request_id) in (int, float) and abs(request_id) <= 2 ** 53 and math.isfinite(request_id)))
+    return (valid_id and reference["method"] in ("approval", "clarify")
+            and isinstance(reference["epoch"], str) and 1 <= len(reference["epoch"]) <= 128
+            and isinstance(reference["session_id"], str) and 1 <= len(reference["session_id"]) <= 256)
+
+
+def _waiting_request_current(server, home: Path, subscription: dict, reference: dict) -> bool:
+    """Use authoritative requests and session scope; missing/restarted state fails closed."""
+    try:
+        if not _valid_waiting_ref(reference):
+            return False
+        from tui_gateway.event_replay import replay_epoch
+        if reference["epoch"] != replay_epoch():
+            return False
+        sid = reference["session_id"]
+        with server._sessions_lock:
+            session = dict(server._sessions.get(sid) or {})
+        if (not session or (server._session_auth_user_id(session) or "local-owner") != subscription["owner"]
+                or session.get("session_key") != subscription["session_id"]
+                or Path(session.get("profile_home") or server._hermes_home).resolve() != Path(home).resolve()):
+            return False
+        for request in server._open_requests(sid):
+            if (type(request.get("id")) is type(reference["id"]) and request.get("id") == reference["id"]
+                    and request.get("method") == reference["method"]
+                    and (request.get("params") or {}).get("session_id") == sid):
+                return True
+    except Exception:
+        return False
+    return False
+
+
+def checked_endpoint(endpoint: str, resolver=None) -> tuple[str, list[tuple]]:
+    if not isinstance(endpoint, str) or not 8 <= len(endpoint) <= 2048 or any(ord(c) <= 32 or c == "\\" for c in endpoint):
+        raise NotificationError(4400, "invalid push endpoint")
+    try:
+        url = urlsplit(endpoint)
+        if (url.scheme != "https" or url.hostname not in PUSH_HOSTS or url.username or url.password
+                or url.port not in (None, 443) or url.query or url.fragment or not url.path.startswith("/")
+                or len(url.path) < 4 or ".." in url.path):
+            raise ValueError
+    except ValueError:
+        raise NotificationError(4400, "unsupported push endpoint") from None
+    try:
+        addresses = (resolver or socket.getaddrinfo)(url.hostname, 443, type=socket.SOCK_STREAM)
+        if not addresses or len(addresses) > 32 or any(not ipaddress.ip_address(row[4][0]).is_global for row in addresses):
+            raise ValueError
+    except (OSError, ValueError, IndexError):
+        raise NotificationError(4503, "push service address unavailable") from None
+    return endpoint, addresses
+
+
+def _base64_bytes(value, length: int) -> bytes:
+    if not isinstance(value, str) or len(value) > 128:
+        raise NotificationError(4400, "invalid push public key")
+    try:
+        decoded = base64.b64decode(value + "=" * (-len(value) % 4), altchars=b"-_", validate=True)
+        if len(decoded) != length:
+            raise ValueError
+        return decoded
+    except (ValueError, TypeError):
+        raise NotificationError(4400, "invalid push public key") from None
+
+
+def checked_subscription(value: dict, resolver=None) -> dict:
+    if not isinstance(value, dict) or set(value) - {"endpoint", "expirationTime", "keys"}:
+        raise NotificationError(4400, "invalid push subscription")
+    endpoint, _ = checked_endpoint(value.get("endpoint"), resolver)
+    keys = value.get("keys")
+    if not isinstance(keys, dict) or set(keys) != {"p256dh", "auth"}:
+        raise NotificationError(4400, "invalid push subscription keys")
+    public = _base64_bytes(keys["p256dh"], 65)
+    _base64_bytes(keys["auth"], 16)
+    try:
+        from cryptography.hazmat.primitives.asymmetric import ec
+        ec.EllipticCurvePublicKey.from_encoded_point(ec.SECP256R1(), public)
+    except ValueError:
+        raise NotificationError(4400, "invalid push public key") from None
+    expiry = value.get("expirationTime")
+    if expiry is not None and (type(expiry) not in (int, float) or not math.isfinite(expiry) or expiry <= 0 or expiry > 10**15):
+        raise NotificationError(4400, "invalid push expiry")
+    return {"endpoint": endpoint, "expirationTime": expiry, "keys": {"p256dh": keys["p256dh"], "auth": keys["auth"]}}
+
+
+class NotificationStore:
+    """Small 0600 metadata/outbox, separate from canonical history; no new daemon."""
+    def __init__(self, home: Path, *, now=time.time):
+        self.home = Path(home)
+        self.directory = self.home / "remote-web"
+        self.now = now
+
+    def _private_directory(self):
+        if not self.home.is_dir() or self.directory.is_symlink():
+            raise NotificationError(4503, "notification store unavailable")
+        self.directory.mkdir(mode=0o700, exist_ok=True)
+        details = self.directory.stat()
+        if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.geteuid() or details.st_mode & 0o077:
+            raise NotificationError(4503, "notification store permissions unavailable")
+
+    @contextlib.contextmanager
+    def transaction(self):
+        self._private_directory()
+        path = self.directory / "push-subscriptions.json"
+        lock_fd = os.open(self.directory / "push.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
+        try:
+            lock_stat = os.fstat(lock_fd)
+            if not stat.S_ISREG(lock_stat.st_mode) or lock_stat.st_uid != os.geteuid() or lock_stat.st_mode & 0o077:
+                raise NotificationError(4503, "notification store permissions unavailable")
+            fcntl.flock(lock_fd, fcntl.LOCK_EX)
+            try:
+                fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+            except FileNotFoundError:
+                contents = {"version": 1, "subscriptions": [], "outbox": [], "seen": []}
+            else:
+                with os.fdopen(fd, "r", encoding="utf-8") as stream:
+                    details = os.fstat(stream.fileno())
+                    if not stat.S_ISREG(details.st_mode) or details.st_uid != os.geteuid() or details.st_mode & 0o077 or details.st_size > MAX_STATE_BYTES:
+                        raise NotificationError(4503, "notification store permissions unavailable")
+                    try:
+                        contents = json.load(stream)
+                    except (ValueError, OSError):
+                        raise NotificationError(4503, "notification store unreadable") from None
+            if (not isinstance(contents, dict) or contents.get("version") != 1
+                    or not all(isinstance(contents.get(name), list) for name in ("subscriptions", "outbox", "seen"))
+                    or len(contents["subscriptions"]) > MAX_SUBSCRIPTIONS or len(contents["outbox"]) > MAX_OUTBOX or len(contents["seen"]) > 128):
+                raise NotificationError(4503, "notification store invalid")
+            now = self.now()
+            contents["subscriptions"] = [item for item in contents["subscriptions"] if item["expires_at"] > now]
+            contents["outbox"] = [item for item in contents["outbox"] if item["expires_at"] > now and item["attempts"] < 2]
+            yield contents
+            encoded = json.dumps(contents, separators=(",", ":")).encode()
+            if len(encoded) > MAX_STATE_BYTES:
+                raise NotificationError(4503, "notification metadata quota exceeded")
+            temporary = self.directory / (".push-" + uuid.uuid4().hex)
+            try:
+                temporary_fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+                with os.fdopen(temporary_fd, "wb") as stream:
+                    stream.write(encoded)
+                    stream.flush()
+                    os.fsync(stream.fileno())
+                os.replace(temporary, path)
+            finally:
+                with contextlib.suppress(FileNotFoundError):
+                    temporary.unlink()
+        finally:
+            os.close(lock_fd)
+
+    def list(self, owner: str, session_id: str | None = None) -> list[dict]:
+        path = self.directory / "push-subscriptions.json"
+        if path.is_symlink():
+            raise NotificationError(4503, "notification store unavailable")
+        if not path.exists():
+            return []
+        with self.transaction() as contents:
+            return [_public(item) for item in contents["subscriptions"] if item["owner"] == owner and (session_id is None or item["session_id"] == session_id)]
+
+    def subscribe(self, owner: str, session_id: str, subscription: dict, *, resolver=None) -> dict:
+        checked = checked_subscription(subscription, resolver)
+        now = self.now()
+        expires = min(now + SUBSCRIPTION_TTL, (checked["expirationTime"] / 1000) if checked["expirationTime"] is not None else now + SUBSCRIPTION_TTL)
+        if expires <= now:
+            raise NotificationError(4400, "push subscription expired")
+        fingerprint = hashlib.sha256(checked["endpoint"].encode()).hexdigest()
+        with self.transaction() as contents:
+            match = next((item for item in contents["subscriptions"] if item["owner"] == owner and item["session_id"] == session_id and item["fingerprint"] == fingerprint), None)
+            if match is None and (len(contents["subscriptions"]) >= MAX_SUBSCRIPTIONS or sum(item["owner"] == owner for item in contents["subscriptions"]) >= MAX_OWNER_SUBSCRIPTIONS):
+                raise NotificationError(4400, "push subscription limit reached")
+            if any(item["fingerprint"] == fingerprint and item["owner"] != owner for item in contents["subscriptions"]):
+                raise NotificationError(4403, "push subscription belongs to another owner")
+            item = {"id": match["id"] if match else uuid.uuid4().hex, "owner": owner, "session_id": session_id,
+                    "fingerprint": fingerprint, "subscription": checked, "expires_at": expires, "last_status": "registered"}
+            contents["subscriptions"] = [old for old in contents["subscriptions"] if old["id"] != item["id"]] + [item]
+            return _public(item)
+
+    def unsubscribe(self, owner: str, subscription_id: str | None) -> int:
+        with self.transaction() as contents:
+            selected = {item["id"] for item in contents["subscriptions"] if item["owner"] == owner and (subscription_id is None or item["id"] == subscription_id)}
+            contents["subscriptions"] = [item for item in contents["subscriptions"] if item["id"] not in selected]
+            contents["outbox"] = [item for item in contents["outbox"] if item["subscription_id"] not in selected]
+            return len(selected)
+
+    def enqueue(self, owner: str, session_id: str, kind: str, event_key: str, *, request_ref=None) -> None:
+        if kind not in ("result", "waiting") or (kind == "waiting" and not _valid_waiting_ref(request_ref)):
+            return
+        with self.transaction() as contents:
+            dedupe = hashlib.sha256(f"{owner}\n{session_id}\n{kind}\n{event_key}".encode()).hexdigest()
+            if dedupe in contents["seen"]:
+                return
+            contents["seen"] = (contents["seen"] + [dedupe])[-128:]
+            subscriptions = [item for item in contents["subscriptions"] if item["owner"] == owner and item["session_id"] == session_id]
+            for subscription in subscriptions:
+                if len(contents["outbox"]) >= MAX_OUTBOX:
+                    break
+                job = {"id": uuid.uuid4().hex, "subscription_id": subscription["id"], "kind": kind,
+                       "expires_at": self.now() + OUTBOX_TTL, "attempts": 0}
+                if kind == "waiting":
+                    job["request_ref"] = dict(request_ref)
+                contents["outbox"].append(job)
+
+    def deliver(self, send=None, *, eligible=None) -> None:
+        if send is None:
+            send = lambda subscription, kind, **kwargs: send_web_push(self.home, subscription, kind, **kwargs)
+        def wanted(job, subscription):
+            if job.get("kind") != "waiting":
+                return True
+            try:
+                reference = job.get("request_ref")
+                return _valid_waiting_ref(reference) and eligible is not None and eligible(reference, subscription) is True
+            except Exception:
+                return False
+        def still_authorized(job, subscription):
+            if not wanted(job, subscription):
+                return False
+            try:
+                with self.transaction() as contents:
+                    current = next((item for item in contents["outbox"] if item["id"] == job["id"]), None)
+                    consent = next((item for item in contents["subscriptions"] if item["id"] == subscription["id"]), None)
+                    return (current is not None and current.get("claimed") is True and current == job
+                            and current["expires_at"] > self.now() and consent is not None
+                            and consent["expires_at"] > self.now()
+                            and all(consent.get(name) == subscription.get(name) for name in
+                                    ("id", "owner", "session_id", "fingerprint", "subscription", "expires_at"))
+                            and (job["kind"] != "waiting" or
+                                 type(current["request_ref"]["id"]) is type(job["request_ref"]["id"])))
+            except Exception:
+                return False
+        # Each item is claimed once under the lock; simultaneous drains cannot duplicate it.
+        with self.transaction() as contents:
+            jobs = []
+            for job in list(contents["outbox"][:8]):
+                if job.get("claimed"):
+                    continue
+                subscription = next((item for item in contents["subscriptions"] if item["id"] == job["subscription_id"]), None)
+                if subscription:
+                    if not wanted(job, subscription):
+                        contents["outbox"].remove(job)
+                        continue
+                    job["attempts"] += 1
+                    job["claimed"] = True
+                    jobs.append((dict(job), dict(subscription)))
+                    subscription["last_status"] = "delivery_unknown"
+        for job, subscription in jobs:
+            try:
+                if not still_authorized(job, subscription):
+                    outcome = "withdrawn"
+                else:
+                    # Re-read consent/claim after SDK encryption for either kind,
+                    # immediately before its HTTP post. Started HTTPS is not retractable.
+                    outcome = send(subscription["subscription"], job["kind"],
+                                   should_deliver=lambda: still_authorized(job, subscription))
+            except Exception:
+                outcome = "delivery_unknown"
+            with self.transaction() as contents:
+                current = next((item for item in contents["outbox"] if item["id"] == job["id"]), None)
+                if outcome in ("sent", "expired", "withdrawn") or job["attempts"] >= 2:
+                    contents["outbox"] = [item for item in contents["outbox"] if item["id"] != job["id"]]
+                elif current and outcome != "delivery_unknown":
+                    current["claimed"] = False
+                if outcome == "expired":
+                    contents["subscriptions"] = [item for item in contents["subscriptions"] if item["id"] != subscription["id"]]
+                elif outcome != "withdrawn":
+                    for item in contents["subscriptions"]:
+                        if item["id"] == subscription["id"]:
+                            item["last_status"] = outcome
+                else:
+                    for item in contents["subscriptions"]:
+                        if item["id"] == subscription["id"]:
+                            item["last_status"] = subscription["last_status"]
+
+
+def _public(item):
+    return {"id": item["id"], "session_id": item["session_id"], "endpoint_fingerprint": item["fingerprint"],
+            "expires_at": item["expires_at"], "last_status": item["last_status"]}
+
+
+def _private_vapid_key(home: Path):
+    path = Path(home) / "remote-web" / "vapid-private.pem"
+    if not path.is_file() or path.is_symlink():
+        return None
+    from cryptography.hazmat.primitives import serialization
+    from cryptography.hazmat.primitives.asymmetric import ec
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+        with os.fdopen(fd, "rb") as stream:
+            details = os.fstat(stream.fileno())
+            if not stat.S_ISREG(details.st_mode) or details.st_uid != os.geteuid() or details.st_mode & 0o077 or details.st_size > 4096:
+                return None
+            key = serialization.load_pem_private_key(stream.read(4096), password=None)
+        if not isinstance(key, ec.EllipticCurvePrivateKey) or not isinstance(key.curve, ec.SECP256R1):
+            return None
+        return key
+    except (ValueError, OSError):
+        return None
+
+
+def vapid_public_key(home: Path) -> str | None:
+    from cryptography.hazmat.primitives import serialization
+    key = _private_vapid_key(home)
+    if key is None:
+        return None
+    data = key.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
+    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()
+
+
+def _valid_push_contact(value) -> bool:
+    if not isinstance(value, str) or not 8 <= len(value) <= 512 or any(ord(c) <= 32 or c == "\\" for c in value):
+        return False
+    try:
+        parsed = urlsplit(value)
+        return parsed.scheme == "https" and bool(parsed.hostname) and not (parsed.username or parsed.password or parsed.query or parsed.fragment) and (parsed.port is None or 1 <= parsed.port <= 65535)
+    except ValueError:
+        return False
+
+
+def vapid_subject(home: Path) -> str | None:
+    path = Path(home) / "remote-web" / "push-contact.json"
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+        with os.fdopen(fd, "r", encoding="utf-8") as stream:
+            details = os.fstat(stream.fileno())
+            if not stat.S_ISREG(details.st_mode) or details.st_uid != os.geteuid() or details.st_mode & 0o077 or details.st_size > 2048:
+                return None
+            value = json.load(stream).get("subject")
+        return value if _valid_push_contact(value) else None
+    except (OSError, ValueError, TypeError, AttributeError):
+        return None
+
+
+def ensure_vapid_key(home: Path, *, subject: str | None = None) -> str:
+    """Create-only app key. Deployment owner invokes this; status reads never create keys."""
+    store = NotificationStore(home)
+    store._private_directory()
+    if subject is not None:
+        if not _valid_push_contact(subject):
+            raise NotificationError(4400, "invalid application push contact")
+        contact = store.directory / "push-contact.json"
+        if contact.exists():
+            if vapid_subject(home) != subject:
+                raise NotificationError(4503, "application push contact already configured")
+        else:
+            fd = os.open(contact, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+            with os.fdopen(fd, "w", encoding="utf-8") as stream:
+                json.dump({"subject": subject}, stream)
+    path = store.directory / "vapid-private.pem"
+    if path.exists():
+        result = vapid_public_key(home)
+        if result is None:
+            raise NotificationError(4503, "application push key unavailable")
+        return result
+    from cryptography.hazmat.primitives import serialization
+    from cryptography.hazmat.primitives.asymmetric import ec
+    key = ec.generate_private_key(ec.SECP256R1())
+    data = key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(fd, "wb") as stream:
+        stream.write(data)
+        stream.flush()
+        os.fsync(stream.fileno())
+    return vapid_public_key(home)
+
+
+class _PinnedHTTPSConnection(http.client.HTTPSConnection):
+    def __init__(self, host, address, timeout):
+        super().__init__(host, port=443, timeout=timeout, context=ssl.create_default_context())
+        self._public_address = address
+
+    def connect(self):
+        family, _, _, _, address = self._public_address
+        raw = socket.socket(family, socket.SOCK_STREAM)
+        raw.settimeout(self.timeout)
+        try:
+            raw.connect(address)
+            self.sock = self._context.wrap_socket(raw, server_hostname=self.host)
+        except BaseException:
+            raw.close()
+            raise
+
+
+class SafePushSession:
+    """pywebpush's HTTP seam: DNS-pinned TLS, no proxies, redirects, body logging or retries."""
+    def __init__(self, *, resolver=None, connection_factory=_PinnedHTTPSConnection):
+        self.resolver = resolver
+        self.connection_factory = connection_factory
+
+    def post(self, endpoint, *, data=None, headers=None, timeout=None, **kwargs):
+        checked, addresses = checked_endpoint(endpoint, self.resolver)
+        if kwargs or not isinstance(data, bytes) or len(data) > 4096:
+            raise NotificationError(4400, "invalid push request")
+        headers = headers or {}
+        if sum(len(str(name)) + len(str(value)) for name, value in headers.items()) > 16 * 1024 or any("\r" in str(value) or "\n" in str(value) for value in headers.values()):
+            raise NotificationError(4400, "invalid push headers")
+        url = urlsplit(checked)
+        connection = self.connection_factory(url.hostname, addresses[0], min(float(timeout or 5), 5))
+        try:
+            connection.request("POST", url.path, body=data, headers=headers)
+            response = connection.getresponse()
+            # No response body is needed or logged; redirects are a failed notification.
+            return SimpleNamespace(status_code=response.status, reason="push response", text="", headers={})
+        finally:
+            connection.close()
+
+
+def send_web_push(home: Path, subscription: dict, kind: str, *, session=None, webpush=None,
+                  should_deliver=None) -> str:
+    subject = vapid_subject(home)
+    private_key = _private_vapid_key(home)
+    if kind not in ("result", "waiting") or private_key is None or subject is None:
+        return "unavailable"
+    if webpush is None:
+        from pywebpush import webpush
+    from py_vapid import Vapid
+    # 1.9.4 rejects RFC-valid HTTPS contact paths/ports. Our contact validator above
+    # retains HTTPS/userinfo/control restrictions; SDK audience/signature checks remain.
+    # Passing a key object also avoids SDK from_file's missing-key auto-generation.
+    signer = Vapid(private_key, conf={"no-strict": True})
+    if session is None:
+        session = SafePushSession()
+    started = False
+
+    class ObservedSession:
+        def post(self, *args, **kwargs):
+            nonlocal started
+            if should_deliver is not None and should_deliver() is not True:
+                raise _WaitingNotificationWithdrawn()
+            started = True
+            return session.post(*args, **kwargs)
+
+    try:
+        response = webpush(subscription_info=subscription, data=json.dumps({"kind": kind}, separators=(",", ":")),
+                           vapid_private_key=signer,
+                           vapid_claims={"sub": subject}, ttl=300, timeout=5,
+                           requests_session=ObservedSession(), verbose=False)
+        return "sent" if response.status_code in (200, 201, 202) else "failed"
+    except _WaitingNotificationWithdrawn:
+        return "withdrawn"
+    except Exception as error:
+        response = getattr(error, "response", None)
+        if response is not None:
+            return "expired" if getattr(response, "status_code", None) in (404, 410) else "failed"
+        return "delivery_unknown" if started else "failed"
+
+
+def attach_remote_notification_hooks(server):
+    """Observe real gateway frames without changing their return value or failure semantics."""
+    if getattr(server, "_remote_notification_hooks_attached", False):
+        return
+    original = server.write_json
+
+    def observed(frame):
+        result = original(frame)
+        try:
+            params = frame.get("params") if isinstance(frame, dict) else None
+            if not isinstance(params, dict):
+                return result
+            kind = "result" if frame.get("method") == "event" and params.get("type") == "message.complete" else \
+                "waiting" if frame.get("method") in ("approval", "clarify") and "id" in frame else None
+            if kind is None:
+                return result
+            sid = params.get("session_id")
+            with server._sessions_lock:
+                current = dict(server._sessions.get(sid) or {})
+            durable = str(current.get("session_key") or "")
+            home = Path(current.get("profile_home") or server._hermes_home)
+            owner = server._session_auth_user_id(current) or "local-owner"
+            if not durable or not home.is_dir() or not _dispatch_slots.acquire(blocking=False):
+                return result
+            from tui_gateway.event_replay import replay_epoch
+            event_id = frame.get("id") if "id" in frame else params.get("seq")
+            epoch = replay_epoch()
+            request_ref = {"epoch": epoch, "id": event_id, "method": frame.get("method"), "session_id": sid} if kind == "waiting" else None
+            identity = json.dumps([type(event_id).__name__, event_id], separators=(",", ":")) if kind == "waiting" else str(
+                event_id if event_id is not None else current.get("inflight_turn_id") or uuid.uuid4().hex)
+            key = epoch + ":" + identity
+
+            def notify():
+                try:
+                    store = NotificationStore(home)
+                    # No opted-in subscription => no external request or key creation.
+                    if store.list(owner, durable):
+                        eligible = lambda reference, subscription: _waiting_request_current(server, home, subscription, reference)
+                        if kind != "waiting" or eligible(request_ref, {"owner": owner, "session_id": durable}):
+                            store.enqueue(owner, durable, kind, key, request_ref=request_ref)
+                        store.deliver(lambda subscription, kind, **kwargs: send_web_push(
+                            Path(server._hermes_home), subscription, kind, **kwargs), eligible=eligible)
+                except Exception:
+                    pass  # Push is best-effort; never expose endpoint/key/turn bodies in logs.
+
+            try:
+                future = server._pool.submit(notify)
+                future.add_done_callback(lambda _future: _dispatch_slots.release())
+            except Exception:
+                _dispatch_slots.release()
+        except Exception:
+            pass
+        return result
+
+    server.write_json = observed
+    server._remote_notification_hooks_attached = True

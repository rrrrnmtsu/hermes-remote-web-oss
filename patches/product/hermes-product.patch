+"""Remote Web opt-in notification metadata handlers. Shared registration remains in server.py."""
+from __future__ import annotations
+
+from .method_ctx import HandlerRegistry, bind_module
+
+_registry = HandlerRegistry()
+method = _registry.method
+
+
+def remote_notification_handler(name):
+    def decorate(fn):
+        @method(name)
+        @_registry.profile_scoped
+        def handler(rid, params):
+            from pathlib import Path
+            from tui_gateway.remote_notifications import NotificationStore, NotificationError
+            owner = _transport_auth_user_id(current_transport()) or "local-owner"
+            try:
+                with _profile_db(params) as db:
+                    if db is None:
+                        return _err(rid, 4503, "session store unavailable")
+                    requested = params.get("session_id")
+                    if requested:
+                        session = db.get_session(requested)
+                        if not session or (session.get("user_id") is not None if owner == "local-owner" else session.get("user_id") != owner):
+                            return _err(rid, 4404, "owned notification session not found")
+                    store = NotificationStore(Path(db.db_path).parent)
+                    return _ok(rid, fn(params, store, owner, Path(_hermes_home)))
+            except NotificationError as error:
+                return _err(rid, error.code, str(error))
+            except Exception:
+                return _err(rid, 4503, "notification operation unavailable; refresh before retrying")
+        return handler
+    return decorate
+
+
+def remote_notification_settings(key_home):
+    import importlib.util
+    from tui_gateway.remote_notifications import vapid_public_key, vapid_subject, SUBSCRIPTION_TTL, MAX_OWNER_SUBSCRIPTIONS
+    public_key = vapid_public_key(key_home)
+    subject = vapid_subject(key_home)
+    available = public_key is not None and subject is not None and importlib.util.find_spec("pywebpush") is not None
+    reason = "ready" if available else "application_key_missing" if public_key is None else "application_contact_missing" if subject is None else "push_library_missing"
+    return {"available": available, "reason": reason, "public_key": public_key,
+            "ttl_seconds": SUBSCRIPTION_TTL, "max_subscriptions": MAX_OWNER_SUBSCRIPTIONS}
+
+
+@remote_notification_handler("remote.notifications.status")
+def remote_notification_status(params, store, owner, key_home):
+    return {**remote_notification_settings(key_home), "subscriptions": store.list(owner, params.get("session_id")),
+            "scope": "authenticated_owner_profile_session"}
+
+
+@remote_notification_handler("remote.notifications.subscribe")
+def remote_notification_subscribe(params, store, owner, key_home):
+    from tui_gateway.remote_notifications import NotificationError
+    if not remote_notification_settings(key_home)["available"]:
+        raise NotificationError(4503, "application push setup unavailable")
+    return {"subscription": store.subscribe(owner, params["session_id"], params["subscription"])}
+
+
+@remote_notification_handler("remote.notifications.unsubscribe")
+def remote_notification_unsubscribe(params, store, owner, key_home):
+    return {"removed": store.unsubscribe(owner, params["subscription_id"])}
+
+
+@remote_notification_handler("remote.notifications.unsubscribe_all")
+def remote_notification_unsubscribe_all(params, store, owner, key_home):
+    return {"removed": store.unsubscribe(owner, None)}
+
+
+def register(server):
+    bind_module(globals(), server)

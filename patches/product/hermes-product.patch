+method = _registry.method
+_profile_scoped = _registry.profile_scoped
+
+
+@method("remote.app.capabilities")
+@_profile_scoped
+def remote_app_capabilities(rid, params):
+    import hashlib
+    transport = current_transport()
+    # Legacy single-owner/stdin transport is admitted by the existing gateway auth.
+    # Modern authenticated identities keep separate metadata/encryption scopes.
+    principal = _transport_auth_user_id(transport) or "local-owner"
+    policy = _load_cfg().get("remote_web", {})
+    authorized = isinstance(policy, dict) and policy.get("generation_authorized") is True
+    return _ok(rid, {"version": 1,
+                     "principal_id": hashlib.sha256(principal.encode()).hexdigest(),
+                     "methods": sorted(name for name in _methods if name.startswith("remote.")),
+                     # Enabling paid Remote Web generation requires a separately validated
+                     # legitimate credential route and a purpose-specific budget. Metadata
+                     # features remain usable; normal/legacy profile policy is untouched.
+                     "generation_allowed": authorized,
+                     "generation_reason": "" if authorized else "正規の生成認証と費用上限が未確認のため、この更新版は非生成操作のみ利用できます。"})
+
+
+def register(server):
+    bind_module(globals(), server)
diff --git a/tui_gateway/methods_remote_conversations.py b/tui_gateway/methods_remote_conversations.py
new file mode 100644
index 0000000000000000000000000000000000000000..d7acccc1419f8d0ddcfcadfc683f1f841ac7d0ae
--- /dev/null
+++ b/tui_gateway/methods_remote_conversations.py
@@ -0,0 +1,143 @@
+"""Remote Web conversation organization, bounded browsing and non-destructive branches."""
+from __future__ import annotations
+
+from .method_ctx import HandlerRegistry, bind_module
+
+_registry = HandlerRegistry()
+method = _registry.method
+
+
+def remote_conversation_handler(name: str, *, writer: bool = False):
+    def decorate(fn):
+        @method(name)
+        @_registry.profile_scoped
+        def handler(rid, params):
+            from tui_gateway.remote_conversation_metadata import RemoteConversationError, metadata_connection
+            owner = _transport_auth_user_id(current_transport()) or "local-owner"
+            try:
+                with _profile_db(params, writer=writer) as db:
+                    if db is None:
+                        return _err(rid, 4503, "session store unavailable")
+                    with metadata_connection(db.db_path) as conn:
+                        return _ok(rid, fn(params, db, conn, owner))
+            except RemoteConversationError as exc:
+                return _err(rid, exc.code, str(exc))
+            except (ValueError, TypeError):
+                return _err(rid, 4400, "invalid conversation operation")
+            except Exception:
+                # Do not leak paths, template bodies or SQLite exception parameters.
+                return _err(rid, 4503, "conversation operation unavailable; refresh before retrying")
+        return handler
+    return decorate
+
+
+def remote_conversation_project_paths(project_id):
+    if project_id is None:
+        return None
+    from hermes_cli import projects_db as pdb
+    from tui_gateway.remote_conversation_metadata import RemoteConversationError
+    from pathlib import Path
+    if not isinstance(project_id, str) or not 1 <= len(project_id) <= 128:
+        raise RemoteConversationError(4400, "invalid registered project")
+    with pdb.connect_closing() as conn:
+        project = pdb.get_project(conn, project_id)
+        if project is None or project.archived:
+            raise RemoteConversationError(4404, "registered project not found")
+        return list(dict.fromkeys(str(Path(folder.path).resolve()) for folder in project.folders))[:32]
+
+
+@remote_conversation_handler("remote.sessions.list")
+def remote_conversation_list(params, db, conn, owner):
+    from tui_gateway.remote_conversation_metadata import list_sessions
+    return list_sessions(conn, owner, params, remote_conversation_project_paths(params.get("project_id")))
+
+
+@remote_conversation_handler("remote.session.metadata")
+def remote_conversation_read_metadata(params, db, conn, owner):
+    from tui_gateway.remote_conversation_metadata import owned_session, session_metadata
+    return {"session": session_metadata(conn, owner, owned_session(conn, owner, params.get("session_id")))}
+
+
+@remote_conversation_handler("remote.session.organize", writer=True)
+def remote_conversation_organize(params, db, conn, owner):
+    from tui_gateway.remote_conversation_metadata import organize
+    target = params.get("session_id")
+    tip = db.get_compression_tip(target) or target
+    return {"session": organize(conn, owner, params, db._resume_lineage_ids(tip))}
+
+
+@remote_conversation_handler("remote.templates.list")
+def remote_conversation_templates(params, db, conn, owner):
+    from tui_gateway.remote_conversation_metadata import templates_list
+    return templates_list(conn, owner)
+
+
+@remote_conversation_handler("remote.templates.put", writer=True)
+def remote_conversation_template_put(params, db, conn, owner):
+    from tui_gateway.remote_conversation_metadata import template_put
+    return template_put(conn, owner, params)
+
+
+@remote_conversation_handler("remote.templates.remove", writer=True)
+def remote_conversation_template_remove(params, db, conn, owner):
+    from tui_gateway.remote_conversation_metadata import template_remove
+    return template_remove(conn, owner, params)
+
+
+@remote_conversation_handler("remote.session.branch_from_row", writer=True)
+def remote_conversation_branch(params, db, conn, owner):
+    from tui_gateway.remote_conversation_metadata import RemoteConversationError, owned_session
+    import uuid
+    import json
+    target = params.get("session_id")
+    parent = owned_session(conn, owner, target)
+    row_id = params.get("row_id")
+    mode = params.get("mode", "branch")
+    if type(row_id) is not int or row_id <= 0 or mode not in {"branch", "edit", "regenerate"}:
+        raise RemoteConversationError(4400, "durable row and valid branch mode required")
+    if any(s.get("session_key") == target and s.get("running") for s in list(_sessions.values())):
+        raise RemoteConversationError(4409, "wait for the parent turn to finish before branching")
+    # Follow only the backend's verified compression lineage; explicit fork parents
+    # are not inherited a second time. Every segment still has to belong to this owner.
+    rows = []
+    for segment in db._resume_lineage_ids(target):
+        owned_session(conn, owner, segment)
+        rows.extend(db.get_messages(segment, limit=2001 - len(rows), include_compacted=True))
+        if len(rows) > 2000:
+            raise RemoteConversationError(4429, "branch source exceeds 2000 loaded rows")
+    projected = _history_to_messages([{**row, "_row_id": row["id"]} for row in rows], image_urls=False)
+    visible = [row for row in projected if row.get("role") in {"user", "assistant"} and row.get("text", "").strip()]
+    index = next((i for i, row in enumerate(visible) if row.get("row_id") == row_id), None)
+    if index is None:
+        raise RemoteConversationError(4404, "visible durable row not found in this session")
+    selected = visible[index]
+    if mode == "edit" and selected["role"] != "user" or mode == "regenerate" and selected["role"] != "assistant":
+        raise RemoteConversationError(4400, "branch mode does not match message role")
+    visible = visible[:index + 1] if mode == "branch" else visible[:index]
+    draft = ""
+    if mode == "edit":
+        draft = selected["text"]
+    elif mode == "regenerate":
+        if not visible or visible[-1]["role"] != "user":
+            raise RemoteConversationError(4409, "regeneration source has no preceding user turn")
+        draft = visible.pop()["text"]
+    if len(json.dumps(visible, ensure_ascii=False).encode()) > 2 * 1024 * 1024 or len(draft) > 65536:
+        raise RemoteConversationError(4429, "branch context or draft exceeds the bounded limit")
+    # Preserve display-only text without promoting quote text into a system instruction.
+    history = [{"role": row["role"], "content": row["text"], "timestamp": row.get("timestamp")} for row in visible]
+    new_key = uuid.uuid4().hex
+    title = ((parent.get("title") or "会話")[:150] + "・分岐-" + new_key[:8])
+    _persist_branch(db, new_key, target, title, history, source=parent.get("source") or "tui",
+                    cwd=parent.get("cwd"), profile_name=_response_profile_name(params.get("profile")),
+                    model=parent.get("model") or "", copy_fields=("timestamp",),
+                    title_source="user", user_id=None if owner == "local-owner" else owner)
+    result = db.get_session(new_key)
+    if result is None or result.get("parent_session_id") != target:
+        raise RemoteConversationError(4503, "branch readback failed; do not retry automatically")
+    return {"stored_session_id": new_key, "parent_session_id": target, "source_row_id": row_id,
+            "message_count": len(history), "draft": draft, "mode": mode, "generation_started": False,
+            "inheritance": "visible_user_assistant_prefix_with_parent_system_context"}
+
+
+def register(server):
+    bind_module(globals(), server)

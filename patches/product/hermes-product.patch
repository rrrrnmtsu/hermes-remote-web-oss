+def compressed_pdf(active=True):
+    """Actual reachable compressed object dictionary, rather than a magic-text assertion."""
+    objects = {1: b"<< /Type /Catalog /Pages 2 0 R /Names 5 0 R >>",
+               2: b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+               3: b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 100 100] >>"}
+    content = zlib.compress(b"5 0 << /Java#53cript (DEMO) >>" if active else b"5 0 << /DEMO (ordinary) >>")
+    objects[4] = b"<< /Type /ObjStm /N 1 /First 4 /Filter /FlateDecode /Length " + str(len(content)).encode() + b" >>\nstream\n" + content + b"\nendstream"
+    data = bytearray(b"%PDF-1.7\n"); offsets = {}
+    for number, body in objects.items():
+        offsets[number] = len(data); data.extend(str(number).encode() + b" 0 obj\n" + body + b"\nendobj\n")
+    location = len(data); entries = bytearray()
+    for number in range(7):
+        kind, offset, generation = (0, 0, 65535) if number == 0 else (2, 4, 0) if number == 5 else (1, location, 0) if number == 6 else (1, offsets[number], 0)
+        entries.extend(bytes([kind]) + offset.to_bytes(4, "big") + generation.to_bytes(2, "big"))
+    xref = zlib.compress(entries)
+    data.extend(b"6 0 obj\n<< /Type /XRef /Size 7 /W [1 4 2] /Root 1 0 R /Filter /FlateDecode /Length " + str(len(xref)).encode() + b" >>\nstream\n" + xref + b"\nendstream\nendobj\nstartxref\n" + str(location).encode() + b"\n%%EOF\n")
+    return bytes(data)
+
+
+@pytest.mark.parametrize("active", [False, True])
+def test_real_rpc_pdf_semantics_inspects_compressed_escaped_names(file_gateway, active):
+    _, rpc, _, _, root, _, _ = file_gateway
+    (root / "compressed.pdf").write_bytes(compressed_pdf(active))
+    chosen, listing = root_and_list(rpc); row = listing["result"]["rows"][0]
+    result = rpc("remote.files.read", {"profile": "default", "session_id": "live", "root_id": chosen["id"], "path": row["path"], "expected_etag": row["etag"]})
+    assert result["error"]["code"] == 5410 if active else result["result"]["content"]["mime"] == "application/pdf"

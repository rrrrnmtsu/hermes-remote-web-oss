+    monkeypatch.setattr(server, "_remote_info_skills", lambda context: {})
+    monkeypatch.setattr("agent.anthropic_credentials.read_claude_code_credentials", lambda *a, **k: pytest.fail("Forbidden CLI credentials"))
+    monkeypatch.setattr("agent.account_usage.fetch_account_usage", lambda *a, **k: pytest.fail("External account query"))
+    monkeypatch.setattr("hermes_cli.inventory.build_model_options_payload", lambda *a, **k: pytest.fail("Forbidden model inventory resolver"))
+    class Transport:
+        auth_identity = {"provider": "DEMO", "user_id": "alice"}
+        def write(self, frame): return True
+    transport = Transport()
+    def rpc(name, params, identity=None):
+        from tui_gateway.transport import bind_transport, reset_transport
+        caller = transport if identity is None else SimpleNamespace(auth_identity=identity)
+        token = bind_transport(caller)
+        try:
+            return server.handle_request({"jsonrpc": "2.0", "id": "DEMO-info", "method": name, "params": params})
+        finally:
+            reset_transport(token)
+    def session(sid="live", profile="default", principal="DEMO:alice"):
+        result = {"session_key": f"durable-{sid}", "profile_home": str(secondary) if profile == "worker" else None,
+                  "auth_user_id": principal, "agent": None, "history_lock": threading.Lock(), "history": [],
+                  "running": False, "model_override": None, "last_active": 10, "transport": transport}
+        server._sessions[sid] = result
+        return result
+    return server, rpc, session, home, secondary

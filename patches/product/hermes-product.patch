+def assert_owned_lazy_reply(fixture, profile, reply):
+    from hermes_constants import get_hermes_home
+
+    server, records, _, home, worker, roots, project_ids = fixture
+    assert "result" in reply, reply
+    result = reply["result"]
+    assert result["profile"] == profile
+    assert result["project"]["id"] == project_ids[profile]
+    assert Path(result["project"]["cwd"]) == roots[profile]
+    session = server._sessions[result["session_id"]]
+    assert Path(session["cwd"]) == roots[profile]
+    assert Path(session.get("profile_home") or home) == (home if profile == "default" else worker)
+    assert session["session_key"] == result["stored_session_id"]
+    assert session["auth_user_id"] == "DEMO:DEMO-user"
+    assert session["agent"] is None and not session["agent_ready"].is_set()
+    assert session["history"] == [] and not session["running"]
+    assert session["attached_images"] == [] and session["close_on_disconnect"] is False
+    assert records == []
+    assert get_hermes_home() == home
+    return session

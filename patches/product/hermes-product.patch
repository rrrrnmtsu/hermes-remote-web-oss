@@ -0,0 +1,234 @@
+"""Remote Web metadata methods, installed by the existing authenticated gateway facade."""
+from __future__ import annotations
+
+from .method_ctx import HandlerRegistry, bind_module
+
+_registry = HandlerRegistry()
+method = _registry.method
+
+
+def _remote_info_authorize(params, rid, *, require_session=False):
+    """The auth principal is server-owned. No anonymous legacy session ownership is inferred."""
+    principal = _transport_auth_user_id(current_transport())
+    if not principal:
+        return None, _err(rid, 4401, "Authenticated Remote Web identity is required")
+    profile = str(params.get("profile") or "").strip()
+    if not profile:
+        return None, _err(rid, 4401, "Explicit profile is required")
+    home = Path(_profile_home(profile) or _hermes_home).resolve()
+    sid = params.get("session_id") or None
+    session = _sessions.get(sid) if sid else None
+    if sid and (session is None or Path(session.get("profile_home") or _hermes_home).resolve() != home
+                or _session_auth_user_id(session) != principal):
+        return None, _err(rid, 4403, "Session does not belong to the authenticated profile owner")
+    if require_session and session is None:
+        return None, _err(rid, 4001, "A current live session is required")
+    return {"profile": profile, "home": home, "principal": principal, "sid": sid, "session": session}, None
+
+
+def _remote_info_read_config(context):
+    from tui_gateway.remote_information import config_metadata
+    return config_metadata(context["home"])
+
+
+def _remote_info_skills(context):
+    """Use the real, profile/workspace-keyed metadata catalog; never load or preprocess a skill body."""
+    from agent.skill_commands import get_skill_commands
+    with _session_home_scope(context["session"], profile=context["profile"]):
+        return get_skill_commands()
+
+
+def _remote_info_handler(name, *, require_session=False):
+    def decorate(body):
+        @method(name)
+        def handler(rid, params):
+            import sqlite3
+            context, error = _remote_info_authorize(params, rid, require_session=require_session)
+            if error:
+                return error
+            try:
+                return body(rid, params, context)
+            except (OSError, ValueError, sqlite3.Error):
+                # Config text, secret refs, provider URLs and filesystem paths never become errors.
+                return _err(rid, 5401, "Profile information is unavailable; no write was retried")
+        return handler
+    return decorate
+
+
+@_remote_info_handler("remote.info.models")
+def _remote_info_models(rid, params, context):
+    from tui_gateway.remote_information import model_rows
+    return _ok(rid, model_rows(context["profile"], context["sid"], context["session"], _remote_info_read_config(context)))
+
+
+@_remote_info_handler("remote.info.commands")
+def _remote_info_commands(rid, params, context):
+    from tui_gateway.remote_information import command_rows
+    skills_state = "available"
+    try:
+        skills = _remote_info_skills(context)
+    except Exception:
+        skills, skills_state = {}, "unknown"
+    return _ok(rid, {"version": 1, "profile": context["profile"], "skills_state": skills_state,
+                     **command_rows(_remote_info_read_config(context), skills, str(params.get("query") or ""), int(params.get("limit", 50)))})
+
+
+@_remote_info_handler("remote.info.snapshot")
+def _remote_info_snapshot(rid, params, context):
+    from tui_gateway.remote_information import route, display_text, usage_snapshot
+    cfg = _remote_info_read_config(context)
+    current = route(context["session"], cfg)
+    session = context["session"] or {}
+    agent = session.get("agent")
+    effective_tools = getattr(agent, "valid_tool_names", None)
+    configured_tools = cfg.get("toolsets") or {}
+    configured_tools = configured_tools.get("cli", []) if isinstance(configured_tools, dict) else configured_tools
+    if not isinstance(configured_tools, list):
+        configured_tools = []
+    tools_state = "available" if isinstance(effective_tools, (list, set, tuple)) else "configured" if configured_tools else "unknown"
+    tools = list(effective_tools) if tools_state == "available" else configured_tools
+    skills_state = "available"
+    try:
+        skills = _remote_info_skills(context)
+    except Exception:
+        skills, skills_state = {}, "unknown"
+    mcp = cfg.get("mcp_servers") or {}
+    mcp_state = "configured" if isinstance(mcp, dict) else "unknown"
+    mcp = mcp if isinstance(mcp, dict) else {}
+    return _ok(rid, {"version": 1, "profile": context["profile"], "session_id": context["sid"],
+                     "model": current["model"], "provider": current["provider"], "api_mode": current["api_mode"],
+                     "tools": [{"name": display_text(name), "state": tools_state} for name in sorted(tools)[:100] if isinstance(name, str)],
+                     "tools_state": tools_state, "skills": [{"name": display_text(name), "state": "available"} for name in sorted(skills)[:100]],
+                     "skills_state": skills_state,
+                     "mcp": [{"name": display_text(name), "state": "disabled" if isinstance(value, dict) and value.get("enabled") is False else "configured"}
+                             for name, value in sorted(mcp.items())[:100]], "mcp_state": mcp_state,
+                     "usage": usage_snapshot(context["home"], context["session"], context["principal"]),
+                     "observed_at": time.time(), "truncated": any(len(values) > 100 for values in (tools, skills, mcp))})
+
+
+@_remote_info_handler("remote.info.cron")
+def _remote_info_cron(rid, params, context):
+    from tui_gateway.remote_information import cron_snapshot
+    return _ok(rid, cron_snapshot(context["home"], context["profile"], params.get("job_id"), int(params.get("limit", 50))))
+
+
+@_remote_info_handler("remote.info.activity")
+def _remote_info_activity(rid, params, context):
+    import sqlite3
+    from tui_gateway import server_requests
+    from tui_gateway.remote_information import open_readonly, nonnegative, display_text
+    limit = int(params.get("limit", 50))
+    with _sessions_lock:
+        live = [(sid, session) for sid, session in _sessions.items()
+                if Path(session.get("profile_home") or _hermes_home).resolve() == context["home"]
+                and _session_auth_user_id(session) == context["principal"]]
+    live.sort(key=lambda item: (item[1].get("last_active") or 0, item[0]), reverse=True)
+    rows = {}
+    stored_state = "unavailable"
+    for sid, session in live[:limit + 1]:
+        requests = server_requests.open_requests(sid)
+        count = len([req for req in requests if req.get("method") in {"approval", "clarify"}])
+        durable = str(session.get("session_key") or "")
+        if not durable:
+            continue
+        state = "waiting_input" if count else "running" if session.get("running") else "failed" if session.get("agent_error") else "completed" if session.get("history") else "idle"
+        rows[durable] = {"durable_id": durable, "live_id": sid, "title": display_text(session.get("pending_title")) or "無題の会話",
+                         "state": state, "open_request_count": count, "last_active": nonnegative(session.get("last_active"))}
+    try:
+        with open_readonly(context["home"] / "state.db") as conn:
+            stored = conn.execute("SELECT id,title,started_at,ended_at,end_reason FROM sessions WHERE user_id=? ORDER BY started_at DESC,id DESC LIMIT ?",
+                                  (context["principal"], limit + 1)).fetchall()
+        stored_state = "available"
+        for record in stored:
+            if record["id"] in rows:
+                rows[record["id"]]["title"] = display_text(record["title"]) or "無題の会話"
+                continue
+            rows[record["id"]] = {"durable_id": record["id"], "live_id": None, "title": display_text(record["title"]) or "無題の会話",
+                                   "state": "failed" if record["end_reason"] in {"error", "failed"} else "completed" if record["ended_at"] else "unknown",
+                                   "open_request_count": 0, "last_active": nonnegative(record["ended_at"]) or nonnegative(record["started_at"])}
+    except (OSError, ValueError, sqlite3.Error):
+        pass  # Live records remain real; absent durable metadata is not invented as an empty store.
+    ordered = sorted(rows.values(), key=lambda row: (row["last_active"] or 0, row["durable_id"]), reverse=True)
+    return _ok(rid, {"version": 1, "profile": context["profile"], "rows": ordered[:limit], "stored_state": stored_state,
+                     "observed_at": time.time(), "truncated": len(ordered) > limit})
+
+
+@_remote_info_handler("remote.session.model_set", require_session=True)
+def _remote_info_model_set(rid, params, context):
+    from tui_gateway.remote_information import model_rows, model_revision, model_change_reason, configured_models, route, choice_reason, model_limits, apply_runtime_limits
+    cfg = _remote_info_read_config(context)
+    session = context["session"]
+    if "history_lock" not in session:
+        return _err(rid, 4409, "Session admission lock is unavailable")
+    with session["history_lock"]:
+        if reason := model_change_reason(session, cfg):
+            return _err(rid, 4409, reason)
+        if params.get("expected_revision") != model_revision(session, cfg):
+            return _err(rid, 4409, "Model changed elsewhere; read back before another explicit choice")
+        current = route(session, cfg)
+        choice = next((row for row in configured_models(cfg, current["provider"], current["model"]) if row["id"] == params["model"]), None)
+        if choice is None:
+            return _err(rid, 4403, "Model is not listed on the session's existing provider route")
+        if reason := choice_reason(choice, current):
+            return _err(rid, 4409, reason)
+        limits = model_limits(choice)
+        # Keep the existing SDK transport and credential objects. No pool reload, resolver, HTTP
+        # probe, fallback, agent reconstruction or system prompt/memory/toolset rebuild is performed.
+        override = {"model": choice["id"], "provider": current["provider"], "api_mode": current["api_mode"], "base_url": current["base_url"]}
+        with _session_db(session) as db:
+            if db is not None and (stored := db.get_session(session.get("session_key"))):
+                if stored.get("user_id") != context["principal"]:
+                    return _err(rid, 4403, "Durable session belongs to another owner")
+                prior = stored.get("model_config") or "{}"
+                prior = json.loads(prior) if isinstance(prior, str) else dict(prior)
+                prior.update(override)
+                prior["remote_info_limits"] = limits
+                db.update_session_meta(session["session_key"], json.dumps(prior), choice["id"])
+        session["model_override"] = override
+        session["remote_info_limits"] = limits
+        session["remote_info_model_revision"] = session.get("remote_info_model_revision", 0) + 1
+        agent = session.get("agent")
+        session["remote_info_selected_model"] = choice["id"]
+        session["remote_info_response_calls"] = getattr(agent, "session_api_calls", 0) or 0
+        if agent is not None:
+            agent.model = choice["id"]
+            apply_runtime_limits(session, agent)
+            # A model choice never grants extra runtime capabilities; they are re-derived by
+            # the normal runtime on subsequent reconstruction. Existing prompt bytes stay stable.
+            agent.runtime_capabilities = {}
+            primary = getattr(agent, "_primary_runtime", None)
+            if isinstance(primary, dict):
+                agent._primary_runtime = {**primary, "model": choice["id"], "compressor_model": choice["id"], "runtime_capabilities": {}}
+            compressor = getattr(agent, "context_compressor", None)
+            if compressor is not None:
+                compressor.model = choice["id"]
+        return _ok(rid, model_rows(context["profile"], context["sid"], session, cfg))
+
+
+@_remote_info_handler("remote.project.create_session")
+def _remote_info_project_create(rid, params, context):
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    from tui_gateway.remote_information import project
+    registered = project(context["home"], params["project_id"])
+    # Only a server-resolved existing registered project path reaches the legacy create method.
+    # Its lazy metadata lookups are home-keyed; the internal handler call has no dispatcher
+    # scope. Bind the authorized home even for default under a foreign ambient context.
+    token = set_hermes_home_override(context["home"])
+    try:
+        response = _methods["session.create"](rid, {"profile": context["profile"], "cwd": registered["cwd"],
+                                                  "cwd_explicit": True, "lazy": True, "close_on_disconnect": False})
+    finally:
+        reset_hermes_home_override(token)
+    if "error" in response:
+        return response
+    result = response["result"]
+    info = result.get("info") or {}
+    returned = info.get("project") or {}
+    if returned.get("id") != registered["id"] or Path(info.get("cwd") or "").resolve() != Path(registered["cwd"]):
+        return _err(rid, 5402, "Project session was created but its destination could not be verified; do not recreate automatically")
+    return _ok(rid, {"session_id": result["session_id"], "stored_session_id": result["stored_session_id"],
+                     "profile": context["profile"], "project": registered})
+
+
+def register(server):
+    bind_module(globals(), server)

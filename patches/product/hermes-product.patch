diff --git a/tui_gateway/remote_attachment_policy.py b/tui_gateway/remote_attachment_policy.py
new file mode 100644
index 0000000000000000000000000000000000000000..85444fd627e9877063d7118d73671a06bf694653
--- /dev/null
+++ b/tui_gateway/remote_attachment_policy.py
@@ -0,0 +1,61 @@
+"""Offline provider restrictions for the atomic image turn; never resolve credentials.
+
+Anthropic reference checked 2026-10-05:
+https://platform.claude.com/docs/en/build-with-claude/vision#request-limits
+"""
+from __future__ import annotations
+
+
+def _history_image_count(session: dict) -> int:
+    count = 0
+    history = session.get("history") or []
+    for row in history:
+        if not isinstance(row, dict): continue
+        meta = row.get("display_metadata")
+        if row.get("display_kind") == "image_turn" and isinstance(meta, dict) and meta.get("image_receipt_id"):
+            count += 1
+            continue
+        stack = [row.get("content")]
+        steps = 0
+        while stack:
+            steps += 1
+            if steps > 10000: return 100
+            item = stack.pop()
+            if isinstance(item, list): stack.extend(item)
+            elif isinstance(item, dict):
+                if item.get("type") in {"image", "image_url"}: count += 1
+                else: stack.extend(value for key, value in item.items() if key in {"content", "parts"})
+            elif isinstance(item, str):
+                count += item.count("[Image attached at: ")
+        if count >= 100: return count
+    return count
+
+
+def image_provider_limits(session: dict, config: dict) -> dict:
+    from tui_gateway.prompt_image_turn import RAW_LIMIT, MAX_EDGE, MAX_PIXELS, route
+    provider, _model = route(session, config)
+    previous = _history_image_count(session)
+    # Unknown model context class uses the strict 100-image API limit, never 600.
+    supported = provider == "anthropic" and previous < 100
+    edge = min(MAX_EDGE, 2000 if previous + 1 > 20 else 8000)
+    return {"supported": supported, "reason": "" if supported else "provider_image_limit_unconfirmed" if provider != "anthropic" else "history_image_count_limit",
+            "max_raw_bytes": min(RAW_LIMIT, (10_000_000 // 4) * 3), "max_edge": edge,
+            "max_pixels": min(MAX_PIXELS, edge * edge), "history_images": previous}
+
+
+def restrict_image_capabilities(session: dict, config: dict, base: dict) -> dict:
+    policy = image_provider_limits(session, config)
+    return {**base, "enabled": bool(base["enabled"] and policy["supported"]),
+            "reason": base["reason"] if not base["enabled"] else policy["reason"],
+            "max_raw_bytes": min(base["max_raw_bytes"], policy["max_raw_bytes"]),
+            "max_edge": min(base["max_edge"], policy["max_edge"]),
+            "max_pixels": min(base["max_pixels"], policy["max_pixels"])}
+
+
+def enforce_image_provider_limits(image: dict, session: dict, config: dict) -> None:
+    from tui_gateway.prompt_image_turn import ImageTurnError
+    limits = image_provider_limits(session, config)
+    if (not limits["supported"] or len(image["data"]) > limits["max_raw_bytes"]
+            or max(image["width"], image["height"]) > limits["max_edge"]
+            or image["width"] * image["height"] > limits["max_pixels"]):
+        raise ImageTurnError("Image exceeds the selected provider's confirmed request limits")
diff --git a/tui_gateway/remote_conversation_metadata.py b/tui_gateway/remote_conversation_metadata.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b512c1bbbfe2b7735f2b4b5693d655ccedb4eb0
--- /dev/null
+++ b/tui_gateway/remote_conversation_metadata.py
@@ -0,0 +1,267 @@
+"""Bounded Remote Web metadata; transcripts stay in the canonical SessionDB.
+
+The attached transaction changes existing session columns and its optimistic version
+together. No conversation body is duplicated into this small per-profile sidecar.
+"""
+from __future__ import annotations
+
+import base64
+import contextlib
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import sqlite3
+import time
+import uuid
+
+
+class RemoteConversationError(ValueError):
+    def __init__(self, code: int, message: str):
+        super().__init__(message)
+        self.code = code
+
+
+def _bounded_text(value, maximum: int, *, optional: bool = False) -> str:
+    if not isinstance(value, str) or len(value) > maximum or "\x00" in value:
+        raise RemoteConversationError(4400, "invalid or oversized text")
+    if not optional and not value.strip():
+        raise RemoteConversationError(4400, "text required")
+    return value
+
+
+def _owner_clause(owner: str) -> tuple[str, tuple]:
+    return ("s.user_id IS NULL", ()) if owner == "local-owner" else ("s.user_id = ?", (owner,))
+
+
+def version(row: dict, revision: int) -> str:
+    values = [row.get("title") or "", bool(row.get("pinned")), bool(row.get("archived"))]
+    digest = hashlib.sha256(json.dumps(values, ensure_ascii=False).encode()).hexdigest()[:24]
+    return f"{revision}.{digest}"
+
+
+@contextlib.contextmanager
+def metadata_connection(state_path: Path):
+    state_path = Path(state_path)
+    if not state_path.is_file():
+        raise RemoteConversationError(4503, "session store unavailable")
+    directory = state_path.parent / "remote-web"
+    if directory.is_symlink():
+        raise RemoteConversationError(4503, "metadata directory is unsafe")
+    directory.mkdir(mode=0o700, exist_ok=True)
+    os.chmod(directory, 0o700)
+    path = directory / "metadata.sqlite"
+    if path.is_symlink():
+        raise RemoteConversationError(4503, "metadata store is unsafe")
+    fd = os.open(path, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o600)
+    os.close(fd)
+    os.chmod(path, 0o600)
+    if path.stat().st_size > 16 * 1024 * 1024:
+        raise RemoteConversationError(4503, "metadata quota exceeded")
+    conn = sqlite3.connect(path, timeout=5, isolation_level=None, uri=True)
+    conn.row_factory = sqlite3.Row
+    try:
+        conn.execute("PRAGMA busy_timeout=5000")
+        conn.executescript("""
+            CREATE TABLE IF NOT EXISTS session_versions (
+                owner TEXT NOT NULL, session_id TEXT NOT NULL, revision INTEGER NOT NULL,
+                PRIMARY KEY (owner, session_id));
+            CREATE TABLE IF NOT EXISTS templates (
+                owner TEXT NOT NULL, id TEXT NOT NULL, name TEXT NOT NULL, category TEXT NOT NULL,
+                body TEXT NOT NULL, version INTEGER NOT NULL, updated_at REAL NOT NULL,
+                PRIMARY KEY (owner, id));
+        """)
+        # mode=rw opens only an existing canonical store, never a new blank DB.
+        conn.execute("ATTACH DATABASE ? AS canonical", (state_path.resolve().as_uri() + "?mode=rw",))
+        yield conn
+    finally:
+        if conn.in_transaction:
+            conn.rollback()
+        conn.close()
+
+
+def owned_session(conn, owner: str, session_id: str) -> dict:
+    _bounded_text(session_id, 256)
+    clause, args = _owner_clause(owner)
+    row = conn.execute(f"SELECT s.* FROM canonical.sessions s WHERE s.id = ? AND {clause}",
+                       (session_id, *args)).fetchone()
+    if row is None:
+        raise RemoteConversationError(4404, "owned session not found")
+    return dict(row)
+
+
+def session_metadata(conn, owner: str, row: dict) -> dict:
+    revision = conn.execute("SELECT revision FROM session_versions WHERE owner=? AND session_id=?",
+                            (owner, row["id"])).fetchone()
+    return {"session_id": row["id"], "title": row.get("title") or "", "pinned": bool(row.get("pinned")),
+            "archived": bool(row.get("archived")), "version": version(row, int(revision[0]) if revision else 0)}
+
+
+def organize(conn, owner: str, params: dict, lineage: list[str] | None = None) -> dict:
+    requested = {key: params[key] for key in ("title", "pinned", "archived") if key in params}
+    if not requested:
+        raise RemoteConversationError(4400, "one metadata change required")
+    if "title" in requested:
+        from hermes_state import SessionDB
+        requested["title"] = SessionDB.sanitize_title(_bounded_text(requested["title"], 200))
+        if not requested["title"]:
+            raise RemoteConversationError(4400, "visible title required")
+    for key in ("pinned", "archived"):
+        if key in requested and type(requested[key]) is not bool:
+            raise RemoteConversationError(4400, "boolean required")
+    conn.execute("BEGIN IMMEDIATE")
+    row = owned_session(conn, owner, params.get("session_id"))
+    before = session_metadata(conn, owner, row)
+    if row.get("hidden"):
+        # Hidden Bot Chat names are routing identities, not ordinary conversations.
+        raise RemoteConversationError(4403, "hidden managed sessions cannot be organized here")
+    if params.get("expected_version") != before["version"]:
+        raise RemoteConversationError(4409, "session metadata changed; refresh before editing")
+    revision = int(before["version"].split(".")[0]) + 1
+    affected = list(dict.fromkeys(lineage or [row["id"]]))
+    if len(affected) > 100 or row["id"] not in affected:
+        raise RemoteConversationError(4400, "invalid compression lineage")
+    for member in affected:
+        owned_session(conn, owner, member)
+    try:
+        if "title" in requested:
+            conn.execute("UPDATE canonical.sessions SET title=?, title_source='user' WHERE id=?",
+                         (requested["title"], row["id"]))
+        for key in ("pinned", "archived"):
+            if key in requested:
+                extra = ", auto_archived=0" if key == "archived" else ""
+                placeholders = ",".join("?" for _ in affected)
+                conn.execute(f"UPDATE canonical.sessions SET {key}=?{extra} WHERE id IN ({placeholders})",
+                             (requested[key], *affected))
+    except sqlite3.IntegrityError:
+        raise RemoteConversationError(4409, "conversation name is already in use; choose another name") from None
+    conn.execute("INSERT INTO session_versions(owner,session_id,revision) VALUES(?,?,?) "
+                 "ON CONFLICT(owner,session_id) DO UPDATE SET revision=excluded.revision",
+                 (owner, row["id"], revision))
+    result = session_metadata(conn, owner, owned_session(conn, owner, row["id"]))
+    conn.commit()
+    return result
+
+
+def _literal_like(value: str) -> str:
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def list_sessions(conn, owner: str, params: dict, project_paths: list[str] | None = None) -> dict:
+    limit = params.get("limit", 50)
+    if type(limit) is not int or not 1 <= limit <= 100:
+        raise RemoteConversationError(4400, "page limit must be 1 to 100")
+    query = _bounded_text(params.get("query", ""), 200, optional=True).strip()
+    archive = params.get("archive", "active")
+    if archive not in {"active", "archived", "all"}:
+        raise RemoteConversationError(4400, "invalid archive view")
+    dates = [params.get("from_time"), params.get("to_time")]
+    if any(v is not None and (type(v) not in {int, float} or not math.isfinite(v) or v < 0) for v in dates):
+        raise RemoteConversationError(4400, "invalid date boundary")
+    if all(v is not None for v in dates) and dates[0] > dates[1]:
+        raise RemoteConversationError(4400, "invalid date range")
+    scope = hashlib.sha256(json.dumps([owner, query, archive, dates, params.get("project_id"),
+                                      project_paths], ensure_ascii=False, sort_keys=True).encode()).hexdigest()
+    anchor, after = time.time(), None
+    if cursor := params.get("cursor"):
+        if not isinstance(cursor, str) or len(cursor) > 2048:
+            raise RemoteConversationError(4400, "invalid cursor")
+        try:
+            decoded = json.loads(base64.urlsafe_b64decode(cursor + "=" * (-len(cursor) % 4)))
+            if decoded["scope"] != scope or time.time() - decoded["issued"] > 3600:
+                raise ValueError("stale scope")
+            anchor, after = decoded["anchor"], decoded["after"]
+            if not math.isfinite(anchor) or not math.isfinite(after[0]) or not isinstance(after[1], str):
+                raise ValueError("invalid key")
+        except (ValueError, TypeError, KeyError, IndexError):
+            raise RemoteConversationError(4400, "cursor expired or belongs to another search") from None
+    clause, owner_args = _owner_clause(owner)
+    from hermes_state_common import _LISTABLE_CHILD_SQL
+    listable_child = _LISTABLE_CHILD_SQL.replace("FROM sessions", "FROM canonical.sessions")
+    clauses, args = [clause, "s.started_at <= ?", "s.hidden = 0", listable_child,
+                     "COALESCE(s.source,'') NOT IN ('cron','kanban','oneshot')"], [*owner_args, anchor]
+    if archive != "all":
+        clauses.append("s.archived = ?")
+        args.append(int(archive == "archived"))
+    if query:
+        clauses.append("COALESCE(s.title,'') LIKE ? ESCAPE '\\'")
+        args.append("%" + _literal_like(query) + "%")
+    for op, value in zip((">=", "<="), dates):
+        if value is not None:
+            clauses.append(f"s.started_at {op} ?")
+            args.append(value)
+    if project_paths is not None:
+        if not project_paths:
+            clauses.append("0")
+        else:
+            clauses.append("(" + " OR ".join("(s.cwd = ? OR s.cwd LIKE ? ESCAPE '\\')" for _ in project_paths) + ")")
+            for path in project_paths:
+                args.extend([path, _literal_like(path.rstrip("/")) + "/%"])
+    if after is not None:
+        clauses.append("(s.started_at < ? OR (s.started_at = ? AND s.id < ?))")
+        args.extend([after[0], after[0], after[1]])
+    conn.execute("BEGIN")
+    raw = conn.execute("SELECT s.id,s.title,s.started_at,s.pinned,s.archived,s.parent_session_id "
+                       "FROM canonical.sessions s WHERE " + " AND ".join(clauses) +
+                       " ORDER BY s.started_at DESC,s.id DESC LIMIT ?", (*args, limit + 1)).fetchall()
+    items = [{**session_metadata(conn, owner, dict(row)), "started_at": row["started_at"],
+              "parent_session_id": row["parent_session_id"]} for row in raw[:limit]]
+    next_cursor = None
+    if len(raw) > limit:
+        last = raw[limit - 1]
+        next_cursor = base64.urlsafe_b64encode(json.dumps({"scope": scope, "issued": time.time(), "anchor": anchor,
+                                                         "after": [last["started_at"], last["id"]]},
+                                                        separators=(",", ":")).encode()).decode().rstrip("=")
+    conn.commit()
+    return {"sessions": items, "next_cursor": next_cursor, "order": "created_desc", "limit": limit,
+            "scope": "owned_profile_sessions", "snapshot_time": anchor}
+
+
+def templates_list(conn, owner: str) -> dict:
+    rows = conn.execute("SELECT id,name,category,body,version,updated_at FROM templates WHERE owner=? "
+                        "ORDER BY category,name,id LIMIT 50", (owner,)).fetchall()
+    return {"templates": [dict(row) for row in rows], "limit": 50, "body_limit": 8000,
+            "storage_scope": "authenticated_owner_profile_server"}
+
+
+def template_put(conn, owner: str, params: dict) -> dict:
+    name = _bounded_text(params.get("name"), 100).strip()
+    category = _bounded_text(params.get("category", ""), 50, optional=True).strip()
+    body = _bounded_text(params.get("body"), 8000)
+    target = params.get("id")
+    conn.execute("BEGIN IMMEDIATE")
+    if target is not None:
+        row = conn.execute("SELECT version FROM templates WHERE owner=? AND id=?", (owner, target)).fetchone()
+        if row is None:
+            raise RemoteConversationError(4404, "owned template not found")
+        if params.get("expected_version") != row[0]:
+            raise RemoteConversationError(4409, "template changed; refresh before editing")
+        revision = row[0] + 1
+    else:
+        if params.get("expected_version") is not None:
+            raise RemoteConversationError(4400, "new template cannot have a previous version")
+        if conn.execute("SELECT COUNT(*) FROM templates WHERE owner=?", (owner,)).fetchone()[0] >= 50:
+            raise RemoteConversationError(4429, "template limit is 50")
+        target, revision = uuid.uuid4().hex, 1
+    conn.execute("INSERT INTO templates(owner,id,name,category,body,version,updated_at) VALUES(?,?,?,?,?,?,?) "
+                 "ON CONFLICT(owner,id) DO UPDATE SET name=excluded.name,category=excluded.category,"
+                 "body=excluded.body,version=excluded.version,updated_at=excluded.updated_at",
+                 (owner, target, name, category, body, revision, time.time()))
+    row = dict(conn.execute("SELECT id,name,category,body,version,updated_at FROM templates WHERE owner=? AND id=?",
+                            (owner, target)).fetchone())
+    conn.commit()
+    return {"template": row}
+
+
+def template_remove(conn, owner: str, params: dict) -> dict:
+    target = _bounded_text(params.get("id"), 256)
+    conn.execute("BEGIN IMMEDIATE")
+    row = conn.execute("SELECT version FROM templates WHERE owner=? AND id=?", (owner, target)).fetchone()
+    if row is None:
+        raise RemoteConversationError(4404, "owned template not found")
+    if params.get("expected_version") != row[0]:
+        raise RemoteConversationError(4409, "template changed; refresh before removing")
+    conn.execute("DELETE FROM templates WHERE owner=? AND id=?", (owner, target))
+    conn.commit()
+    return {"removed": target, "version": row[0]}
diff --git a/tui_gateway/remote_files.py b/tui_gateway/remote_files.py
new file mode 100644
index 0000000000000000000000000000000000000000..d4bba07b5562a7c22c678e877a9096a129836f3d
--- /dev/null
+++ b/tui_gateway/remote_files.py
@@ -0,0 +1,256 @@
+"""Authenticated registered-root reads and canonical tool-result artifact metadata. No writes."""
+from __future__ import annotations
+
+import base64
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import sqlite3
+import time
+
+from .remote_information import InformationUnavailable, open_readonly, display_text, config_metadata
+
+READ_LIMIT = 1024 * 1024
+LIST_LIMIT = 100
+DENIED = {".git", ".ssh", ".codex", ".claude", ".hermes", "node_modules", "__pycache__", "auth.json", "config.yaml", "config.yml", "config.json", "id_rsa", "id_ed25519"}
+TEXT_MIMES = {".md": "text/markdown", ".txt": "text/plain", ".csv": "text/csv", ".json": "application/json"}
+BINARY_MIMES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".pdf": "application/pdf"}
+
+
+class FileUnavailable(InformationUnavailable):
+    pass
+
+
+def safe_name(name: str) -> bool:
+    folded = name.casefold()
+    return (bool(name) and len(name) <= 255 and name not in {".", ".."} and not name.startswith(".")
+            and not any(ord(char) < 32 or char in "/\\" for char in name) and folded not in DENIED
+            and not any(word in folded for word in ("secret", "credential", "password", "token", ".env"))
+            and not folded.endswith((".pem", ".key", ".p12", ".pfx", ".kdbx")))
+
+
+def relative_parts(value: str, *, directory=False) -> tuple[str, ...]:
+    if value == "" and directory:
+        return ()
+    if not isinstance(value, str) or len(value) > 1024 or value.startswith("/") or "\\" in value:
+        raise FileUnavailable("Only a bounded relative registered-root path is accepted")
+    parts = tuple(value.split("/"))
+    if len(parts) > 16 or any(not safe_name(part) for part in parts):
+        raise FileUnavailable("Private or unsafe path is unavailable")
+    return parts
+
+
+def root_valid(home: Path, path: Path) -> bool:
+    try:
+        real = path.resolve(strict=True)
+        return (path.is_absolute() and real == path and not path.is_symlink() and real.is_dir() and real.stat().st_uid == home.stat().st_uid
+                and real != Path.home().resolve() and real != Path("/") and real != home.resolve() and home.resolve() not in real.parents
+                and safe_name(real.name)
+                and not any(part.startswith(".") or part.casefold() in DENIED or part.casefold() in {"etc", "proc", "sys", "dev", "run", "secrets", "credentials", "vault"}
+                            for part in real.parts[1:]))
+    except (OSError, ValueError):
+        return False
+
+
+def roots(home: Path) -> tuple[list[dict], bool]:
+    with open_readonly(home / "projects.db") as conn:
+        rows = conn.execute("SELECT p.id,p.name,f.path FROM projects p JOIN project_folders f ON f.project_id=p.id WHERE p.archived=0 ORDER BY p.id,f.path LIMIT 101").fetchall()
+    result = []
+    for row in rows[:LIST_LIMIT]:
+        path = Path(row["path"])
+        if root_valid(home, path):
+            real = str(path.resolve())
+            key = hashlib.sha256((row["id"] + "\0" + real).encode()).hexdigest()
+            result.append({"id": key, "project_id": row["id"], "name": display_text(row["name"]), "folder_name": display_text(path.name), "_path": real})
+    return result, len(rows) > LIST_LIMIT
+
+
+def find_root(home: Path, root_id: str) -> dict:
+    selected = next((root for root in roots(home)[0] if root["id"] == root_id), None)
+    if not selected:
+        raise FileUnavailable("Registered root is unavailable")
+    return selected
+
+
+def session_roots(home: Path, session: dict) -> tuple[list[dict], bool]:
+    """A registered folder alone is not an auth-principal grant. Limit reads to this owned session's project/cwd."""
+    cwd = Path(session.get("cwd") or session.get("workspace_cwd") or "")
+    if not cwd.is_absolute() or cwd.resolve(strict=True) != cwd:
+        raise FileUnavailable("Session project/cwd is unavailable")
+    registered, truncated = roots(home)
+    project_id = session.get("project_id")
+    permitted = [root for root in registered if (not project_id or project_id == root["project_id"])
+                 and (cwd == Path(root["_path"]) or Path(root["_path"]) in cwd.parents)]
+    return permitted, truncated
+
+
+def session_root(home: Path, session: dict, root_id: str) -> dict:
+    result = next((root for root in session_roots(home, session)[0] if root["id"] == root_id), None)
+    if not result:
+        raise FileUnavailable("Registered folder does not belong to this session's project/cwd")
+    return result
+
+
+@contextmanager
+def open_directory(root: str, parts: tuple[str, ...]):
+    """Open every ancestor by directory FD; no symlink-following or pathname race fallback."""
+    descriptor = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        for part in (*Path(root).parts[1:], *parts):
+            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
+            os.close(descriptor)
+            descriptor = child
+        yield descriptor
+    finally:
+        os.close(descriptor)
+
+
+def etag(metadata) -> str:
+    values = (metadata.st_dev, metadata.st_ino, metadata.st_uid, metadata.st_nlink, metadata.st_size, metadata.st_mtime_ns, metadata.st_ctime_ns)
+    return hashlib.sha256(json.dumps(values).encode()).hexdigest()
+
+
+def kind(name: str) -> tuple[str | None, str]:
+    suffix = Path(name).suffix.lower()
+    return (TEXT_MIMES.get(suffix) or BINARY_MIMES.get(suffix), "text" if suffix in TEXT_MIMES else "binary")
+
+
+def list_directory(home: Path, root: dict, relative: str) -> dict:
+    parts = relative_parts(relative, directory=True)
+    owner = home.stat().st_uid
+    rows = []
+    examined = 0
+    with open_directory(root["_path"], parts) as descriptor:
+        with os.scandir(descriptor) as entries:
+            for entry in entries:
+                examined += 1
+                if examined > 1000:
+                    break  # Bounded even when all entries are denied.
+                if not safe_name(entry.name):
+                    continue
+                metadata = os.stat(entry.name, dir_fd=descriptor, follow_symlinks=False)
+                directory = stat.S_ISDIR(metadata.st_mode)
+                if metadata.st_uid != owner or not (directory or stat.S_ISREG(metadata.st_mode)) or (not directory and metadata.st_nlink != 1):
+                    continue
+                mime, _ = kind(entry.name)
+                reason = "" if directory else "format_unsupported" if not mime else "size_limit" if metadata.st_size > READ_LIMIT else ""
+                rows.append({"name": entry.name, "path": "/".join((*parts, entry.name)), "directory": directory,
+                             "bytes": None if directory else metadata.st_size, "mime": mime, "etag": etag(metadata), "readable": not directory and not reason, "reason": reason})
+                if len(rows) > LIST_LIMIT:
+                    break
+    rows.sort(key=lambda row: (not row["directory"], row["name"].casefold(), row["name"]))
+    return {"rows": rows[:LIST_LIMIT], "truncated": len(rows) > LIST_LIMIT or examined > 1000, "max_bytes": READ_LIMIT}
+
+
+def pdf_validate(data: bytes) -> None:
+    """Use the single shared fixed-version bounded parser, including semantic active-object checks."""
+    try:
+        from .prompt_document_turn import validate_pdf
+        validate_pdf(data, require_text=False)
+    except (ImportError, OSError, ValueError):
+        raise FileUnavailable("PDF parser/semantic validation is unavailable or refused the document") from None
+
+
+def read_file(home: Path, root: dict, relative: str, expected: str) -> dict:
+    parts = relative_parts(relative)
+    mime, encoding = kind(parts[-1])
+    if not mime:
+        raise FileUnavailable("File format is unsupported")
+    with open_directory(root["_path"], parts[:-1]) as directory:
+        descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
+        try:
+            before = os.fstat(descriptor)
+            if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_uid != home.stat().st_uid or before.st_size > READ_LIMIT:
+                raise FileUnavailable("File owner/type/link/size limit failed")
+            if etag(before) != expected:
+                raise FileUnavailable("file_changed")
+            with os.fdopen(descriptor, "rb", closefd=False) as stream:
+                data = stream.read(READ_LIMIT + 1)
+            if len(data) > READ_LIMIT or etag(before) != etag(os.fstat(descriptor)):
+                raise FileUnavailable("file_changed")
+        finally:
+            os.close(descriptor)
+    result = {"name": parts[-1], "mime": mime, "bytes": len(data), "etag": expected, "sha256": hashlib.sha256(data).hexdigest(),
+              "text": None, "content_base64": None, "max_bytes": READ_LIMIT, "truncated": False}
+    if encoding == "text":
+        try:
+            result["text"] = data.decode("utf-8", errors="strict")
+        except UnicodeDecodeError:
+            raise FileUnavailable("File is not UTF-8") from None
+        if "\x00" in result["text"]:
+            raise FileUnavailable("Binary data is not text")
+    else:
+        if mime == "application/pdf":
+            pdf_validate(data)
+        else:
+            from .prompt_image_turn import validate
+            validate({"filename": parts[-1], "content_base64": base64.b64encode(data).decode("ascii")}, "artifact validation")
+        result["content_base64"] = base64.b64encode(data).decode("ascii")
+    return result
+
+
+def prepare_artifacts(session: dict, home: Path, principal: str, call_id: str, name: str, args: dict, result, *, local_execution_verified: bool = False) -> list[dict]:
+    """Private producer hook. Returned metadata is authoritative only after the canonical tool-row flush."""
+    try:
+        if (not local_execution_verified or name != "write_file" or not principal or not call_id or session.get("auth_user_id") != principal
+                or session.get("_compute_host_active") or not session.get("session_key")):
+            return []
+        config = config_metadata(home)
+        terminal = config.get("terminal") or {}
+        if not isinstance(terminal, dict) or terminal.get("env", "local") != "local":
+            return []
+        payload = json.loads(result) if isinstance(result, str) and len(result) <= 65536 else result
+        if not isinstance(payload, dict) or payload.get("error") or payload.get("verified") is not True:
+            return []
+        target = Path(payload.get("resolved_path") or "")
+        declared = Path(args.get("path") or "")
+        cwd = session.get("cwd") or session.get("workspace_cwd")
+        if not target.is_absolute() or not declared or (not declared.is_absolute() and not cwd):
+            return []
+        declared = declared if declared.is_absolute() else Path(cwd) / declared
+        if target != declared or target.resolve() != target:
+            return []
+        for root in session_roots(home, session)[0]:
+            try:
+                relative = str(target.relative_to(root["_path"]))
+            except ValueError:
+                continue
+            parts = relative_parts(relative)
+            with open_directory(root["_path"], parts[:-1]) as folder:
+                metadata = os.stat(parts[-1], dir_fd=folder, follow_symlinks=False)
+            content = read_file(home, root, relative, etag(metadata))
+            if payload.get("bytes_written") != content["bytes"]:
+                return []
+            key = hashlib.sha256(json.dumps([principal, session["session_key"], call_id, root["id"], relative]).encode()).hexdigest()
+            return [{"version": 1, "id": key, "root_id": root["id"], "relative_path": relative,
+                     "name": content["name"], "mime": content["mime"], "bytes": content["bytes"], "etag": content["etag"],
+                     "sha256": content["sha256"], "call_id": call_id, "producer": "write_file", "registered_at": time.time()}]
+    except (OSError, ValueError, TypeError, KeyError, sqlite3.Error):
+        return []  # An unavailable artifact never changes the original tool result or its success.
+    return []
+
+
+def artifact_rows(home: Path, session: dict, principal: str) -> tuple[list[dict], bool]:
+    with open_readonly(home / "state.db") as db:
+        records = db.execute("SELECT m.tool_call_id,m.display_metadata FROM messages m JOIN sessions s ON s.id=m.session_id WHERE s.id=? AND s.user_id=? AND m.role='tool' AND m.active=1 AND m.display_metadata IS NOT NULL AND length(m.display_metadata)<=65536 ORDER BY m.id DESC LIMIT 101", (session["session_key"], principal)).fetchall()
+    items = []
+    seen = set()
+    for row in records[:LIST_LIMIT]:
+        try:
+            metadata = json.loads(row["display_metadata"])
+            candidates = (metadata.get("tool_result_metadata") or {}).get("remote_artifacts") or []
+            if not isinstance(candidates, list):
+                continue
+            for candidate in candidates[:1]:
+                if (not isinstance(candidate, dict) or candidate.get("version") != 1 or candidate.get("producer") != "write_file"
+                        or candidate.get("call_id") != row["tool_call_id"] or not re.fullmatch("[0-9a-f]{64}", candidate.get("id", "")) or candidate["id"] in seen):
+                    continue
+                seen.add(candidate["id"])
+                items.append(candidate)
+        except (ValueError, TypeError):
+            continue
+    return items[:LIST_LIMIT], len(records) > LIST_LIMIT or len(items) > LIST_LIMIT
diff --git a/tui_gateway/remote_information.py b/tui_gateway/remote_information.py
new file mode 100644
index 0000000000000000000000000000000000000000..b668b0e75df6439de91d4729e154d251d73d2e09
--- /dev/null
+++ b/tui_gateway/remote_information.py
@@ -0,0 +1,383 @@
+"""Small offline information projections. Every caller supplies an already-authorized home/session."""
+from __future__ import annotations
+
+import hashlib
+from contextlib import contextmanager
+import json
+import math
+import os
+from pathlib import Path
+import sqlite3
+import stat
+from datetime import datetime
+from urllib.parse import urlsplit
+from zoneinfo import ZoneInfo
+
+MAX_METADATA_BYTES = 2 * 1024 * 1024
+MAX_ROWS = 100
+
+
+class InformationUnavailable(ValueError):
+    pass
+
+
+def bounded_read(path: Path, limit: int = MAX_METADATA_BYTES) -> bytes:
+    """No symlink-following, unbounded reads, external source execution or auto-repair."""
+    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
+    try:
+        metadata = os.fstat(descriptor)
+        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > limit:
+            raise InformationUnavailable("Metadata exceeds its read limit")
+        with os.fdopen(descriptor, "rb", closefd=False) as stream:
+            data = stream.read(limit + 1)
+        if len(data) > limit:
+            raise InformationUnavailable("Metadata exceeds its read limit")
+        return data
+    finally:
+        os.close(descriptor)
+
+
+def config_metadata(home: Path) -> dict:
+    import hermes_yaml as yaml
+    try:
+        result = yaml.safe_load(bounded_read(home / "config.yaml"))
+    except FileNotFoundError:
+        return {}
+    except (OSError, ValueError, yaml.YAMLError):
+        raise InformationUnavailable("Profile metadata is unavailable") from None
+    if result is None:
+        return {}
+    if not isinstance(result, dict):
+        raise InformationUnavailable("Profile metadata is invalid")
+    return result
+
+
+def display_text(value, limit: int = 256) -> str:
+    text = value if isinstance(value, str) else ""
+    return "".join(char for char in text if char >= " " or char in "\n\t")[:limit]
+
+
+def nonnegative(value):
+    return value if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0 else None
+
+
+def endpoint_origin(value) -> str | None:
+    try:
+        url = urlsplit(value if isinstance(value, str) else "")
+        if url.scheme not in {"https", "http"} or not url.hostname:
+            return None
+        host = f"[{url.hostname}]" if ":" in url.hostname else url.hostname
+        return f"{url.scheme}://{host}" + (f":{url.port}" if url.port else "")
+    except ValueError:
+        return None
+
+
+def _object(value):
+    return value if isinstance(value, dict) else {}
+
+
+def route(session: dict | None, config: dict) -> dict:
+    session = session or {}
+    agent = session.get("agent")
+    configured = _object(config.get("model"))
+    override = _object(session.get("model_override"))
+    mirror = _object(session.get("_metadata_mirror"))
+    fields = {}
+    for name, cfg_key in (("model", "default"), ("provider", "provider"), ("api_mode", "api_mode"), ("base_url", "base_url")):
+        value = mirror.get(name) or getattr(agent, name, None) or override.get(name) or configured.get(cfg_key)
+        fields[name] = display_text(value, 1024 if name == "base_url" else 256)
+    return fields
+
+
+def model_revision(session: dict | None, config: dict) -> str:
+    current = route(session, config)
+    state = {**current, "revision": (session or {}).get("remote_info_model_revision", 0)}
+    return hashlib.sha256(json.dumps(state, sort_keys=True).encode()).hexdigest()
+
+
+def configured_models(config: dict, provider: str, current: str) -> list[dict]:
+    """Saved models only: neither a global provider inventory nor proof of usable credentials."""
+    candidates = [{"id": current}] if current else []
+    model_cfg = _object(config.get("model"))
+    if model_cfg.get("provider") == provider and model_cfg.get("default"):
+        candidates.append({"id": model_cfg["default"], "context_length": model_cfg.get("context_length"),
+                           "max_output_tokens": model_cfg.get("max_output_tokens")})
+    candidates.extend(model_cfg.get("models") if isinstance(model_cfg.get("models"), list) else [])
+    providers = _object(config.get("providers"))
+    row = _object(providers.get(provider))
+    candidates.extend(row.get("models") if isinstance(row.get("models"), list) else [])
+    custom_entries = config.get("custom_providers")
+    for custom in custom_entries if isinstance(custom_entries, list) else []:
+        if isinstance(custom, dict) and provider in {custom.get("name"), f"custom:{custom.get('name')}", custom.get("provider")}:
+            candidates.extend(custom.get("models") if isinstance(custom.get("models"), list) else [])
+    seen = {}
+    result = []
+    for candidate in candidates:
+        entry = {"id": candidate} if isinstance(candidate, str) else _object(candidate)
+        name = display_text(entry.get("id") or entry.get("model") or entry.get("name"))
+        if name and name not in seen:
+            seen[name] = len(result)
+            result.append({**entry, "id": name})
+        elif name:
+            result[seen[name]] = {**result[seen[name]], **entry, "id": name}
+        if len(result) > MAX_ROWS:
+            break
+    return result
+
+
+def model_limits(choice: dict) -> dict | None:
+    """Require explicit offline model ceilings. A catalog name alone does not establish limits."""
+    limits = {key: choice.get(key) for key in ("context_length", "max_output_tokens")}
+    if any(not isinstance(value, int) or isinstance(value, bool) or value <= 0 for value in limits.values()):
+        return None
+    if limits["max_output_tokens"] >= limits["context_length"] or limits["context_length"] > 10_000_000:
+        return None
+    return limits
+
+
+def choice_reason(choice: dict, current: dict) -> str:
+    if choice.get("provider") not in {None, "", current["provider"]} or choice.get("api_mode") not in {None, "", current["api_mode"]}:
+        return "different_route"
+    return "" if model_limits(choice) else "limits_unknown"
+
+
+def apply_runtime_limits(session: dict, agent) -> None:
+    """Clamp only this already-built agent; no credentials, provider metadata or SDK reconstruction."""
+    saved = session.get("remote_info_limits")
+    if saved is None:
+        return  # Ordinary sessions retain their existing runtime policy.
+    limits = model_limits(_object(saved))
+    if limits is None:
+        raise InformationUnavailable("Session model limits are unknown; generation is disabled")
+    previous_output = nonnegative(getattr(agent, "max_tokens", None))
+    agent.max_tokens = min(int(previous_output), limits["max_output_tokens"]) if previous_output else limits["max_output_tokens"]
+    compressor = getattr(agent, "context_compressor", None)
+    if compressor is not None:
+        # Do not read the lazy context_length property: its getter can probe provider metadata.
+        previous_context = nonnegative(vars(compressor).get("_resolved_context_length") or vars(compressor).get("context_length"))
+        compressor.max_tokens = agent.max_tokens
+        compressor.context_length = min(int(previous_context), limits["context_length"]) if previous_context else limits["context_length"]
+    primary = getattr(agent, "_primary_runtime", None)
+    if isinstance(primary, dict):
+        agent._primary_runtime = {**primary, "compressor_context_length": limits["context_length"]}
+
+
+def model_rows(profile: str, live_id: str | None, session: dict | None, config: dict) -> dict:
+    current = route(session, config)
+    agent = (session or {}).get("agent")
+    reason = model_change_reason(session, config)
+    rows = configured_models(config, current["provider"], current["model"])
+    return {"version": 1, "revision": model_revision(session, config), "profile": profile, "session_id": live_id,
+            "model": current["model"], "provider": current["provider"], "api_mode": current["api_mode"],
+            "endpoint_origin": endpoint_origin(current["base_url"]), "scope": "configured_same_route",
+            "truncated": len(rows) > MAX_ROWS,
+            "rows": [{"model": row["id"], "provider": current["provider"], "current": row["id"] == current["model"],
+                      "listed": True, "credential_present": bool(getattr(agent, "api_key", None)) if agent else None,
+                      "response_confirmed": True if row["id"] == current["model"] and (
+                          not (session or {}).get("remote_info_model_revision") or
+                          ((session or {}).get("remote_info_selected_model") == current["model"] and
+                           (nonnegative(getattr(agent, "session_api_calls", None)) or 0) > (session or {}).get("remote_info_response_calls", 0)))
+                      and nonnegative(getattr(agent, "session_api_calls", None)) not in {None, 0}
+                      and nonnegative(getattr(agent, "session_output_tokens", None)) not in {None, 0} else None,
+                      "selectable": not reason and not choice_reason(row, current), "reason": reason or choice_reason(row, current)} for row in rows[:MAX_ROWS]]}
+
+
+def model_change_reason(session: dict | None, config: dict) -> str:
+    if session is None:
+        return "select_conversation"
+    if session.get("running") or session.get("inflight_turn") or session.get("pending_model_switch") or session.get("queued_inputs"):
+        return "running_or_pending"
+    ready = session.get("agent_ready")
+    if session.get("agent_build_started") and ready is not None and not ready.is_set():
+        return "running_or_pending"
+    if session.get("_compute_host_active"):
+        return "compute_host_active"
+    cfg_agent = _object(config.get("agent"))
+    if cfg_agent.get("text_pilot") or getattr(session.get("agent"), "_text_pilot", None):
+        return "text_pilot_fixed_route"
+    from hermes_cli.fallback_config import get_fallback_chain
+    if get_fallback_chain(config) or getattr(session.get("agent"), "_fallback_chain", None):
+        return "fallback_configured"
+    current = route(session, config)
+    agent = session.get("agent")
+    if getattr(agent, "reasoning_config", None) or any(key in _object(getattr(agent, "request_overrides", None))
+        for key in ("model", "max_tokens", "max_output_tokens", "max_completion_tokens")):
+        return "runtime_limits_managed_externally"
+    if not current["provider"] or not current["model"]:
+        return "route_unknown"
+    # Device OAuth/external clients may rebuild or invoke credential readers on a change.
+    if current["provider"] in {"openai-codex", "copilot-acp", "moa", "lmstudio", "bedrock", "minimax-oauth"}:
+        return "route_managed_externally"
+    return ""
+
+
+@contextmanager
+def open_readonly(path: Path):
+    if path.is_symlink() or not path.is_file():
+        raise InformationUnavailable("Metadata store is unavailable")
+    connection = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
+    connection.row_factory = sqlite3.Row
+    connection.execute("PRAGMA query_only=ON")
+    budget = [0]
+    def bounded_query():
+        budget[0] += 1
+        return int(budget[0] > 2000)
+    connection.set_progress_handler(bounded_query, 1000)
+    try:
+        yield connection
+    finally:
+        connection.close()
+

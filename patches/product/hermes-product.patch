+                               "schedule": display_text(schedule.get("expr") or schedule.get("kind") or job.get("schedule_display")),
+                               "timezone": display_text(schedule.get("timezone") or schedule.get("tz")) or None,
+                               "enabled": job.get("enabled") if isinstance(job.get("enabled"), bool) else None,
+                               "next_run_at": display_text(job.get("next_run_at")) or None, "next_run_jst": jst(job.get("next_run_at")),
+                               "last_run_at": display_text(job.get("last_run_at")) or None, "last_run_jst": jst(job.get("last_run_at")),
+                               "last_status": display_text(job.get("last_status")) or None})
+    try:
+        with open_readonly(home / "cron" / "executions.db") as conn:
+            columns = "id, job_id, status, started_at, finished_at"
+            if job_id:
+                history = conn.execute(f"SELECT {columns} FROM executions WHERE job_id=? ORDER BY julianday(claimed_at) DESC,id DESC LIMIT ?", (job_id, limit + 1)).fetchall()
+            else:
+                history = conn.execute(f"SELECT {columns} FROM executions ORDER BY julianday(claimed_at) DESC,id DESC LIMIT ?", (limit + 1,)).fetchall()
+        result["truncated"] = result["truncated"] or len(history) > limit
+        result["history"] = [{"id": row["id"], "job_id": row["job_id"], "status": row["status"],
+                              "started_at": row["started_at"], "finished_at": row["finished_at"],
+                              "started_jst": jst(row["started_at"]), "finished_jst": jst(row["finished_at"])} for row in history[:limit]]
+    except (OSError, ValueError, sqlite3.Error):
+        result["history_state"] = "unavailable"
+    return result
+

+def test_cursor_snapshot_stable_tie_break_and_search_literals(store):
+    for i in range(6):
+        store.create_session(f"page-{i}", source="tui", user_id="DEMO:alice")
+    with store._lock:
+        store._conn.execute("UPDATE sessions SET started_at = 1 WHERE id LIKE 'page-%'")
+        store._conn.commit()
+    with metadata_connection(store.db_path) as conn:
+        page = list_sessions(conn, "DEMO:alice", {"limit": 2})
+        ids = [row["session_id"] for row in page["sessions"]]
+        assert len(ids) == 2 and page["next_cursor"]
+        literal = list_sessions(conn, "DEMO:alice", {"query": "_100%"})
+        assert [row["session_id"] for row in literal["sessions"]] == ["a"]
+        cursor = page["next_cursor"]
+        while cursor:
+            page = list_sessions(conn, "DEMO:alice", {"limit": 2, "cursor": cursor})
+            ids.extend(row["session_id"] for row in page["sessions"]); cursor = page["next_cursor"]
+        assert len(ids) == len(set(ids)) == 7
+        with pytest.raises(RemoteConversationError, match="another search"):
+            list_sessions(conn, "DEMO:bob", {"limit": 2, "cursor": list_sessions(conn, "DEMO:alice", {"limit": 2})["next_cursor"]})
+
+

+def command_rows(config: dict, skills: dict, query: str, limit: int) -> dict:
+    from hermes_cli.commands import COMMAND_REGISTRY, command_desktop_meta
+    rows = []
+    management = {"model", "setup", "tools", "mcp", "skills", "cron", "reset", "clear", "delete", "restart", "yolo", "reload", "undo"}
+    device = {"copy", "paste", "quit", "exit", "terminal", "voice", "speak"}
+    for command in COMMAND_REGISTRY:
+        text = f"/{command.name}"
+        metadata = command_desktop_meta(command)
+        support = "management" if command.name in management else "device_only" if command.name in device or metadata.get("desktop") == "local" else "unsupported"
+        rows.append({"text": text, "description": display_text(command.describe(), 500), "category": display_text(command.category),
+                     "kind": "command", "support": support, "insertable": False})
+    for text, skill in skills.items():
+        if not isinstance(skill, dict) or not isinstance(text, str) or not text.startswith("/"):
+            continue
+        rows.append({"text": display_text(text), "description": display_text(skill.get("description"), 500),
+                     "category": "Skills", "kind": "skill", "support": "draft", "insertable": True})
+    for name, command in _object(config.get("quick_commands")).items():
+        if not isinstance(command, dict) or not isinstance(name, str):
+            continue
+        alias = command.get("type") == "alias"
+        rows.append({"text": "/" + display_text(name), "description": display_text(command.get("description"), 500),
+                     "category": "User commands", "kind": "quick_command", "support": "unsupported" if alias else "management", "insertable": False})
+    folded = query.casefold()
+    filtered = [row for row in rows if not folded or folded in (row["text"] + " " + row["description"]).casefold()]
+    unique = {row["text"]: row for row in filtered}
+    ordered = sorted(unique.values(), key=lambda row: (row["category"], row["text"]))
+    return {"rows": ordered[:limit], "truncated": len(ordered) > limit}
+
+
+def jst(value) -> str | None:
+    if not isinstance(value, str):
+        return None
+    try:
+        instant = datetime.fromisoformat(value.replace("Z", "+00:00"))
+        return instant.astimezone(ZoneInfo("Asia/Tokyo")).isoformat() if instant.tzinfo else None
+    except (ValueError, OverflowError):
+        return None
+

+            if not path.is_absolute() or not path.is_dir() or path.is_symlink() or not any(Path(folder["path"]).resolve() == path.resolve() for folder in folders):
+                raise InformationUnavailable("Registered project root is unavailable")
+            real = path.resolve()
+            if real == home.resolve() or home.resolve() in real.parents or real in {Path("/"), Path.home().resolve()} or any(part in {".ssh", ".codex", ".claude"} for part in real.parts):
+                raise InformationUnavailable("Private/system roots are not remote projects")
+            if real.stat().st_uid != home.stat().st_uid:

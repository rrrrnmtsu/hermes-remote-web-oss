+class RecordingHTTPS:
+    def __init__(self, status=201, fail=False):
+        self.status = status
+        self.fail = fail
+        self.calls = []
+
+    def post(self, endpoint, *, data, headers, timeout):
+        self.calls.append((endpoint, data, headers, timeout))
+        if self.fail:
+            raise TimeoutError("synthetic ACK loss")
+        return SimpleNamespace(status_code=self.status, text="", reason="synthetic response", headers={})
+
+
+@pytest.mark.parametrize("endpoint", [
+    "http://web.push.apple.com/synthetic", "https://127.0.0.1/synthetic", "https://evil.example/synthetic",
+    "https://web.push.apple.com.evil.example/synthetic", "https://user@web.push.apple.com/synthetic",
+    "https://web.push.apple.com:9443/synthetic", "https://web.push.apple.com/synthetic?token=secret",
+    "https://web.push.apple.com/synthetic#fragment", "https://web.push.apple.com/../synthetic",
+    "https://web.push.apple.com/synthetic\ninvalid",
+])

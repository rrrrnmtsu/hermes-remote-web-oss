+def test_only_exact_owner_can_read_or_mutate_metadata(store):
+    with metadata_connection(store.db_path) as conn:
+        assert owned_session(conn, "DEMO:alice", "a")["id"] == "a"
+        for owner, sid in [("DEMO:alice", "b"), ("DEMO:alice", "legacy"), ("local-owner", "a")]:
+            with pytest.raises(RemoteConversationError, match="owned session"):
+                owned_session(conn, owner, sid)
+        assert list_sessions(conn, "local-owner", {})["sessions"][0]["session_id"] == "legacy"
+        before = session_metadata(conn, "DEMO:alice", owned_session(conn, "DEMO:alice", "a"))
+        reply = organize(conn, "DEMO:alice", {"session_id": "a", "expected_version": before["version"],
+                                             "title": "変更した日本語", "pinned": True, "archived": True})
+        assert reply["pinned"] and reply["archived"] and reply["version"] != before["version"]
+    assert store.get_session("a")["title"] == "変更した日本語"
+    assert store.get_session("a")["title_source"] == "user"
+    assert len(store.get_messages("a")) == 2
+    with metadata_connection(store.db_path) as conn:
+        assert session_metadata(conn, "DEMO:alice", owned_session(conn, "DEMO:alice", "a")) == reply
+
+
+def test_metadata_conflict_and_legacy_title_change_are_detected(store):
+    with metadata_connection(store.db_path) as conn:
+        original = session_metadata(conn, "DEMO:alice", owned_session(conn, "DEMO:alice", "a"))
+    store.set_session_title("a", "Desktopからの変更")
+    with metadata_connection(store.db_path) as conn:
+        with pytest.raises(RemoteConversationError) as exc:
+            organize(conn, "DEMO:alice", {"session_id": "a", "expected_version": original["version"], "pinned": True})
+        assert exc.value.code == 4409
+    assert not store.get_session("a")["pinned"]
+
+
+def test_concurrent_same_version_mutation_has_one_winner(store):
+    with metadata_connection(store.db_path) as conn:
+        version = session_metadata(conn, "DEMO:alice", owned_session(conn, "DEMO:alice", "a"))["version"]
+    def edit(value):
+        try:
+            with metadata_connection(store.db_path) as conn:
+                return organize(conn, "DEMO:alice", {"session_id": "a", "expected_version": version, "title": value})
+        except RemoteConversationError as exc:
+            return exc.code
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        results = list(executor.map(edit, ["first", "second"]))
+    assert sum(isinstance(result, dict) for result in results) == 1
+    assert 4409 in results

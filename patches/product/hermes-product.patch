+def test_real_model_read_write_and_next_turn_keep_other_session_and_config(real_gateway, monkeypatch):
+    server, records, gate, rpc, create, home, transport = real_gateway
+    install_information(server)
+    cfg = json.loads((home / "config.yaml").read_text())
+    cfg["model"]["models"] = [{"id": "synthetic-vision", "context_length": 200000, "max_output_tokens": 512},
+                             {"id": "synthetic-second", "context_length": 16000, "max_output_tokens": 512}]
+    (home / "config.yaml").write_text(json.dumps(cfg))
+    before = (home / "config.yaml").read_bytes()
+    first, other = create(), create()
+    assert server._sessions[first]["agent_ready"].wait(15)
+    assert server._sessions[other]["agent_ready"].wait(15)
+    snapshot = rpc("remote.info.models", {"profile": "default", "session_id": first})
+    assert "result" in snapshot, snapshot
+    result = rpc("remote.session.model_set", {"profile": "default", "session_id": first, "model": "synthetic-second", "expected_revision": snapshot["result"]["revision"]})
+    assert result["result"]["model"] == "synthetic-second", result
+    assert records == [] and server._sessions[other]["agent"].model == "synthetic-vision"
+    assert server._sessions[first]["agent"].max_tokens <= 512
+    assert (home / "config.yaml").read_bytes() == before
+    # Observe the actual native SDK send args; do not replace gateway/turn/request construction.
+    agent = server._sessions[first]["agent"]
+    client = agent._create_request_anthropic_client()
+    original_send = client.messages.create
+    output_caps = []
+    def observed_send(*args, **kwargs):
+        output_caps.append(kwargs.get("max_tokens"))
+        return original_send(*args, **kwargs)
+    monkeypatch.setattr(client.messages, "create", observed_send)
+    accepted = rpc("prompt.submit", {"profile": "default", "session_id": first, "text": "合成の次ターンです。", "image": None})
+    assert "result" in accepted, accepted
+    wait_done(server, first)
+    assert len(records) == 1 and records[0]["model"] == "synthetic-second" and records[0]["tools"] == 0
+    assert output_caps and all(isinstance(value, int) and value <= 512 for value in output_caps)
+    overview = rpc("remote.info.snapshot", {"profile": "default", "session_id": first})["result"]
+    assert overview["model"] == "synthetic-second" and overview["usage"]["calls"] == 1
+    activity = rpc("remote.info.activity", {"profile": "default"})["result"]
+    assert any(row["live_id"] == first and row["state"] == "completed" for row in activity["rows"])
+    models = rpc("remote.info.models", {"profile": "default", "session_id": first})["result"]
+    assert next(row for row in models["rows"] if row["current"])["response_confirmed"] is True

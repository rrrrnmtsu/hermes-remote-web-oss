+"""A durable Remote Web model choice survives every deferred resume path.
+
+Exercise the authenticated dispatcher, real profile configuration, SQLite and
+model CAS. Agent construction and credential resolution are forbidden: opening
+stored history must not require generation or provider credentials.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import socket
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_state import SessionDB
+from tui_gateway import server
+from tui_gateway.transport import bind_transport, reset_transport
+
+
+@pytest.fixture
+def gateway(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    worker = home / "profiles" / "worker"
+    homes = {"default": home, "worker": worker}
+    configs = {}
+    stores = {}
+    for profile, folder in homes.items():
+        folder.mkdir(parents=True, exist_ok=True)
+        model = f"DEMO-{profile}-original"
+        choice = f"DEMO-{profile}-choice"
+        limits = {"context_length": 8000 if profile == "default" else 12000,
+                  "max_output_tokens": 512 if profile == "default" else 768}
+        configs[profile] = {"model": {"default": model, "provider": "anthropic",
+                           "api_mode": "anthropic_messages", "models": [
+                               {"id": model, "context_length": 16000, "max_output_tokens": 1024},
+                               {"id": choice, **limits}]}}
+        (folder / "config.yaml").write_text(json.dumps(configs[profile]), encoding="utf-8")
+        db = SessionDB(db_path=folder / "state.db")
+        stores[profile] = db
+        for key in ("DEMO-chosen", "DEMO-ordinary"):
+            db.create_session(key, source="desktop", model=model, user_id="DEMO:owner",
+                              model_config={"model": model, "provider": "anthropic",
+                                            "api_mode": "anthropic_messages",
+                                            "reasoning_config": {"enabled": False},
+                                            "service_tier": "normal"}, profile_name=profile)
+            db.append_message(key, "user", f"DEMO {profile} 日本語の質問")
+            db.append_message(key, "assistant", f"DEMO {profile} 合成回答")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setattr(server, "_hermes_home", home)
+    monkeypatch.setattr(server, "_sessions", {})
+    monkeypatch.setattr(server, "_served_profile_homes", set())
+    monkeypatch.setattr(server, "_get_db", lambda: stores["default"])
+    monkeypatch.setattr(server, "_default_session_cwd", lambda *a, **k: str(tmp_path))
+    monkeypatch.setattr(server, "_enable_gateway_prompts", lambda: None)
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_maybe_schedule_auto_continue", lambda *a, **k: None)
+    scheduled = []
+    hydrated = threading.Event()
+
+    def build_boundary(sid, *args, **kwargs):
+        scheduled.append(sid)
+        hydrated.set()
+
+    monkeypatch.setattr(server, "_schedule_agent_build", build_boundary)
+    monkeypatch.setattr(server, "_start_agent_build", build_boundary)
+    forbidden = []
+
+    def deny(name):
+        def blocked(*args, **kwargs):
+            forbidden.append(name)
+            pytest.fail(f"History resume must not enter {name}")
+        return blocked
+
+    monkeypatch.setattr(server, "_make_agent", deny("agent construction"))
+    monkeypatch.setattr(server, "_resolve_runtime_with_fallback", deny("runtime resolver"))
+    monkeypatch.setattr("hermes_cli.runtime_provider.resolve_runtime_provider", deny("provider resolver"))
+    monkeypatch.setattr("agent.anthropic_credentials.read_claude_code_credentials", deny("CLI credentials"))
+    monkeypatch.setattr(socket.socket, "connect", deny("network"))
+    monkeypatch.setattr(socket.socket, "connect_ex", deny("network"))
+    from agent import models_dev
+
+    # Keep the real catalog parser/cache and provider classifier; only the public
+    # metadata HTTP terminal is synthetic, independent of DNS or an empty netns.
+    monkeypatch.setattr(models_dev, "_models_dev_cache", {})
+    monkeypatch.setattr(models_dev, "_models_dev_cache_time", 0)
+    monkeypatch.setattr(models_dev, "_models_dev_retry_after", 0)
+    metadata_requests = []
+
+    def public_metadata(url, *, headers, timeout):
+        assert url == models_dev.MODELS_DEV_URL
+        assert headers == {} and timeout == (5, 10)
+        metadata_requests.append(True)
+        response = models_dev.requests.Response()
+        response.status_code = 200
+        response._content = json.dumps({"anthropic": {
+            "id": "anthropic", "name": "DEMO Anthropic", "env": [],
+            "api": "https://api.anthropic.com", "models": {},
+        }}).encode("utf-8")
+        response.headers["Content-Type"] = "application/json"
+        return response
+
+    monkeypatch.setattr(models_dev.requests, "get", public_metadata)
+    transport = SimpleNamespace(auth_identity={"provider": "DEMO", "user_id": "owner"},
+                                write=lambda frame: True)
+
+    def rpc(method, params):
+        token = bind_transport(transport)
+        try:
+            return server.handle_request({"jsonrpc": "2.0", "id": "DEMO-resume",
+                                          "method": method, "params": params})
+        finally:
+            reset_transport(token)
+
+    def resume(profile, key, mode="lazy"):
+        flags = {"lazy": True} if mode == "lazy" else {"defer_history": True} if mode == "deferred" else {}
+        result = rpc("session.resume", {"profile": profile, "session_id": key, "source": "desktop",
+                     "close_on_disconnect": False, "inline_images": False, **flags})
+        assert "error" not in result, result
+        sid = result["result"]["session_id"]
+        record = server._sessions[sid]
+        if mode == "deferred":
+            assert record["resume_history_ready"].wait(3), "Real SQLite history hydration did not finish"
+            assert hydrated.wait(3), "Deferred history never reached the blocked build boundary"
+            assert not record.get("resume_history_error")
+        return sid, record
+
+    yield SimpleNamespace(rpc=rpc, resume=resume, stores=stores, homes=homes,
+                          configs=configs, forbidden=forbidden, scheduled=scheduled, hydrated=hydrated,
+                          metadata_requests=metadata_requests)
+    server._sessions.clear()
+    for db in stores.values():
+        db.close()
+
+
+@pytest.mark.parametrize("mode", ["lazy", "cold", "deferred"])
+def test_model_cas_limits_survive_authenticated_durable_resume_a_b_a(gateway, mode):
+    snapshots = {profile: (folder / "config.yaml").read_bytes() for profile, folder in gateway.homes.items()}
+    selected = {}
+    for profile in ("default", "worker"):
+        sid, initial = gateway.resume(profile, "DEMO-chosen")
+        assert "remote_info_limits" not in initial
+        current = gateway.rpc("remote.info.models", {"profile": profile, "session_id": sid})["result"]
+        choice = gateway.configs[profile]["model"]["models"][1]
+        result = gateway.rpc("remote.session.model_set", {"profile": profile, "session_id": sid,
+                             "model": choice["id"], "expected_revision": current["revision"]})
+        assert "error" not in result, result
+        persisted = gateway.stores[profile].get_session("DEMO-chosen")
+        stored_config = json.loads(persisted["model_config"])
+        selected[profile] = {key: choice[key] for key in ("context_length", "max_output_tokens")}
+        assert stored_config["remote_info_limits"] == selected[profile]
+        assert persisted["model"] == choice["id"]
+        server._sessions.pop(sid)
+
+    records = []
+    for profile in ("default", "worker", "default"):
+        gateway.hydrated.clear()
+        sid, record = gateway.resume(profile, "DEMO-chosen", mode)
+        records.append(record)
+        assert record["profile_home"] == (None if profile == "default" else str(gateway.homes[profile]))
+        assert record["auth_user_id"] == "DEMO:owner"
+        assert record["agent"] is None
+        assert record["remote_info_limits"] == selected[profile]
+        runtime = record["resume_runtime_overrides"]
+        assert runtime["remote_info_limits"] == selected[profile]
+        assert runtime["reasoning_config_override"] == {"enabled": False}
+        assert runtime["service_tier_override"] == ""
+        assert record["model_override"]["model"] == gateway.configs[profile]["model"]["models"][1]["id"]
+        metadata = gateway.rpc("remote.info.models", {"profile": profile, "session_id": sid})
+        assert metadata["result"]["model"] == record["model_override"]["model"]
+        assert all(row["response_confirmed"] is None for row in metadata["result"]["rows"])
+        assert all(profile in message["content"] for message in record["history"])
+        server._sessions.pop(sid)
+    assert records[0]["remote_info_limits"] == records[2]["remote_info_limits"] != records[1]["remote_info_limits"]
+    assert all((folder / "config.yaml").read_bytes() == snapshots[profile] for profile, folder in gateway.homes.items())
+    assert len(gateway.metadata_requests) == 1
+    assert not gateway.forbidden
+
+
+@pytest.mark.parametrize("mode", ["lazy", "cold", "deferred"])
+def test_ordinary_resume_has_no_new_limits_and_same_key_in_other_profile_stays_separate(gateway, mode):
+    for profile in ("default", "worker", "default"):
+        gateway.hydrated.clear()
+        sid, record = gateway.resume(profile, "DEMO-ordinary", mode)
+        assert "remote_info_limits" not in record
+        assert not (record.get("resume_runtime_overrides") or {}).get("remote_info_limits")
+        assert record["agent"] is None
+        if mode == "lazy":
+            assert record["resume_runtime_overrides"] is None
+            assert record["model_override"] is None
+        else:
+            assert record["model_override"]["model"] == gateway.configs[profile]["model"]["default"]
+        assert all(profile in message["content"] for message in record["history"])
+        opposite = "worker" if profile == "default" else "default"
+        mismatch = gateway.rpc("remote.info.models", {"profile": opposite, "session_id": sid})
+        assert mismatch["error"]["code"] == 4403
+        assert gateway.stores[opposite].get_session("DEMO-ordinary")["model"] == gateway.configs[opposite]["model"]["default"]
+        server._sessions.pop(sid)
+    assert len(gateway.metadata_requests) == (0 if mode == "lazy" else 1)
+    assert not gateway.forbidden

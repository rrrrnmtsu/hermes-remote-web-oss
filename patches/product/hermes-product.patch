+
+
+class RemotePushStatusResult(Result):
+    available: bool
+    reason: Literal["ready", "application_key_missing", "application_contact_missing", "push_library_missing"]
+    public_key: str | None
+    subscriptions: list[RemotePushEntry]
+    scope: Literal["authenticated_owner_profile_session"]
+    ttl_seconds: int
+    max_subscriptions: int
+
+
+class RemotePushSubscribeParams(ProfileParams):
+    session_id: str = Field(min_length=1, max_length=256)
+    subscription: RemotePushSubscription
+
+
+class RemotePushSubscribeResult(Result):
+    subscription: RemotePushEntry
+
+
+class RemotePushUnsubscribeParams(ProfileParams):
+    subscription_id: str = Field(min_length=1, max_length=64)
+
+
+class RemotePushUnsubscribeResult(Result):
+    removed: int
+
+
+method("remote.notifications.status", params=RemotePushStatusParams, result=RemotePushStatusResult,
+       doc="Read current-owner profile subscriptions and application public VAPID key; no permission or external send.")
+method("remote.notifications.subscribe", params=RemotePushSubscribeParams, result=RemotePushSubscribeResult,
+       doc="Explicit scoped browser subscription; allowed public push endpoints only. Never creates an agent turn.")
+method("remote.notifications.unsubscribe", params=RemotePushUnsubscribeParams, result=RemotePushUnsubscribeResult)
+method("remote.notifications.unsubscribe_all", params=ProfileParams, result=RemotePushUnsubscribeResult)

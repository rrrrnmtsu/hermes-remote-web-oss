@@ -0,0 +1,131 @@
+"""Real AIAgent construction and turn paths with isolated homes and native SDK fixtures."""
+
+import json
+import socket
+from types import SimpleNamespace
+
+import pytest
+
+from tests.agent.test_text_pilot import policy_config, sdk_client
+from agent.text_pilot import TextPilotError, PILOT_SYSTEM_PROMPT
+
+
+@pytest.fixture(autouse=True)
+def deny_real_network(monkeypatch):
+    def denied(*args, **kwargs):
+        raise AssertionError("Real network is forbidden in the isolated text-pilot tests")
+    monkeypatch.setattr(socket.socket, "connect", denied)
+    monkeypatch.setattr(socket.socket, "connect_ex", denied)
+
+
+@pytest.mark.parametrize("outcome", ["success", "connection_loss", "output_limit", "count_failure",
+    "stream_success", "stream_loss", "stream_empty", "stream_tool"])
+def test_real_agent_never_retries_or_executes_tools(tmp_path, monkeypatch, outcome):
+    from run_agent import AIAgent
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    import httpx
+
+    home = tmp_path / "pilot"
+    home.mkdir()
+    (home / "config.yaml").write_text(json.dumps(policy_config()))
+    for name in ("MEMORY.md", "USER.md", "SOUL.md", "AGENTS.md"):
+        (home / name).write_text("SYNTHETIC_PRIVATE_SENTINEL")
+    token = set_hermes_home_override(home)
+    seen = []
+    client = sdk_client(seen)
+    agent = None
+    try:
+        agent = AIAgent(model="claude-sonnet-5", provider="anthropic", api_mode="anthropic_messages",
+            api_key="fixture-only", base_url="https://api.anthropic.com", cwd=str(home), quiet_mode=True,
+            enabled_toolsets=["hermes-cli"], prefill_messages=[{"role": "user", "content": "SYNTHETIC_PRIVATE_SENTINEL"}])
+        assert agent.tools == [] and agent.valid_tool_names == set()
+        assert agent.skip_context_files and agent.skip_background_review
+        assert agent._memory_store is None and agent._memory_manager is None
+        assert agent.prefill_messages == [] and agent.max_tokens == 128
+        assert not agent.compression_enabled and agent._skip_mcp_refresh
+        assert agent._build_system_prompt() == PILOT_SYSTEM_PROMPT
+        assert agent._api_max_retries == 1 and agent._auto_recovery_cycles == 0
+
+        def respond(request):
+            payload = json.loads(request.content)
+            seen.append((request.url.path, payload))
+            if request.url.path.endswith("count_tokens"):
+                if outcome == "count_failure":
+                    return httpx.Response(503, json={"error": {"type": "overloaded_error", "message": "fixture"}})
+                return httpx.Response(200, json={"input_tokens": 42})
+            if outcome == "connection_loss":
+                raise httpx.ConnectError("fixture connection lost", request=request)
+            if outcome.startswith("stream_"):
+                message = {"id": "msg_fixture", "type": "message", "role": "assistant",
+                    "model": "claude-sonnet-5", "content": [], "stop_reason": None, "stop_sequence": None,
+                    "usage": {"input_tokens": 42, "output_tokens": 0}}
+                events = [{"type": "message_start", "message": message}]
+                if outcome == "stream_tool":
+                    events += [{"type": "content_block_start", "index": 0, "content_block":
+                        {"type": "tool_use", "id": "tool_fixture", "name": "terminal", "input": {}}},
+                        {"type": "content_block_stop", "index": 0}]
+                elif outcome != "stream_empty":
+                    events += [{"type": "content_block_start", "index": 0,
+                        "content_block": {"type": "text", "text": ""}},
+                        {"type": "content_block_delta", "index": 0,
+                        "delta": {"type": "text_delta", "text": "合成応答"}},
+                        {"type": "content_block_stop", "index": 0}]
+                if outcome != "stream_loss":
+                    events += [{"type": "message_delta", "delta":
+                        {"stop_reason": "tool_use" if outcome == "stream_tool" else "end_turn", "stop_sequence": None},
+                        "usage": {"output_tokens": 5}}, {"type": "message_stop"}]
+                wire = "".join(f"event: {event['type']}\ndata: {json.dumps(event)}\n\n" for event in events)
+                return httpx.Response(200, headers={"content-type": "text/event-stream"}, content=wire)
+            return httpx.Response(200, json={"id": "msg_fixture", "type": "message", "role": "assistant",
+                "model": "claude-sonnet-5", "content": [{"type": "text", "text": "合成応答"}],
+                "stop_reason": "max_tokens" if outcome == "output_limit" else "end_turn", "stop_sequence": None,
+                "usage": {"input_tokens": 42, "output_tokens": 5}})
+
+        client._client = httpx.Client(transport=httpx.MockTransport(respond))
+        monkeypatch.setattr(agent, "_create_request_anthropic_client", lambda **kwargs: client)
+        monkeypatch.setattr(agent, "_close_request_anthropic_client", lambda *args, **kwargs: None)
+        agent._disable_streaming = not outcome.startswith("stream_")
+        deltas = []
+        agent.stream_delta_callback = deltas.append
+        result = agent.run_conversation("日本語の合成テキストに短く答えてください")
+        generations = [body for path, body in seen if not path.endswith("count_tokens")]
+        assert len(generations) == (0 if outcome == "count_failure" else 1)
+        for body in generations:
+            assert body["max_tokens"] == 128 and not body.get("tools")
+            assert "SYNTHETIC_PRIVATE_SENTINEL" not in json.dumps(body)
+        if outcome in {"connection_loss", "count_failure"}:
+            assert result.get("failed") is True
+        if outcome in {"success", "stream_success"}:
+            assert result.get("failed", False) is False and "合成応答" in result["final_response"]
+        if outcome == "stream_success":
+            assert "合成応答" in "".join(deltas)
+        with pytest.raises(TextPilotError):
+            agent._execute_tool_calls(SimpleNamespace(tool_calls=[SimpleNamespace()]), [], "fixture")
+    finally:
+        if agent:
+            agent.close()
+        client.close()
+        reset_hermes_home_override(token)
+
+
+def test_real_construction_policy_is_scoped_a_b_a(tmp_path):
+    from run_agent import AIAgent
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    homes = [tmp_path / name for name in ("pilot_a", "pilot_b")]
+    for home, cap in zip(homes, [64, 128]):
+        home.mkdir()
+        cfg = policy_config()
+        cfg["agent"]["text_pilot"]["max_output_tokens"] = cap
+        (home / "config.yaml").write_text(json.dumps(cfg))
+    for home, cap in [(homes[0], 64), (homes[1], 128), (homes[0], 64)]:
+        token = set_hermes_home_override(home)
+        agent = None
+        try:
+            agent = AIAgent(model="claude-sonnet-5", provider="anthropic", api_mode="anthropic_messages",
+                api_key="fixture-only", base_url="https://api.anthropic.com", quiet_mode=True)
+            assert agent.max_tokens == cap and agent._text_pilot.max_output_tokens == cap
+            assert agent.tools == [] and agent._build_system_prompt() == PILOT_SYSTEM_PROMPT
+        finally:
+            if agent:
+                agent.close()
+            reset_hermes_home_override(token)

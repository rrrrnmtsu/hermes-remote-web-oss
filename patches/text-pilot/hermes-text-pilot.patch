diff --git a/tests/agent/test_text_pilot.py b/tests/agent/test_text_pilot.py
new file mode 100644
index 0000000000..93ce5f2999
--- /dev/null
+++ b/tests/agent/test_text_pilot.py
@@ -0,0 +1,100 @@
+"""Private text-pilot bounds at the real SDK request boundary, without network."""
+
+import asyncio
+import json
+from types import SimpleNamespace
+
+import anthropic
+import httpx
+import pytest
+
+from agent.text_pilot import TextPilot, TextPilotError, PILOT_SYSTEM_PROMPT
+
+
+def policy_config(model="claude-sonnet-5"):
+    return {"model": {"default": model, "provider": "anthropic", "context_length": 200000},
+            "agent": {"text_pilot": {"model": model, "max_input_tokens": 3072, "max_output_tokens": 128}},
+            "auxiliary": {"title_generation": {"enabled": False, "model_upgrade_enabled": False}},
+            "background_review": {"enabled": False}, "mcp_servers": {}}
+
+
+def sdk_client(seen, count=42):
+    def respond(request):
+        seen.append((request.url.path, json.loads(request.content)))
+        if request.url.path.endswith("/count_tokens"):
+            return httpx.Response(200, json={"input_tokens": count})
+        return httpx.Response(200, json={"id": "msg_fixture", "type": "message", "role": "assistant",
+            "model": "claude-sonnet-5", "content": [{"type": "text", "text": "合成応答"}],
+            "stop_reason": "end_turn", "stop_sequence": None, "usage": {"input_tokens": 42, "output_tokens": 5}})
+    return anthropic.Anthropic(api_key="fixture-only", max_retries=0,
+        http_client=httpx.Client(transport=httpx.MockTransport(respond)))
+
+
+def request_kwargs():
+    return {"model": "claude-sonnet-5", "max_tokens": 128, "system": PILOT_SYSTEM_PROMPT,
+            "messages": [{"role": "user", "content": "短い合成テキスト"}]}
+
+
+@pytest.mark.parametrize("violation", ["retry", "oversize", "sdk_retry", "route", "model", "tools", "thinking", "image", "limit", "stop_before", "stop_during_count"])
+def test_physical_request_fails_closed_without_a_generation(violation):
+    policy = TextPilot.from_config(policy_config())
+    agent = SimpleNamespace(provider="anthropic", api_mode="anthropic_messages", model=policy.model,
+                            base_url="https://api.anthropic.com")
+    seen = []
+    client = sdk_client(seen, count=3073 if violation == "oversize" else 42)
+    kwargs = request_kwargs()
+    if violation == "retry":
+        policy.admit(agent, client, kwargs)
+    elif violation == "sdk_retry":
+        client.max_retries = 1
+    elif violation == "route":
+        agent.base_url = "https://api.anthropic.com.invalid"
+    elif violation == "model":
+        kwargs["model"] = "other-model"
+    elif violation == "tools":
+        kwargs["tools"] = [{"name": "terminal"}]
+    elif violation == "thinking":
+        kwargs["thinking"] = {"type": "enabled", "budget_tokens": 1024}
+    elif violation == "image":
+        kwargs["messages"][0]["content"] = [{"type": "image", "source": {"type": "base64"}}]
+    elif violation == "limit":
+        kwargs["max_tokens"] = 129
+    elif violation == "stop_before":
+        agent._interrupt_requested = True
+    elif violation == "stop_during_count":
+        count = client.messages.count_tokens
+        def counted_then_interrupted(**args):
+            result = count(**args)
+            agent._interrupt_requested = True
+            return result
+        client.messages.count_tokens = counted_then_interrupted
+    try:
+        with pytest.raises(InterruptedError if violation.startswith("stop_") else TextPilotError):
+            policy.admit(agent, client, kwargs)
+        assert all(path.endswith("count_tokens") for path, _ in seen)
+    finally:
+        client.close()
+
+
+def test_auxiliary_paths_follow_the_profile_a_b_a(tmp_path):
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    from agent.auxiliary_client import _relay_sync_completion, _relay_async_completion, _relay_sync_stream
+    from agent.text_pilot import reject_auxiliary_for_text_pilot
+    homes = [tmp_path / name for name in ("ordinary", "pilot")]
+    for home, config in zip(homes, [{}, policy_config()]):
+        home.mkdir()
+        (home / "config.yaml").write_text(json.dumps(config))
+    for home in [homes[0], homes[1], homes[0]]:
+        token = set_hermes_home_override(home)
+        try:
+            if home == homes[1]:
+                with pytest.raises(TextPilotError):
+                    _relay_sync_completion(None, {})
+                with pytest.raises(TextPilotError):
+                    _relay_sync_stream(None, {})
+                with pytest.raises(TextPilotError):
+                    asyncio.run(_relay_async_completion(None, {}))
+            else:
+                assert reject_auxiliary_for_text_pilot() is None
+        finally:
+            reset_hermes_home_override(token)

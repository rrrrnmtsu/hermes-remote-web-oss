+    monkeypatch.setattr(server, "_notify_session_boundary", forbidden)
+    homes = [tmp_path / name for name in ("pilot_a", "pilot_b")]
+    for home, cap in zip(homes, [64, 128]):
+        home.mkdir()
+        cfg = policy_config()
+        cfg["agent"]["text_pilot"]["max_output_tokens"] = cap
+        (home / "config.yaml").write_text(json.dumps(cfg))
+    for home, cap in [(homes[0], 64), (homes[1], 128), (homes[0], 64)]:
+        token = set_hermes_home_override(home)
+        db = SessionDB(home / "state.db")
+        agent = None
+        try:
+            agent = server._make_agent("pilot-fixture", "pilot-fixture", session_db=db)
+            assert agent.max_tokens == cap and agent.tools == []
+            assert agent._memory_store is None and agent.skip_context_files

+def test_gateway_does_not_resolve_a_fallback_for_a_pilot(tmp_path, monkeypatch):
+    from tui_gateway import server
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    from hermes_cli import runtime_provider
+    from hermes_cli.auth import AuthError
+    from agent.text_pilot import TextPilot, TextPilotError
+
+    home = tmp_path / "remote-web-smoke"
+    home.mkdir()
+    (home / "config.yaml").write_text(json.dumps(policy_config()))
+    token = set_hermes_home_override(home)
+    calls = []
+    def unavailable(**kwargs):
+        calls.append(kwargs)
+        raise AuthError("Fixture primary is unavailable")
+    def forbidden():
+        raise AssertionError("No automatic fallback may be consulted")
+    monkeypatch.setattr(runtime_provider, "resolve_runtime_provider", unavailable)
+    monkeypatch.setattr(server, "_load_fallback_model", forbidden)
+    try:
+        with pytest.raises(AuthError):
+            server._resolve_runtime_with_fallback({"requested": "anthropic"})
+        assert len(calls) == 1
+        with pytest.raises(TextPilotError):
+            TextPilot.from_config({})
+    finally:
+        reset_hermes_home_override(token)

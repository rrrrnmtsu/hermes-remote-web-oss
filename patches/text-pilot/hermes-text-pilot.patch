diff --git a/agent/text_pilot.py b/agent/text_pilot.py
new file mode 100644
index 0000000000..846cec753a
--- /dev/null
+++ b/agent/text_pilot.py
@@ -0,0 +1,118 @@
+"""Opt-in, single-attempt text turns for a bounded private acceptance pilot.
+
+This is an agent policy, not another execution engine. Ordinary profiles keep
+their existing behavior. Physical requests, including stream recovery, share
+one reservation; an uncertain attempt never refunds that reservation.
+"""
+
+from dataclasses import dataclass, field
+import threading
+from urllib.parse import urlsplit
+
+
+class TextPilotError(ValueError):
+    """A pilot limit failed before another generation could be dispatched."""
+
+
+@dataclass
+class TextPilot:
+    model: str
+    max_input_tokens: int
+    max_output_tokens: int
+    _attempted: bool = field(default=False, init=False)
+    _lock: threading.Lock = field(default_factory=threading.Lock, init=False, repr=False)
+
+    @classmethod
+    def from_config(cls, config):
+        agent_section = config.get("agent") or {}
+        section = agent_section.get("text_pilot") if isinstance(agent_section, dict) else None
+        if section is None or section is False:
+            from hermes_constants import get_hermes_home
+            if get_hermes_home().name == "remote-web-smoke":
+                raise TextPilotError("The reserved smoke profile requires its text-pilot policy")
+            return None
+        if not isinstance(section, dict) or set(section) != {
+            "model", "max_input_tokens", "max_output_tokens",
+        }:
+            raise TextPilotError("Invalid agent.text_pilot policy")
+        model = section["model"]
+        if not isinstance(model, str) or not model.strip():
+            raise TextPilotError("A pilot must pin one existing text model")
+        for key in ("max_input_tokens", "max_output_tokens"):
+            if type(section[key]) is not int or section[key] <= 0:
+                raise TextPilotError("Pilot token limits must be positive integers")
+        # Six manually admitted turns fit inside the user's total 30,000-token
+        # allowance. Actual remaining token/cost admission is still checked by
+        # the operator before each explicit UI send, never inferred from a UUID.
+        # count_tokens is an estimate, so leave a further 1,024-token reserve
+        # instead of claiming it is an exact usage/billing measurement.
+        if section["max_input_tokens"] + section["max_output_tokens"] + 1024 > 5000:
+            raise TextPilotError("A pilot turn, including headroom, may reserve at most 5,000 tokens")
+        return cls(model.strip(), section["max_input_tokens"], section["max_output_tokens"])
+
+    def validate_route(self, provider, api_mode, model, base_url):
+        url = urlsplit(str(base_url or "https://api.anthropic.com"))
+        if (provider != "anthropic" or api_mode != "anthropic_messages"
+                or model != self.model or url.scheme != "https"
+                or url.hostname != "api.anthropic.com" or url.port not in (None, 443)
+                or url.username or url.password or url.query or url.fragment
+                or url.path.rstrip("/") not in ("", "/v1")):
+            raise TextPilotError("Text pilot requires its pinned native Anthropic route")
+
+    def begin_turn(self):
+        with self._lock:
+            self._attempted = False
+
+    def admit(self, agent, client, kwargs):
+        if getattr(agent, "_interrupt_requested", False):
+            raise InterruptedError("Text pilot interrupted before generation")
+        self.validate_route(agent.provider, agent.api_mode, agent.model, agent.base_url)
+        self.validate_route(agent.provider, agent.api_mode, agent.model, str(client.base_url))
+        with self._lock:
+            if self._attempted:
+                raise TextPilotError("Text pilot permits no retry or automatic continuation")
+            self._attempted = True
+        if getattr(client, "max_retries", None) != 0:
+            raise TextPilotError("Text pilot requires SDK retries disabled")
+        if (kwargs.get("model") != self.model or kwargs.get("tools")
+                or kwargs.get("speed") or kwargs.get("service_tier") not in (None, "standard_only")
+                or type(kwargs.get("max_tokens")) is not int
+                or not 0 < kwargs["max_tokens"] <= self.max_output_tokens
+                or (kwargs.get("thinking") or {}).get("type") not in (None, "disabled")):
+            raise TextPilotError("Text pilot request changed its tool, model or output limit")
+        messages = kwargs.get("messages")
+        if not isinstance(messages, list) or not messages:
+            raise TextPilotError("Text pilot requires plain text messages")
+        for message in messages:
+            content = message.get("content")
+            if message.get("role") not in ("user", "assistant"):
+                raise TextPilotError("Text pilot forbids tool history")
+            if isinstance(content, str):
+                continue
+            if not isinstance(content, list) or any(
+                not isinstance(block, dict) or block.get("type") != "text"
+                or not isinstance(block.get("text"), str) for block in content
+            ):
+                raise TextPilotError("Text pilot forbids non-text content")
+        # The provider counts the actual native request before generation. A
+        # missing/failed count fails closed; no local character estimate admits
+        # a paid call. count_tokens is not a generation and SDK retries are 0.
+        count_args = {"model": self.model, "messages": messages}
+        if kwargs.get("system") is not None:
+            count_args["system"] = kwargs["system"]
+        counted = client.messages.count_tokens(**count_args)
+        if getattr(agent, "_interrupt_requested", False):
+            raise InterruptedError("Text pilot interrupted while counting input")
+        tokens = getattr(counted, "input_tokens", None)
+        if type(tokens) is not int or not 0 < tokens <= self.max_input_tokens:
+            raise TextPilotError("Text pilot input exceeds its admitted token limit")
+
+
+def reject_auxiliary_for_text_pilot():
+    from hermes_cli.config import load_config_readonly
+
+    if TextPilot.from_config(load_config_readonly() or {}) is not None:
+        raise TextPilotError("Text pilot disables auxiliary model calls")
+
+
+PILOT_SYSTEM_PROMPT = "You are a text assistant in an isolated acceptance test. Answer the user's synthetic text briefly."
